bakerrrr-drawable 2

# Wire interface hardware extracted from the procedural deck, socket and cable families.
# Ground art uses the shared 16-unit canvas. Both variants retain the same silhouette.

# Pocket deck: a broad display above two rows of tactile keys.
drawable cheap_deck context ground:
    paint body = fill
    paint steel = edge
    paint shadow = shade

    variant compact:
        layer silhouette:
            polygon casing body outline shadow width 0.4:
                2, 3.6
                3, 2.8
                12.9, 2.8
                14, 3.8
                14, 11.9
                13, 13
                2.8, 13
                1.8, 12
            polygon display_bezel steel:
                3, 4
                12.8, 4
                12.8, 8.4
                3, 8.4
            rect display shadow:
                x 3.7
                y 4.7
                w 8.4
                h 3
            line screen_glint body width 0.35:
                4.3, 5.4
                7.3, 5.4
            line upper_keys steel width 0.65:
                3.5, 9.5
                9.5, 9.5
            line lower_keys steel width 0.65:
                3.5, 11
                9.5, 11
            rect enter_key shadow:
                x 11
                y 9.3
                w 1.5
                h 2.2
        surface item:
            casing

    variant detailed:
        layer silhouette:
            polygon casing body outline shadow width 0.4:
                2, 3.6
                3, 2.8
                12.9, 2.8
                14, 3.8
                14, 11.9
                13, 13
                2.8, 13
                1.8, 12
            polygon display_bezel steel:
                3, 4
                12.8, 4
                12.8, 8.4
                3, 8.4
            rect display shadow:
                x 3.7
                y 4.7
                w 8.4
                h 3
            line screen_glint body width 0.35:
                4.3, 5.4
                7.3, 5.4
            line upper_keys steel width 0.65:
                3.5, 9.5
                9.5, 9.5
            line lower_keys steel width 0.65:
                3.5, 11
                9.5, 11
            rect enter_key shadow:
                x 11
                y 9.3
                w 1.5
                h 2.2
        layer detail:
            line left_key_gap body width 0.35:
                5, 9
                5, 11.5
            line middle_key_gap body width 0.35:
                7, 9
                7, 11.5
            line right_key_gap body width 0.35:
                9, 9
                9, 11.5
            line lower_case_lip shadow width 0.25:
                2.8, 12.2
                12.8, 12.2
                13.3, 11.6
            circle case_screw steel:
                center 2.5, 3.8
                radius 0.25
            line port shadow width 0.3:
                10.6, 3.3
                12.1, 3.3
        surface item:
            casing


# Round neural socket and its looping insulated lead with a narrow jack plug.
