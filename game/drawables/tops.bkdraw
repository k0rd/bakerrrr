bakerrrr-drawable 1

# Ordinary tops share body anchors, while every family retains a distinct cut.

drawable tee context garment:
    paint fabric = fill
    paint trim = edge
    let top_y = shoulder_y
    let bottom_y = hip_y - 1
    variant compact:
        layer body:
            polygon torso fabric:
                mid - shoulder, top_y
                mid - 1, top_y
                mid, top_y + 1
                mid + 1, top_y
                mid + shoulder, top_y
                mid + waist, bottom_y
                mid - waist, bottom_y
            polygon left_sleeve fabric:
                mid - shoulder, top_y
                mid - shoulder - 1, top_y + 0.75
                mid - shoulder - 0.75, top_y + 1.75
                mid - shoulder + 0.75, top_y + 1.5
            mirror left_sleeve as right_sleeve
        surface garment:
            torso
            left_sleeve
            right_sleeve
    variant detailed:
        layer body:
            polygon torso fabric outline trim width 0.3:
                mid - shoulder, top_y
                mid - 1, top_y
                mid, top_y + 1.25
                mid + 1, top_y
                mid + shoulder, top_y
                mid + waist, bottom_y
                mid - waist, bottom_y
            polygon left_sleeve fabric outline trim width 0.3:
                mid - shoulder, top_y
                mid - shoulder - 1, top_y + 0.75
                mid - shoulder - 0.75, top_y + 1.75
                mid - shoulder + 0.75, top_y + 1.5
            mirror left_sleeve as right_sleeve
        layer seam:
            line hem trim width 0.25:
                mid - waist, bottom_y
                mid + waist, bottom_y
        surface garment:
            torso
            left_sleeve
            right_sleeve

drawable buttoned_top context garment:
    paint fabric = fill
    paint trim = edge
    paint shadow = shade
    let top_y = shoulder_y
    let bottom_y = hip_y - 1
    variant compact:
        layer body:
            polygon torso fabric:
                mid - shoulder, top_y
                mid + shoulder, top_y
                mid + waist, bottom_y
                mid - waist, bottom_y
            polygon left_sleeve fabric:
                mid - shoulder, top_y
                mid - shoulder - 2, top_y + 1
                mid - shoulder - 1, top_y + 4
                mid - shoulder + 1, top_y + 2
            mirror left_sleeve as right_sleeve
        layer detail:
            line placket shadow width 0.35:
                mid, top_y + 1
                mid, bottom_y
        surface garment:
            torso
            left_sleeve
            right_sleeve
    variant detailed:
        layer body:
            polygon torso fabric outline trim width 0.3:
                mid - shoulder, top_y
                mid + shoulder, top_y
                mid + waist, bottom_y
                mid - waist, bottom_y
            polygon left_sleeve fabric outline trim width 0.3:
                mid - shoulder, top_y
                mid - shoulder - 2.25, top_y + 1
                mid - shoulder - 1, top_y + 4
                mid - shoulder + 1, top_y + 2
            mirror left_sleeve as right_sleeve
        layer detail:
            polygon left_collar trim:
                mid - 2, top_y
                mid, top_y + 1.5
                mid - 0.5, top_y + 2
            mirror left_collar as right_collar
            line placket shadow width 0.25:
                mid, top_y + 1.5
                mid, bottom_y
            circle upper_button trim:
                center mid + 0.5, top_y + 3
                radius 0.2
            circle lower_button trim:
                center mid + 0.5, top_y + 5
                radius 0.2
        surface garment:
            torso
            left_sleeve
            right_sleeve

drawable blouse context garment:
    paint fabric = fill
    paint trim = edge
    let top_y = shoulder_y
    let bottom_y = hip_y - 1
    variant compact:
        layer body:
            polygon torso fabric:
                mid - shoulder, top_y + 1
                mid - 1, top_y
                mid, top_y + 1
                mid + 1, top_y
                mid + shoulder, top_y + 1
                mid + waist, bottom_y
                mid - waist, bottom_y
            ellipse left_sleeve fabric:
                x mid - shoulder - 2
                y top_y
                w 3
                h 4
            mirror left_sleeve as right_sleeve
        surface garment:
            torso
            left_sleeve
            right_sleeve
    variant detailed:
        layer body:
            polygon torso fabric outline trim width 0.25:
                mid - shoulder, top_y + 1
                mid - 1.25, top_y
                mid, top_y + 1.5
                mid + 1.25, top_y
                mid + shoulder, top_y + 1
                mid + waist, bottom_y
                mid - waist, bottom_y
            ellipse left_sleeve fabric:
                x mid - shoulder - 2.25
                y top_y
                w 3.5
                h 4.5
                outline trim
                width 0.25
            mirror left_sleeve as right_sleeve
        layer seam:
            line neck trim width 0.25:
                mid - 1.25, top_y
                mid, top_y + 1.5
                mid + 1.25, top_y
        surface garment:
            torso
            left_sleeve
            right_sleeve

drawable sweater context garment:
    paint fabric = fill
    paint trim = edge
    let top_y = shoulder_y
    let bottom_y = hip_y
    variant compact:
        layer body:
            polygon torso fabric:
                mid - shoulder - 1, top_y
                mid + shoulder + 1, top_y
                mid + hip, bottom_y
                mid - hip, bottom_y
            polygon left_sleeve fabric:
                mid - shoulder, top_y
                body_left - 2, top_y + 2
                body_left - 1, hip_y - 2
                body_left + 1, hip_y - 2
            mirror left_sleeve as right_sleeve
        surface garment:
            torso
            left_sleeve
            right_sleeve
    variant detailed:
        layer body:
            polygon torso fabric outline trim width 0.35:
                mid - shoulder - 1, top_y
                mid + shoulder + 1, top_y
                mid + hip, bottom_y
                mid - hip, bottom_y
            polygon left_sleeve fabric outline trim width 0.3:
                mid - shoulder, top_y
                body_left - 2.25, top_y + 2
                body_left - 1, hip_y - 1.5
                body_left + 1, hip_y - 1.5
            mirror left_sleeve as right_sleeve
        layer knit:
            line hem trim width 0.4:
                mid - hip, bottom_y
                mid + hip, bottom_y
            line neck trim width 0.3:
                mid - 1.5, top_y
                mid, top_y + 1
                mid + 1.5, top_y
        surface garment:
            torso
            left_sleeve
            right_sleeve

drawable overshirt context garment:
    paint fabric = fill
    paint trim = edge
    paint shadow = shade
    let top_y = shoulder_y
    let bottom_y = hip_y + 1
    variant compact:
        layer body:
            polygon torso fabric:
                mid - shoulder - 1, top_y
                mid + shoulder + 1, top_y
                mid + hip, bottom_y
                mid - hip, bottom_y
            polygon left_sleeve fabric:
                mid - shoulder, top_y
                body_left - 2, top_y + 2
                body_left - 1, hip_y
                body_left + 1, hip_y - 1
            mirror left_sleeve as right_sleeve
        layer detail:
            line opening shadow width 0.45:
                mid, top_y
                mid, bottom_y
        surface garment:
            torso
            left_sleeve
            right_sleeve
    variant detailed:
        layer body:
            polygon torso fabric outline trim width 0.35:
                mid - shoulder - 1, top_y
                mid + shoulder + 1, top_y
                mid + hip, bottom_y
                mid - hip, bottom_y
            polygon left_sleeve fabric outline trim width 0.3:
                mid - shoulder, top_y
                body_left - 2.25, top_y + 2
                body_left - 1, hip_y
                body_left + 1, hip_y - 1
            mirror left_sleeve as right_sleeve
        layer detail:
            line opening shadow width 0.3:
                mid, top_y
                mid, bottom_y
            rect left_pocket trim:
                x mid - 3
                y hip_y - 3
                w 1.5
                h 1.25
            mirror left_pocket as right_pocket
        surface garment:
            torso
            left_sleeve
            right_sleeve

drawable turtleneck context garment:
    paint fabric = fill
    paint trim = edge
    let top_y = shoulder_y
    let bottom_y = hip_y - 1
    variant compact:
        layer body:
            polygon torso fabric:
                mid - shoulder, top_y
                mid + shoulder, top_y
                mid + waist, bottom_y
                mid - waist, bottom_y
            polygon left_sleeve fabric:
                mid - shoulder, top_y
                body_left - 2, top_y + 2
                body_left - 1, hip_y - 2
                body_left + 1, hip_y - 2
            mirror left_sleeve as right_sleeve
            rect collar fabric:
                x mid - 1.5
                y top_y - 1.5
                w 3
                h 2
        surface garment:
            torso
            left_sleeve
            right_sleeve
            collar
    variant detailed:
        layer body:
            polygon torso fabric outline trim width 0.3:
                mid - shoulder, top_y
                mid + shoulder, top_y
                mid + waist, bottom_y
                mid - waist, bottom_y
            polygon left_sleeve fabric outline trim width 0.3:
                mid - shoulder, top_y
                body_left - 2, top_y + 2
                body_left - 1, hip_y - 2
                body_left + 1, hip_y - 2
            mirror left_sleeve as right_sleeve
            rect collar fabric:
                x mid - 1.6
                y top_y - 1.75
                w 3.2
                h 2.25
                outline trim
                width 0.3
        layer detail:
            line collar_fold trim width 0.25:
                mid - 1.5, top_y - 0.5
                mid + 1.5, top_y - 0.5
        surface garment:
            torso
            left_sleeve
            right_sleeve
            collar
