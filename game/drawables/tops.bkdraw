bakerrrr-drawable 2

# Worn geometry is derived from frozen body Points. Local coordinate Scalars
# are explicit; body_unit is a body-height measure, never a naked offset.
# Ordinary tops share body anchors, while every family retains a distinct cut.

drawable tee context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (shoulder_anchor_x, shoulder_y) = shoulder_left
    let (crotch_x, hip_y) = crotch
    let shoulder_half = upper_torso_width / 2
    let waist_half = waist_width / 2
    paint fabric = fill
    paint trim = edge
    let top_y = shoulder_y
    let bottom_y = hip_y - body_unit * 2
    variant compact:
        layer body:
            polygon torso fabric:
                body_mid_x - shoulder_half + body_unit * 0.5, top_y
                body_mid_x - body_unit * 1, top_y
                body_mid_x, top_y + body_unit * 1
                body_mid_x + body_unit * 1, top_y
                body_mid_x + shoulder_half - body_unit * 0.5, top_y
                body_mid_x + waist_half, bottom_y
                body_mid_x - waist_half, bottom_y
            polygon left_sleeve fabric:
                body_mid_x - shoulder_half + body_unit * 0.5, top_y
                body_mid_x - shoulder_half - body_unit * 0.5, top_y + body_unit * 0.75
                body_mid_x - shoulder_half, top_y + body_unit * 1.5
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1.25
            mirror left_sleeve as right_sleeve
        surface garment:
            torso
            left_sleeve
            right_sleeve
    variant detailed:
        layer body:
            polygon torso fabric outline trim width 0.3:
                body_mid_x - shoulder_half + body_unit * 0.25, top_y
                body_mid_x - body_unit * 1, top_y
                body_mid_x, top_y + body_unit * 1.25
                body_mid_x + body_unit * 1, top_y
                body_mid_x + shoulder_half - body_unit * 0.25, top_y
                body_mid_x + waist_half, bottom_y
                body_mid_x - waist_half, bottom_y
            polygon left_sleeve fabric outline trim width 0.3:
                body_mid_x - shoulder_half + body_unit * 0.25, top_y
                body_mid_x - shoulder_half - body_unit * 0.25, top_y + body_unit * 0.75
                body_mid_x - shoulder_half, top_y + body_unit * 1.5
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1.25
            mirror left_sleeve as right_sleeve
        layer seam:
            line hem trim width 0.25:
                body_mid_x - waist_half, bottom_y
                body_mid_x + waist_half, bottom_y
        surface garment:
            torso
            left_sleeve
            right_sleeve

drawable buttoned_top context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (shoulder_anchor_x, shoulder_y) = shoulder_left
    let (crotch_x, hip_y) = crotch
    let (left_hand_x, hand_y) = between(wrist_inner_left, wrist_outer_left, 0.5)
    let shoulder_half = upper_torso_width / 2
    let waist_half = waist_width / 2
    paint fabric = fill
    paint trim = edge
    paint shadow = shade
    let top_y = shoulder_y
    let bottom_y = hip_y - body_unit * 1
    variant compact:
        layer body:
            polygon torso fabric:
                body_mid_x - shoulder_half, top_y
                body_mid_x + shoulder_half, top_y
                body_mid_x + waist_half, bottom_y
                body_mid_x - waist_half, bottom_y
            polygon left_sleeve fabric:
                body_mid_x - shoulder_half, top_y
                body_mid_x - shoulder_half - body_unit * 0.75, top_y + body_unit * 1
                left_hand_x - body_unit * 0.25, hand_y - body_unit * 0.5
                left_hand_x + body_unit * 0.5, hand_y - body_unit * 0.5
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1.5
            mirror left_sleeve as right_sleeve
        layer detail:
            line placket shadow width 0.35:
                body_mid_x, top_y + body_unit * 1
                body_mid_x, bottom_y
        surface garment:
            torso
            left_sleeve
            right_sleeve
    variant detailed:
        layer body:
            polygon torso fabric outline trim width 0.3:
                body_mid_x - shoulder_half, top_y
                body_mid_x + shoulder_half, top_y
                body_mid_x + waist_half, bottom_y
                body_mid_x - waist_half, bottom_y
            polygon left_sleeve fabric outline trim width 0.3:
                body_mid_x - shoulder_half, top_y
                body_mid_x - shoulder_half - body_unit * 0.25, top_y + body_unit * 1
                left_hand_x - body_unit * 0.25, hand_y - body_unit * 0.5
                left_hand_x + body_unit * 0.5, hand_y - body_unit * 0.5
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1.5
            mirror left_sleeve as right_sleeve
        layer detail:
            polygon left_collar trim:
                body_mid_x - body_unit * 2, top_y
                body_mid_x, top_y + body_unit * 1.5
                body_mid_x - body_unit * 0.5, top_y + body_unit * 2
            mirror left_collar as right_collar
            line placket shadow width 0.25:
                body_mid_x, top_y + body_unit * 1.5
                body_mid_x, bottom_y
            circle upper_button trim:
                center body_mid_x + body_unit * 0.5, top_y + body_unit * 3
                radius body_unit * 0.2
            circle lower_button trim:
                center body_mid_x + body_unit * 0.5, top_y + body_unit * 5
                radius body_unit * 0.2
        surface garment:
            torso
            left_sleeve
            right_sleeve

drawable blouse context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (shoulder_anchor_x, shoulder_y) = shoulder_left
    let (crotch_x, hip_y) = crotch
    let shoulder_half = upper_torso_width / 2
    let waist_half = waist_width / 2
    paint fabric = fill
    paint trim = edge
    let top_y = shoulder_y
    let bottom_y = hip_y - body_unit * 1
    variant compact:
        layer body:
            polygon torso fabric:
                body_mid_x - shoulder_half, top_y + body_unit * 1
                body_mid_x - body_unit * 1, top_y
                body_mid_x, top_y + body_unit * 1
                body_mid_x + body_unit * 1, top_y
                body_mid_x + shoulder_half, top_y + body_unit * 1
                body_mid_x + waist_half, bottom_y
                body_mid_x - waist_half, bottom_y
            ellipse left_sleeve fabric:
                x body_mid_x - shoulder_half - body_unit * 0.75
                y top_y + body_unit * 0.5
                w body_unit * 2
                h body_unit * 3
            mirror left_sleeve as right_sleeve
        surface garment:
            torso
            left_sleeve
            right_sleeve
    variant detailed:
        layer body:
            polygon torso fabric outline trim width 0.25:
                body_mid_x - shoulder_half, top_y + body_unit * 1
                body_mid_x - body_unit * 1.25, top_y
                body_mid_x, top_y + body_unit * 1.5
                body_mid_x + body_unit * 1.25, top_y
                body_mid_x + shoulder_half, top_y + body_unit * 1
                body_mid_x + waist_half, bottom_y
                body_mid_x - waist_half, bottom_y
            ellipse left_sleeve fabric:
                x body_mid_x - shoulder_half - body_unit * 1
                y top_y + body_unit * 0.25
                w body_unit * 2.25
                h body_unit * 3.5
                outline trim
                width 0.25
            mirror left_sleeve as right_sleeve
        layer seam:
            line neck trim width 0.25:
                body_mid_x - body_unit * 1.25, top_y
                body_mid_x, top_y + body_unit * 1.5
                body_mid_x + body_unit * 1.25, top_y
        surface garment:
            torso
            left_sleeve
            right_sleeve

drawable sweater context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (shoulder_anchor_x, shoulder_y) = shoulder_left
    let (crotch_x, hip_y) = crotch
    let (left_hand_x, hand_y) = between(wrist_inner_left, wrist_outer_left, 0.5)
