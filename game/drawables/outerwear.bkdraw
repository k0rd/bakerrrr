                left_sleeve
                right_sleeve

drawable work_apron context garment:
    paint fabric = fill
    paint trim = edge
    point waist_center = between(waist_left, waist_right, 0.5)
    point chest_left = between(armpit_left, waist_left, 0.15)
    point chest_right = between(armpit_right, waist_right, 0.15)
    point bib_left = between(chest_left, chest_right, 0.25)
    point bib_right = between(chest_left, chest_right, 0.75)
    point hem_center = between(crotch, ground, 0.4)
    let (hem_x, hem_y) = hem_center
    let (hip_left_x, hip_left_y) = hip_left
    let (hip_right_x, hip_right_y) = hip_right
    point hem_left = hip_left_x - hip_width / 12, hem_y
    point hem_right = hip_right_x + hip_width / 12, hem_y
    point pocket_top = between(waist_center, hem_center, 0.65)
    let (pocket_mid_x, pocket_y) = pocket_top
    let pocket_width = waist_width * 0.7
    let pocket_height = y_distance(waist_center, hem_center) / 5
    variant compact:
        layer body:
            polygon bib fabric:
                bib_left
                bib_right
                waist_right
                hip_right
                hem_right
                hem_left
                hip_left
                waist_left
        layer straps:
            line left_neck trim width 0.35:
                bib_left
                neck_left
            mirror left_neck as right_neck
            line waist_tie trim width 0.3:
                waist_left
                waist_right
        surface garment:
            bib

    variant detailed:
        layer body:
            polygon bib fabric outline trim width 0.3:
                bib_left
                bib_right
                waist_right
                hip_right
                hem_right
                hem_left
                hip_left
                waist_left
        layer straps:
            line left_neck trim width 0.35:
                bib_left
                neck_left
            mirror left_neck as right_neck
            line waist_tie trim width 0.3:
                waist_left
                waist_right
        layer detail:
            rect pocket trim:
                x pocket_mid_x - pocket_width / 2
                y pocket_y
                w pocket_width
                h pocket_height
        surface garment:
            bib
