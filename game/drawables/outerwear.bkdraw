bakerrrr-drawable 2

# Worn geometry is derived from frozen body Points. Local coordinate Scalars
# are explicit; body_unit is a body-height measure, never a naked offset.
drawable jacket context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (shoulder_anchor_x, shoulder_y) = shoulder_left
    let (crotch_x, hip_y) = crotch
    let (left_hand_x, hand_y) = between(wrist_inner_left, wrist_outer_left, 0.5)
    let shoulder_half = upper_torso_width / 2
    paint fabric = fill
    paint trim = edge
    paint shadow = shade
    let top_y = shoulder_y
    let bottom_y = hip_y
    variant compact:
        layer body:
            rect body fabric:
                x body_mid_x - shoulder_half - body_unit * 0.5
                y top_y
                w shoulder_half + shoulder_half + body_unit * 1
                h bottom_y - top_y
            polygon left_sleeve fabric:
                body_mid_x - shoulder_half, top_y
                body_mid_x - shoulder_half - body_unit * 0.75, top_y + body_unit * 1
                left_hand_x - body_unit * 0.25, hand_y - body_unit * 0.25
                left_hand_x + body_unit * 0.5, hand_y - body_unit * 0.25
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1.5
            mirror left_sleeve as right_sleeve
        layer detail:
            line opening shadow width 0.45:
                body_mid_x, top_y
                body_mid_x, bottom_y
        surface garment:
            body
            left_sleeve
            right_sleeve
    variant detailed:
        layer body:
            rect body fabric:
                x body_mid_x - shoulder_half - body_unit * 0.5
                y top_y
                w shoulder_half + shoulder_half + body_unit * 1
                h bottom_y - top_y
                outline trim
                width 0.35
            polygon left_sleeve fabric outline trim width 0.3:
                body_mid_x - shoulder_half, top_y
                body_mid_x - shoulder_half - body_unit * 0.25, top_y + body_unit * 1
                left_hand_x - body_unit * 0.25, hand_y - body_unit * 0.25
                left_hand_x + body_unit * 0.5, hand_y - body_unit * 0.25
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1.5
            mirror left_sleeve as right_sleeve
        layer detail:
            line opening shadow width 0.3:
                body_mid_x, top_y
                body_mid_x, bottom_y
            line left_lapel trim width 0.3:
                body_mid_x - body_unit * 2, top_y
                body_mid_x - body_unit * 0.5, top_y + body_unit * 2.5
                body_mid_x - body_unit * 2, top_y + body_unit * 4
            mirror left_lapel as right_lapel
        surface garment:
            body
            left_sleeve
            right_sleeve

    presentation ground:
        variant compact:
            layer body:
                polygon torso fill outline outline width 0.6:
                    mid - 3, 4
                    mid + 3, 4
                    mid + 3, 13
                    mid - 3, 13
                polygon left_sleeve fill outline outline width 0.6:
                    mid - 3, 5
                    mid - 5, 6
                    mid - 6, 12
                    mid - 4, 11
                mirror left_sleeve as right_sleeve
            layer trim:
                line opening shade width 0.6:
                    mid, 4
                    mid, 13
            surface item:
                torso
                left_sleeve
                right_sleeve

drawable windbreaker context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (shoulder_anchor_x, shoulder_y) = shoulder_left
    let (crotch_x, hip_y) = crotch
    let (left_hand_x, hand_y) = between(wrist_inner_left, wrist_outer_left, 0.5)
    let shoulder_half = upper_torso_width / 2
    let hip_half = hip_width / 2
    paint fabric = fill
    paint trim = edge
    paint shadow = shade
    let top_y = shoulder_y - body_unit * 0.25
    let bottom_y = hip_y
    variant compact:
        layer body:
            polygon body fabric:
                body_mid_x - shoulder_half - body_unit * 0.75, top_y
                body_mid_x + shoulder_half + body_unit * 0.75, top_y
                body_mid_x + hip_half + body_unit * 0.75, bottom_y
                body_mid_x - hip_half - body_unit * 0.75, bottom_y
            polygon left_sleeve fabric:
                body_mid_x - shoulder_half, top_y
                body_mid_x - shoulder_half - body_unit * 0.75, top_y + body_unit * 1
                left_hand_x - body_unit * 0.25, hand_y - body_unit * 0.25
                left_hand_x + body_unit * 0.5, hand_y - body_unit * 0.25
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1.5
            mirror left_sleeve as right_sleeve
        layer detail:
            line zipper shadow width 0.4:
                body_mid_x, top_y
                body_mid_x, bottom_y
        surface garment:
            body
            left_sleeve
            right_sleeve
    variant detailed:
        layer body:
            polygon body fabric outline trim width 0.3:
                body_mid_x - shoulder_half - body_unit * 0.75, top_y
                body_mid_x + shoulder_half + body_unit * 0.75, top_y
                body_mid_x + hip_half + body_unit * 0.75, bottom_y
                body_mid_x - hip_half - body_unit * 0.75, bottom_y
            polygon left_sleeve fabric outline trim width 0.3:
                body_mid_x - shoulder_half, top_y
                body_mid_x - shoulder_half - body_unit * 0.25, top_y + body_unit * 1
                left_hand_x - body_unit * 0.25, hand_y - body_unit * 0.25
                left_hand_x + body_unit * 0.5, hand_y - body_unit * 0.25
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1.5
            mirror left_sleeve as right_sleeve
        layer detail:
            line zipper shadow width 0.25:
                body_mid_x, top_y
                body_mid_x, bottom_y
            line elastic_hem trim width 0.4:
                body_mid_x - hip_half - body_unit * 1, bottom_y
                body_mid_x + hip_half + body_unit * 1, bottom_y
            when detail has hooded:
                ellipse hood trim:
                    x body_mid_x - body_unit * 2.5
                    y top_y - body_unit * 2
                    w body_unit * 5
                    h body_unit * 3
        surface garment:
            body
            left_sleeve
            right_sleeve

    presentation ground:
        variant compact:
            layer hood:
                ellipse hood fill:
                    x mid - 2
                    y 2
                    w 4
                    h 4
                    outline outline
                    width 0.6
            layer body:
                polygon torso fill outline outline width 0.6:
                    mid - 3, 5
                    mid + 3, 5
                    mid + 4, 12
                    mid - 4, 12
                polygon left_sleeve fill outline outline width 0.6:
                    mid - 3, 6
                    mid - 5, 7
                    mid - 6, 12
                    mid - 4, 11
                mirror left_sleeve as right_sleeve
            layer trim:
                line zipper shade width 0.6:
                    mid, 5
                    mid, 12
                line elastic_hem edge width 0.5:
                    mid - 4, 12
                    mid + 4, 12
            surface item:
                hood
                torso
                left_sleeve
                right_sleeve

drawable coat context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (shoulder_anchor_x, shoulder_y) = shoulder_left
    let (crotch_x, hip_y) = crotch
    let (left_toe_x, foot_y) = toe_tip_left
    let (left_hand_x, hand_y) = between(wrist_inner_left, wrist_outer_left, 0.5)
    let shoulder_half = upper_torso_width / 2
    let hip_half = hip_width / 2
    paint fabric = fill
    paint trim = edge
    paint shadow = shade
    let top_y = shoulder_y - body_unit * 0.25
    let bottom_y = foot_y - body_unit * 2
    variant compact:
        layer body:
            polygon body fabric:
                body_mid_x - shoulder_half - body_unit * 0.5, top_y
                body_mid_x + shoulder_half + body_unit * 0.5, top_y
                body_mid_x + hip_half + body_unit * 0.5, bottom_y
                body_mid_x - hip_half - body_unit * 0.5, bottom_y
            polygon left_sleeve fabric:
                body_mid_x - shoulder_half, top_y
                body_mid_x - shoulder_half - body_unit * 0.75, top_y + body_unit * 1
                left_hand_x - body_unit * 0.25, hand_y - body_unit * 0.25
                left_hand_x + body_unit * 0.5, hand_y - body_unit * 0.25
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1.5
            mirror left_sleeve as right_sleeve
        layer detail:
            line opening shadow width 0.45:
                body_mid_x, top_y
                body_mid_x, bottom_y
        surface garment:
            body
            left_sleeve
            right_sleeve
    variant detailed:
        layer body:
            polygon body fabric outline trim width 0.35:
                body_mid_x - shoulder_half - body_unit * 0.5, top_y
                body_mid_x + shoulder_half + body_unit * 0.5, top_y
                body_mid_x + hip_half + body_unit * 0.5, bottom_y
                body_mid_x - hip_half - body_unit * 0.5, bottom_y
            polygon left_sleeve fabric outline trim width 0.3:
                body_mid_x - shoulder_half, top_y
                body_mid_x - shoulder_half - body_unit * 0.25, top_y + body_unit * 1
                left_hand_x - body_unit * 0.25, hand_y - body_unit * 0.25
                left_hand_x + body_unit * 0.5, hand_y - body_unit * 0.25
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1.5
            mirror left_sleeve as right_sleeve
        layer detail:
            line opening shadow width 0.3:
                body_mid_x, top_y
                body_mid_x, bottom_y
            circle upper_button trim:
                center body_mid_x + body_unit * 0.5, shoulder_y + body_unit * 3
                radius body_unit * 0.25
            circle lower_button trim:
                center body_mid_x + body_unit * 0.5, hip_y
                radius body_unit * 0.25
        surface garment:
            body
            left_sleeve
            right_sleeve

    presentation ground:
        variant compact:
            layer body:
                polygon torso fill outline outline width 0.6:
                    mid - 3, 4
                    mid + 3, 4
                    mid + 3, 14
                    mid - 3, 14
                polygon left_sleeve fill outline outline width 0.6:
                    mid - 3, 5
                    mid - 5, 6
                    mid - 6, 13
                    mid - 4, 12
                mirror left_sleeve as right_sleeve
            layer trim:
                line opening shade width 0.6:
                    mid, 4
                    mid, 14
                circle upper_button edge:
                    center mid + 0.5, 8
                    radius 0.35
                circle lower_button edge:
                    center mid + 0.5, 11
                    radius 0.35
            surface item:
                torso
                left_sleeve
                right_sleeve

drawable cardigan context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (shoulder_anchor_x, shoulder_y) = shoulder_left
    let (crotch_x, hip_y) = crotch
    let (left_hand_x, hand_y) = between(wrist_inner_left, wrist_outer_left, 0.5)
    let shoulder_half = upper_torso_width / 2
    let hip_half = hip_width / 2
    paint fabric = fill
    paint trim = edge
    let top_y = shoulder_y
    let bottom_y = hip_y + body_unit * 1
    variant compact:
        layer body:
            polygon left_front fabric:
                body_mid_x - shoulder_half, top_y
                body_mid_x, top_y + body_unit * 1
                body_mid_x - body_unit * 0.5, bottom_y
                body_mid_x - hip_half, bottom_y
            mirror left_front as right_front
            polygon left_sleeve fabric:
                body_mid_x - shoulder_half, top_y
                body_mid_x - shoulder_half - body_unit * 0.75, top_y + body_unit * 1
                left_hand_x - body_unit * 0.25, hand_y - body_unit * 0.25
                left_hand_x + body_unit * 0.5, hand_y - body_unit * 0.25
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1.5
            mirror left_sleeve as right_sleeve
        surface garment:
            left_front
            right_front
            left_sleeve
            right_sleeve
    variant detailed:
        layer body:
            polygon left_front fabric outline trim width 0.25:
                body_mid_x - shoulder_half, top_y
                body_mid_x, top_y + body_unit * 1
                body_mid_x - body_unit * 0.5, bottom_y
                body_mid_x - hip_half, bottom_y
            mirror left_front as right_front
            polygon left_sleeve fabric outline trim width 0.25:
                body_mid_x - shoulder_half, top_y
                body_mid_x - shoulder_half - body_unit * 0.25, top_y + body_unit * 1
                left_hand_x - body_unit * 0.25, hand_y - body_unit * 0.25
                left_hand_x + body_unit * 0.5, hand_y - body_unit * 0.25
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1.5
            mirror left_sleeve as right_sleeve
        layer detail:
            line left_opening trim width 0.35:
                body_mid_x, top_y + body_unit * 1
                body_mid_x - body_unit * 0.5, bottom_y
            mirror left_opening as right_opening
        surface garment:
            left_front
            right_front
            left_sleeve
            right_sleeve

    presentation ground:
        variant compact:
            layer body:
                polygon torso fill outline outline width 0.6:
                    mid - 3, 4
                    mid + 3, 4
                    mid + 3, 13
                    mid - 3, 13
                polygon left_sleeve fill outline outline width 0.6:
                    mid - 3, 5
                    mid - 5, 6
                    mid - 6, 12
                    mid - 4, 11
                mirror left_sleeve as right_sleeve
            layer trim:
                line left_opening shade width 0.6:
                    mid - 2, 4
                    mid, 8
                    mid, 13
                mirror left_opening as right_opening
                circle upper_button edge:
                    center mid, 9
                    radius 0.3
                circle lower_button edge:
                    center mid, 11
                    radius 0.3
            surface item:
                torso
                left_sleeve
                right_sleeve

