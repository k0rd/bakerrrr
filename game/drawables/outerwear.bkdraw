bakerrrr-drawable 2

# Worn geometry is derived from frozen body Points. Local coordinate Scalars
# are explicit; body_unit is a body-height measure, never a naked offset.
drawable jacket context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (shoulder_anchor_x, shoulder_y) = shoulder_left
    point neckline = between(chin, crotch, 0.5)
    point left_collar = body_mid_x - neck_width / 2, shoulder_y
    point right_collar = body_mid_x + neck_width / 2, shoulder_y
    point left_hem = between(waist_left, hip_left, 0.5)
    point right_hem = between(waist_right, hip_right, 0.5)
    let (neckline_x, neckline_y) = neckline
    let (left_hem_x, hem_y) = left_hem
    let (right_hem_x, right_hem_y) = right_hem
    point left_lapel_tip = body_mid_x - body_unit * 0.5, neckline_y + body_unit * 1.25
    paint fabric = fill
    paint trim = edge
    paint shadow = shade

    variant compact:
        layer body:
            polygon body fabric:
                shoulder_left
                left_collar
                neckline
                right_collar
                shoulder_right
                right_hem
                left_hem
            polygon left_sleeve fabric:
                shoulder_left
                elbow_outer_left
                wrist_outer_left
                wrist_inner_left
                elbow_inner_left
                armpit_left
            mirror left_sleeve as right_sleeve
        layer detail:
            line collar trim width 0.4:
                left_collar
                neckline
                right_collar
            line hem trim width 0.35:
                left_hem
                right_hem
        surface garment:
            body
            left_sleeve
            right_sleeve

    variant detailed:
        layer body:
            polygon body fabric outline trim width 0.3:
                shoulder_left
                left_collar
                neckline
                right_collar
                shoulder_right
                right_hem
                left_hem
            polygon left_sleeve fabric outline trim width 0.3:
                shoulder_left
                elbow_outer_left
                wrist_outer_left
                wrist_inner_left
                elbow_inner_left
                armpit_left
            mirror left_sleeve as right_sleeve
        layer tailoring:
            line left_lapel trim width 0.3:
                left_collar
                neckline
                left_lapel_tip
            mirror left_lapel as right_lapel
            line hem trim width 0.3:
                left_hem
                right_hem
            line left_cuff trim width 0.35:
                wrist_outer_left
                wrist_inner_left
            mirror left_cuff as right_cuff
            when detail has cropped:
                line cropped_band trim width 0.3:
                    left_hem_x, hem_y - body_unit * 0.4
                    right_hem_x, right_hem_y - body_unit * 0.4
            when detail has boxy:
                line left_yoke trim width 0.25:
                    shoulder_left
                    left_collar
                mirror left_yoke as right_yoke
            when detail has workwear:
                rect left_pocket shadow:
                    x left_hem_x + body_unit * 0.25
                    y hem_y - body_unit * 1.5
                    w body_unit * 1.25
                    h body_unit * 0.8
                mirror left_pocket as right_pocket
            when detail has lined:
                line left_lining shadow width 0.25:
                    left_collar
                    left_lapel_tip
                    left_hem
                mirror left_lining as right_lining
        surface garment:
            body
            left_sleeve
            right_sleeve

    presentation ground:
        variant compact:
            layer body:
                polygon torso fill outline outline width 0.6:
                    mid - 3, 4
                    mid + 3, 4
                    mid + 3, 13
                    mid - 3, 13
                polygon left_sleeve fill outline outline width 0.6:
                    mid - 3, 5
                    mid - 5, 6
                    mid - 6, 12
                    mid - 4, 11
                mirror left_sleeve as right_sleeve
            layer trim:
                line opening shade width 0.6:
                    mid, 4
                    mid, 13
            surface item:
                torso
                left_sleeve
                right_sleeve

drawable windbreaker context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (shoulder_anchor_x, shoulder_y) = shoulder_left
    let (crotch_x, hip_y) = crotch
    let (left_hand_x, hand_y) = between(wrist_inner_left, wrist_outer_left, 0.5)
    let shoulder_half = upper_torso_width / 2
    let hip_half = hip_width / 2
    paint fabric = fill
    paint trim = edge
    paint shadow = shade
    let top_y = shoulder_y - body_unit * 0.25
    let bottom_y = hip_y
    variant compact:
        layer body:
            polygon body fabric:
                body_mid_x - shoulder_half - body_unit * 0.75, top_y
                body_mid_x + shoulder_half + body_unit * 0.75, top_y
                body_mid_x + hip_half + body_unit * 0.75, bottom_y
                body_mid_x - hip_half - body_unit * 0.75, bottom_y
            polygon left_sleeve fabric:
                body_mid_x - shoulder_half, top_y
                body_mid_x - shoulder_half - body_unit * 0.75, top_y + body_unit * 1
                left_hand_x - body_unit * 0.25, hand_y - body_unit * 0.25
                left_hand_x + body_unit * 0.5, hand_y - body_unit * 0.25
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1.5
            mirror left_sleeve as right_sleeve
        layer detail:
            line zipper shadow width 0.4:
                body_mid_x, top_y
                body_mid_x, bottom_y
        surface garment:
            body
            left_sleeve
            right_sleeve
    variant detailed:
        layer body:
            polygon body fabric outline trim width 0.3:
                body_mid_x - shoulder_half - body_unit * 0.75, top_y
                body_mid_x + shoulder_half + body_unit * 0.75, top_y
                body_mid_x + hip_half + body_unit * 0.75, bottom_y
                body_mid_x - hip_half - body_unit * 0.75, bottom_y
            polygon left_sleeve fabric outline trim width 0.3:
                body_mid_x - shoulder_half, top_y
                body_mid_x - shoulder_half - body_unit * 0.25, top_y + body_unit * 1
                left_hand_x - body_unit * 0.25, hand_y - body_unit * 0.25
                left_hand_x + body_unit * 0.5, hand_y - body_unit * 0.25
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1.5
            mirror left_sleeve as right_sleeve
        layer detail:
            line zipper shadow width 0.25:
                body_mid_x, top_y
                body_mid_x, bottom_y
            line elastic_hem trim width 0.4:
                body_mid_x - hip_half - body_unit * 1, bottom_y
                body_mid_x + hip_half + body_unit * 1, bottom_y
            when detail has hooded:
                ellipse hood trim:
                    x body_mid_x - body_unit * 2.5
                    y top_y - body_unit * 2
                    w body_unit * 5
                    h body_unit * 3
        surface garment:
            body
            left_sleeve
            right_sleeve

    presentation ground:
        variant compact:
            layer hood:
                ellipse hood fill:
                    x mid - 2
                    y 2
                    w 4
                    h 4
                    outline outline
                    width 0.6
            layer body:
                polygon torso fill outline outline width 0.6:
                    mid - 3, 5
                    mid + 3, 5
                    mid + 4, 12
                    mid - 4, 12
                polygon left_sleeve fill outline outline width 0.6:
                    mid - 3, 6
                    mid - 5, 7
                    mid - 6, 12
                    mid - 4, 11
                mirror left_sleeve as right_sleeve
            layer trim:
                line zipper shade width 0.6:
                    mid, 5
                    mid, 12
                line elastic_hem edge width 0.5:
                    mid - 4, 12
                    mid + 4, 12
            surface item:
                hood
                torso
                left_sleeve
                right_sleeve

drawable coat context garment:
    paint fabric = fill
    paint trim = edge
    paint shadow = shade
    point neck_center = between(neck_left, neck_right, 0.5)
    point waist_center = between(waist_left, waist_right, 0.5)
    point hip_center = between(hip_left, hip_right, 0.5)
    point knee_center = between(knee_outer_left, knee_outer_right, 0.5)
    point neckline = between(neck_center, waist_center, 0.55)
    point collar_left = between(neck_left, armpit_left, 0.4)
    point collar_right = between(neck_right, armpit_right, 0.4)
    point waist_fit_left = between(waist_right, waist_left, 1.12)
    point waist_fit_right = between(waist_left, waist_right, 1.12)
    point hip_fit_left = between(hip_right, hip_left, 1.04)
    point hip_fit_right = between(hip_left, hip_right, 1.04)
    point hem_center = between(hip_center, knee_center, 0.7)
    let (mid_x, hem_y) = hem_center
    let (left_hip_x, left_hip_y) = hip_fit_left
    let (right_hip_x, right_hip_y) = hip_fit_right
    point hem_left = left_hip_x - hip_width / 20, hem_y
    point hem_right = right_hip_x + hip_width / 20, hem_y
    point vent_left = mid_x - neck_width * 0.55, hem_y
    point vent_right = mid_x + neck_width * 0.55, hem_y
    point vent_top = between(hem_center, waist_center, 0.25)
    point cuff_inner = between(elbow_inner_left, wrist_inner_left, 0.95)
    point cuff_outer = between(elbow_outer_left, wrist_outer_left, 0.95)
    point upper_fastening = between(neckline, waist_center, 0.65)
    point lower_fastening = between(waist_center, hip_center, 0.5)
    let (upper_x, upper_y) = upper_fastening
    let (lower_x, lower_y) = lower_fastening
    variant compact:
        layer body:
            polygon body fabric:
                shoulder_left
                collar_left
                neckline
                collar_right
                shoulder_right
                armpit_right
                waist_fit_right
                hip_fit_right
                hem_right
                vent_right
                vent_top
                vent_left
                hem_left
                hip_fit_left
                waist_fit_left
                armpit_left
            polygon left_sleeve fabric:
                shoulder_left
                elbow_outer_left
                cuff_outer
                cuff_inner
                elbow_inner_left
                armpit_left
            mirror left_sleeve as right_sleeve
        layer tailoring:
            line opening shadow width 0.25:
                neckline
                vent_top
            line collar trim width 0.25:
                collar_left
                neckline
                collar_right
            line left_cuff trim width 0.3:
                cuff_inner
                cuff_outer
            mirror left_cuff as right_cuff
        surface garment:
            body
            left_sleeve
            right_sleeve

    variant detailed:
        layer body:
            polygon body fabric outline trim width 0.25:
                shoulder_left
                collar_left
                neckline
                collar_right
                shoulder_right
                armpit_right
                waist_fit_right
                hip_fit_right
                hem_right
                vent_right
                vent_top
                vent_left
                hem_left
                hip_fit_left
                waist_fit_left
                armpit_left
            polygon left_sleeve fabric outline trim width 0.25:
                shoulder_left
                elbow_outer_left
                cuff_outer
                cuff_inner
                elbow_inner_left
                armpit_left
            mirror left_sleeve as right_sleeve
        layer tailoring:
            line opening shadow width 0.25:
                neckline
                vent_top
            line collar trim width 0.25:
                collar_left
                neckline
                collar_right
            line left_cuff trim width 0.3:
                cuff_inner
                cuff_outer
            mirror left_cuff as right_cuff
            circle upper_button trim:
                center upper_x + neck_width * 0.4, upper_y
                radius neck_width / 5
            circle lower_button trim:
                center lower_x + neck_width * 0.4, lower_y
                radius neck_width / 5
        surface garment:
            body
            left_sleeve
            right_sleeve

    presentation ground:
        variant compact:
            layer body:
                polygon torso fill outline outline width 0.6:
                    mid - 3, 4
                    mid + 3, 4
                    mid + 3, 14
                    mid - 3, 14
                polygon left_sleeve fill outline outline width 0.6:
                    mid - 3, 5
                    mid - 5, 6
                    mid - 6, 13
                    mid - 4, 12
                mirror left_sleeve as right_sleeve
            layer trim:
                line opening shade width 0.6:
                    mid, 4
                    mid, 14
                circle upper_button edge:
                    center mid + 0.5, 8
                    radius 0.35
                circle lower_button edge:
                    center mid + 0.5, 11
                    radius 0.35
            surface item:
                torso
                left_sleeve
                right_sleeve

drawable cardigan context garment:
    paint fabric = fill
    paint trim = edge
    point waist_center = between(waist_left, waist_right, 0.5)
    let (mid_x, waist_y) = waist_center
    point waist_fit_left = between(waist_right, waist_left, 1.08)
    point hem_left = between(waist_left, hip_left, 1.12)
    let (hem_x, hem_y) = hem_left
    point opening_waist = mid_x - neck_width * 0.65, waist_y
    point opening_hem = mid_x - neck_width * 0.8, hem_y
    point cuff_inner = between(elbow_inner_left, wrist_inner_left, 0.95)
    point cuff_outer = between(elbow_outer_left, wrist_outer_left, 0.95)
    variant compact:
        layer body:
            polygon left_front fabric:
                shoulder_left
                neck_left
                opening_waist
                opening_hem
                hem_left
                waist_fit_left
                armpit_left
            mirror left_front as right_front
            polygon left_sleeve fabric:
                shoulder_left
                elbow_outer_left
                cuff_outer
                cuff_inner
                elbow_inner_left
                armpit_left
            mirror left_sleeve as right_sleeve
        layer knit:
            line left_opening trim width 0.25:
                neck_left
                opening_waist
                opening_hem
            mirror left_opening as right_opening
            line left_hem trim width 0.25:
                hem_left
                opening_hem
            mirror left_hem as right_hem
            line left_cuff trim width 0.3:
                cuff_inner
                cuff_outer
            mirror left_cuff as right_cuff
        surface garment:
            left_front
            right_front
            left_sleeve
            right_sleeve

    variant detailed:
        layer body:
            polygon left_front fabric outline trim width 0.25:
                shoulder_left
                neck_left
                opening_waist
                opening_hem
                hem_left
                waist_fit_left
                armpit_left
            mirror left_front as right_front
            polygon left_sleeve fabric outline trim width 0.25:
                shoulder_left
                elbow_outer_left
                cuff_outer
                cuff_inner
                elbow_inner_left
                armpit_left
            mirror left_sleeve as right_sleeve
        layer knit:
            line left_opening trim width 0.25:
                neck_left
                opening_waist
                opening_hem
            mirror left_opening as right_opening
            line left_hem trim width 0.25:
                hem_left
                opening_hem
            mirror left_hem as right_hem
            line left_cuff trim width 0.3:
                cuff_inner
                cuff_outer
            mirror left_cuff as right_cuff
        surface garment:
            left_front
            right_front
            left_sleeve
            right_sleeve

    presentation ground:
        variant compact:
            layer body:
                polygon torso fill outline outline width 0.6:
                    mid - 3, 4
                    mid + 3, 4
                    mid + 3, 13
                    mid - 3, 13
                polygon left_sleeve fill outline outline width 0.6:
                    mid - 3, 5
                    mid - 5, 6
                    mid - 6, 12
                    mid - 4, 11
                mirror left_sleeve as right_sleeve
            layer trim:
                line left_opening shade width 0.6:
                    mid - 2, 4
                    mid, 8
                    mid, 13
                mirror left_opening as right_opening
                circle upper_button edge:
                    center mid, 9
                    radius 0.3
                circle lower_button edge:
                    center mid, 11
                    radius 0.3
            surface item:
                torso
                left_sleeve
                right_sleeve

drawable blazer context garment:
    paint fabric = fill
    paint trim = edge
    paint shadow = shade
    point neck_center = between(neck_left, neck_right, 0.5)
    point waist_center = between(waist_left, waist_right, 0.5)
    point neckline = between(neck_center, waist_center, 0.75)
    point collar_left = between(neck_left, armpit_left, 0.5)
    point collar_right = between(neck_right, armpit_right, 0.5)
    point waist_fit_left = between(waist_right, waist_left, 1.05)
    point waist_fit_right = between(waist_left, waist_right, 1.05)
    point hem_left = between(waist_left, hip_left, 0.95)
    point hem_right = between(waist_right, hip_right, 0.95)
    point hem_center = between(hem_left, hem_right, 0.5)
    point cuff_inner = between(elbow_inner_left, wrist_inner_left, 0.95)
    point cuff_outer = between(elbow_outer_left, wrist_outer_left, 0.95)
    point lapel_notch = between(shoulder_left, armpit_left, 0.35)
    point lapel_tip = between(armpit_left, neckline, 0.35)
    point pocket_outer = between(waist_fit_left, hem_left, 0.6)
    point pocket_center = between(waist_center, hem_center, 0.6)
    point pocket_inner = between(pocket_outer, pocket_center, 0.55)
    variant compact:
        layer body:
            polygon body fabric:
                shoulder_left
                collar_left
                neckline
                collar_right
                shoulder_right
                armpit_right
                waist_fit_right
                hem_right
                hem_left
                waist_fit_left
                armpit_left
            polygon left_sleeve fabric:
                shoulder_left
                elbow_outer_left
                cuff_outer
                cuff_inner
                elbow_inner_left
                armpit_left
            mirror left_sleeve as right_sleeve
        layer tailoring:
            polygon left_lapel trim:
                collar_left
                shoulder_left
                lapel_notch
                lapel_tip
                neckline
            mirror left_lapel as right_lapel
        surface garment:
            body
            left_sleeve
            right_sleeve

    variant detailed:
        layer body:
            polygon body fabric outline trim width 0.25:
                shoulder_left
                collar_left
                neckline
                collar_right
                shoulder_right
                armpit_right
                waist_fit_right
                hem_right
                hem_left
                waist_fit_left
                armpit_left
            polygon left_sleeve fabric outline trim width 0.25:
                shoulder_left
                elbow_outer_left
                cuff_outer
                cuff_inner
                elbow_inner_left
                armpit_left
            mirror left_sleeve as right_sleeve
        layer tailoring:
            polygon left_lapel trim:
                collar_left
                shoulder_left
                lapel_notch
                lapel_tip
                neckline
            mirror left_lapel as right_lapel
            line opening trim width 0.2:
                neckline
                hem_center
            circle button shadow:
                center waist_center
                radius neck_width / 5
            line left_pocket shadow width 0.25:
                pocket_outer
                pocket_inner
            mirror left_pocket as right_pocket
            line left_cuff trim width 0.25:
                cuff_inner
                cuff_outer
            mirror left_cuff as right_cuff
        surface garment:
            body
            left_sleeve
            right_sleeve

    presentation ground:
        variant compact:
            layer body:
                polygon torso fill outline outline width 0.6:
                    mid - 3, 4
                    mid + 3, 4
                    mid + 3, 13
                    mid - 3, 13
                polygon left_sleeve fill outline outline width 0.6:
                    mid - 3, 5
                    mid - 5, 6
                    mid - 6, 12
                    mid - 4, 11
                mirror left_sleeve as right_sleeve
            layer trim:
                line left_lapel edge width 0.6:
                    mid - 3, 4
                    mid, 8
                mirror left_lapel as right_lapel
                line opening shade width 0.5:
                    mid, 8
                    mid, 13
            surface item:
                torso
                left_sleeve
                right_sleeve

drawable vest context garment:
    paint fabric = fill
    paint trim = edge
    paint shadow = shade
    point neck_center = between(neck_left, neck_right, 0.5)
    point waist_center = between(waist_left, waist_right, 0.5)
    point hip_center = between(hip_left, hip_right, 0.5)
    point neckline = between(neck_center, waist_center, 0.65)
    point collar_left = between(neck_left, armpit_left, 0.4)
    point collar_right = between(neck_right, armpit_right, 0.4)
    point armhole_left = between(armpit_left, waist_left, 0.15)
    point armhole_right = between(armpit_right, waist_right, 0.15)
    point hem_left = between(waist_left, hip_left, 0.6)
    point hem_right = between(waist_right, hip_right, 0.6)
    point hem_center = between(waist_center, hip_center, 0.8)
    let (mid_x, hem_y) = hem_center
    point left_tip = mid_x - waist_width * 0.35, hem_y + neck_width / 4
    point right_tip = mid_x + waist_width * 0.35, hem_y + neck_width / 4
    point hem_notch = mid_x, hem_y - neck_width * 0.4
    variant compact:
        layer body:
            polygon body fabric:
                shoulder_left
                collar_left
                neckline
                collar_right
                shoulder_right
                armhole_right
                waist_right
                hem_right
                right_tip
                hem_notch
                left_tip
                hem_left
                waist_left
                armhole_left
        layer tailoring:
            line opening shadow width 0.2:
                neckline
                hem_notch
        surface garment:
            body

    variant detailed:
        layer body:
            polygon body fabric outline trim width 0.25:
                shoulder_left
                collar_left
                neckline
                collar_right
                shoulder_right
                armhole_right
                waist_right
                hem_right
                right_tip
                hem_notch
                left_tip
                hem_left
                waist_left
                armhole_left
        layer tailoring:
            line opening shadow width 0.2:
                neckline
                hem_notch
            circle upper_button trim:
                center between(neckline, hem_notch, 0.35)
                radius neck_width / 6
            circle lower_button trim:
                center between(neckline, hem_notch, 0.75)
                radius neck_width / 6
        surface garment:
            body

    presentation ground:
        variant compact:
            layer body:
                polygon torso fill outline outline width 0.6:
                    mid - 3, 4
                    mid + 3, 4
                    mid + 3, 13
                    mid - 3, 13
            layer trim:
                line left_armhole shade width 0.6:
                    mid - 3, 4
                    mid - 2, 7
                mirror left_armhole as right_armhole
                line opening edge width 0.5:
                    mid, 5
                    mid, 13
            surface item:
                torso

drawable maintenance_vest context garment:
    paint fabric = fill
    paint trim = edge
    paint shadow = shade
    point neck_center = between(neck_left, neck_right, 0.5)
    point waist_center = between(waist_left, waist_right, 0.5)
    point hem_center = between(hip_left, hip_right, 0.5)
    point neckline = between(neck_center, waist_center, 0.5)
    point collar_left = between(neck_left, armpit_left, 0.4)
    point collar_right = between(neck_right, armpit_right, 0.4)
    point waist_fit_left = between(waist_right, waist_left, 1.15)
    point waist_fit_right = between(waist_left, waist_right, 1.15)
    point band_left_edge = between(waist_fit_left, hip_left, 0.2)
    point band_right_edge = between(waist_fit_right, hip_right, 0.2)
    point band_center = between(band_left_edge, band_right_edge, 0.5)
    point band_left = between(band_left_edge, band_center, 0.3)
    point band_right = between(band_right_edge, band_center, 0.3)
    point pocket_level = between(waist_center, hem_center, 0.62)
    let (mid_x, pocket_y) = pocket_level
    let pocket_width = waist_width * 0.3
    let pocket_height = y_distance(waist_center, hem_center) / 5
    variant compact:
        layer body:
            polygon body fabric:
                shoulder_left
                collar_left
                neckline
                collar_right
                shoulder_right
                armpit_right
                waist_fit_right
                hip_right
                hip_left
                waist_fit_left
                armpit_left
        layer detail:
            line opening shadow width 0.2:
                neckline
                hem_center
            line safety_band trim width 0.45:
                band_left
                band_right
        surface garment:
            body

    variant detailed:
        layer body:
            polygon body fabric outline trim width 0.25:
                shoulder_left
                collar_left
                neckline
                collar_right
                shoulder_right
                armpit_right
                waist_fit_right
                hip_right
                hip_left
                waist_fit_left
                armpit_left
        layer detail:
            line opening shadow width 0.2:
                neckline
                hem_center
            line safety_band trim width 0.45:
                band_left
                band_right
            rect left_pocket shadow:
                x mid_x - waist_width * 0.42
                y pocket_y
                w pocket_width
                h pocket_height
            mirror left_pocket as right_pocket
        surface garment:
            body

    presentation ground:
        variant compact:
            layer body:
                polygon torso fill outline outline width 0.6:
                    mid - 3, 4
                    mid + 3, 4
                    mid + 3, 13
                    mid - 3, 13
            layer trim:
                line opening shade width 0.5:
                    mid, 4
                    mid, 13
                line reflective_band edge width 0.8:
                    mid - 3, 8
                    mid + 3, 8
                rect left_pocket edge:
                    x mid - 2.5
                    y 9
                    w 2
                    h 2
                mirror left_pocket as right_pocket
            surface item:
                torso

drawable rain_shell context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (shoulder_anchor_x, shoulder_y) = shoulder_left
    let (crotch_x, hip_y) = crotch
    let (left_hand_x, hand_y) = between(wrist_inner_left, wrist_outer_left, 0.5)
    let shoulder_half = upper_torso_width / 2
    let hip_half = hip_width / 2
    paint fabric = fill
    paint trim = edge
    paint shadow = shade
    let top_y = shoulder_y - body_unit * 0.25
    let bottom_y = hip_y + body_unit * 1
    variant compact:
        layer body:
            polygon body fabric:
                body_mid_x - shoulder_half - body_unit * 0.75, top_y
                body_mid_x + shoulder_half + body_unit * 0.75, top_y
                body_mid_x + hip_half + body_unit * 0.75, bottom_y
                body_mid_x - hip_half - body_unit * 0.75, bottom_y
            polygon left_sleeve fabric:
                body_mid_x - shoulder_half, top_y
                body_mid_x - shoulder_half - body_unit * 0.75, top_y + body_unit * 1
                left_hand_x - body_unit * 0.25, hand_y - body_unit * 0.25
                left_hand_x + body_unit * 0.5, hand_y - body_unit * 0.25
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1.5
            mirror left_sleeve as right_sleeve
            ellipse hood fabric:
                x body_mid_x - body_unit * 2.5
                y top_y - body_unit * 2
                w body_unit * 5
                h body_unit * 3
        layer detail:
            line zipper shadow width 0.4:
                body_mid_x, top_y
                body_mid_x, bottom_y
        surface garment:
            body
            left_sleeve
            right_sleeve
            hood
    variant detailed:
        layer body:
            polygon body fabric outline trim width 0.3:
                body_mid_x - shoulder_half - body_unit * 0.75, top_y
                body_mid_x + shoulder_half + body_unit * 0.75, top_y
                body_mid_x + hip_half + body_unit * 0.75, bottom_y
                body_mid_x - hip_half - body_unit * 0.75, bottom_y
            polygon left_sleeve fabric outline trim width 0.3:
                body_mid_x - shoulder_half, top_y
                body_mid_x - shoulder_half - body_unit * 0.25, top_y + body_unit * 1
                left_hand_x - body_unit * 0.25, hand_y - body_unit * 0.25
                left_hand_x + body_unit * 0.5, hand_y - body_unit * 0.25
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1.5
            mirror left_sleeve as right_sleeve
            ellipse hood fabric:
                x body_mid_x - body_unit * 2.75
                y top_y - body_unit * 2.25
                w body_unit * 5.5
                h body_unit * 3.5
                outline trim
                width 0.3
        layer detail:
            line zipper shadow width 0.25:
                body_mid_x, top_y
                body_mid_x, bottom_y
            line storm_flap trim width 0.25:
                body_mid_x + body_unit * 0.6, top_y
                body_mid_x + body_unit * 0.6, bottom_y
        surface garment:
            body
            left_sleeve
            right_sleeve
            hood

    presentation ground:
        variant compact:
            layer hood:
                ellipse hood fill:
                    x mid - 2
                    y 2
                    w 4
                    h 4
                    outline outline
                    width 0.6
            layer body:
                polygon torso fill outline outline width 0.6:
                    mid - 3, 5
                    mid + 3, 5
                    mid + 3, 14
                    mid - 3, 14
                polygon left_sleeve fill outline outline width 0.6:
                    mid - 3, 6
                    mid - 5, 7
                    mid - 6, 13
                    mid - 4, 12
                mirror left_sleeve as right_sleeve
            layer trim:
                line zipper shade width 0.6:
                    mid, 5
                    mid, 14
                line storm_hem edge width 0.5:
                    mid - 3, 12
                    mid + 3, 12
            surface item:
                hood
                torso
                left_sleeve
                right_sleeve

drawable security_jacket context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (shoulder_anchor_x, shoulder_y) = shoulder_left
    let (crotch_x, hip_y) = crotch
    let (left_hand_x, hand_y) = between(wrist_inner_left, wrist_outer_left, 0.5)
    let shoulder_half = upper_torso_width / 2
    paint fabric = fill
    paint trim = edge
    paint shadow = shade
    let top_y = shoulder_y
    let bottom_y = hip_y
    variant compact:
        layer body:
            rect body fabric:
                x body_mid_x - shoulder_half - body_unit * 0.5
                y top_y
                w shoulder_half + shoulder_half + body_unit * 1
                h bottom_y - top_y
            polygon left_sleeve fabric:
                body_mid_x - shoulder_half, top_y
                body_mid_x - shoulder_half - body_unit * 0.75, top_y + body_unit * 1
                left_hand_x - body_unit * 0.25, hand_y - body_unit * 0.25
                left_hand_x + body_unit * 0.5, hand_y - body_unit * 0.25
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1.5
            mirror left_sleeve as right_sleeve
        layer detail:
