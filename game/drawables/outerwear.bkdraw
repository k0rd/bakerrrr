    variant detailed:
        layer body:
            polygon body fabric outline trim width 0.3:
                body_mid_x - shoulder_half - body_unit * 0.75, top_y
                body_mid_x + shoulder_half + body_unit * 0.75, top_y
                body_mid_x + hip_half + body_unit * 0.75, bottom_y
                body_mid_x - hip_half - body_unit * 0.75, bottom_y
            polygon left_sleeve fabric outline trim width 0.3:
                body_mid_x - shoulder_half, top_y
                body_mid_x - shoulder_half - body_unit * 0.25, top_y + body_unit * 1
                left_hand_x - body_unit * 0.25, hand_y - body_unit * 0.25
                left_hand_x + body_unit * 0.5, hand_y - body_unit * 0.25
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1.5
            mirror left_sleeve as right_sleeve
            ellipse hood fabric:
                x body_mid_x - body_unit * 2.75
                y top_y - body_unit * 2.25
                w body_unit * 5.5
                h body_unit * 3.5
                outline trim
                width 0.3
        layer detail:
            line zipper shadow width 0.25:
                body_mid_x, top_y
                body_mid_x, bottom_y
            line storm_flap trim width 0.25:
                body_mid_x + body_unit * 0.6, top_y
                body_mid_x + body_unit * 0.6, bottom_y
        surface garment:
            body
            left_sleeve
            right_sleeve
            hood

    presentation ground:
        variant compact:
            layer hood:
                ellipse hood fill:
                    x mid - 2
                    y 2
                    w 4
                    h 4
                    outline outline
                    width 0.6
            layer body:
                polygon torso fill outline outline width 0.6:
                    mid - 3, 5
                    mid + 3, 5
                    mid + 3, 14
                    mid - 3, 14
                polygon left_sleeve fill outline outline width 0.6:
                    mid - 3, 6
                    mid - 5, 7
                    mid - 6, 13
                    mid - 4, 12
                mirror left_sleeve as right_sleeve
            layer trim:
                line zipper shade width 0.6:
                    mid, 5
                    mid, 14
                line storm_hem edge width 0.5:
                    mid - 3, 12
                    mid + 3, 12
            surface item:
                hood
                torso
                left_sleeve
                right_sleeve

drawable security_jacket context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (shoulder_anchor_x, shoulder_y) = shoulder_left
    let (crotch_x, hip_y) = crotch
    let (left_hand_x, hand_y) = between(wrist_inner_left, wrist_outer_left, 0.5)
    let shoulder_half = upper_torso_width / 2
    paint fabric = fill
    paint trim = edge
    paint shadow = shade
    let top_y = shoulder_y
    let bottom_y = hip_y
    variant compact:
        layer body:
            rect body fabric:
                x body_mid_x - shoulder_half - body_unit * 0.5
                y top_y
                w shoulder_half + shoulder_half + body_unit * 1
                h bottom_y - top_y
            polygon left_sleeve fabric:
                body_mid_x - shoulder_half, top_y
                body_mid_x - shoulder_half - body_unit * 0.75, top_y + body_unit * 1
                left_hand_x - body_unit * 0.25, hand_y - body_unit * 0.25
                left_hand_x + body_unit * 0.5, hand_y - body_unit * 0.25
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1.5
            mirror left_sleeve as right_sleeve
        layer detail:
            rect authority_patch trim:
                x body_mid_x + body_unit * 1
                y shoulder_y + body_unit * 1
                w body_unit * 1.5
                h body_unit * 1
        surface garment:
            body
            left_sleeve
            right_sleeve
    variant detailed:
        layer body:
            rect body fabric:
                x body_mid_x - shoulder_half - body_unit * 0.5
                y top_y
                w shoulder_half + shoulder_half + body_unit * 1
                h bottom_y - top_y
                outline trim
                width 0.35
            polygon left_sleeve fabric outline trim width 0.3:
                body_mid_x - shoulder_half, top_y
                body_mid_x - shoulder_half - body_unit * 0.25, top_y + body_unit * 1
                left_hand_x - body_unit * 0.25, hand_y - body_unit * 0.25
                left_hand_x + body_unit * 0.5, hand_y - body_unit * 0.25
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1.5
            mirror left_sleeve as right_sleeve
        layer detail:
            rect authority_patch trim:
                x body_mid_x + body_unit * 1
                y shoulder_y + body_unit * 1
                w body_unit * 1.5
                h body_unit * 1
            line opening shadow width 0.25:
                body_mid_x, top_y
                body_mid_x, bottom_y
            line shoulder_yoke trim width 0.3:
                body_mid_x - shoulder_half, shoulder_y + body_unit * 1
                body_mid_x + shoulder_half, shoulder_y + body_unit * 1
        surface garment:
            body
            left_sleeve
            right_sleeve

    presentation ground:
        variant compact:
            layer body:
                polygon torso fill outline outline width 0.6:
                    mid - 3, 4
                    mid + 3, 4
                    mid + 3, 13
                    mid - 3, 13
                polygon left_sleeve fill outline outline width 0.6:
                    mid - 3, 5
                    mid - 5, 6
                    mid - 6, 12
                    mid - 4, 11
                mirror left_sleeve as right_sleeve
            layer trim:
                line zipper shade width 0.6:
                    mid, 4
                    mid, 13
                line shoulder_band edge width 0.7:
                    mid - 3, 6
                    mid + 3, 6
                rect badge edge:
                    x mid + 0.5
                    y 7
                    w 1.5
                    h 1.5
            surface item:
                torso
                left_sleeve
                right_sleeve

drawable work_apron context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (shoulder_anchor_x, shoulder_y) = shoulder_left
    let (crotch_x, hip_y) = crotch
    let (left_toe_x, foot_y) = toe_tip_left
    let hip_half = hip_width / 2
    paint fabric = fill
    paint trim = edge
    let top_y = shoulder_y + body_unit * 1
    let bottom_y = foot_y - body_unit * 2
    variant compact:
        layer body:
            polygon bib fabric:
                body_mid_x - body_unit * 2, top_y
                body_mid_x + body_unit * 2, top_y
                body_mid_x + hip_half, bottom_y
                body_mid_x - hip_half, bottom_y
        layer straps:
            line left_neck trim width 0.5:
                body_mid_x - body_unit * 2, top_y
                body_mid_x - body_unit * 1.5, shoulder_y - body_unit * 1
            mirror left_neck as right_neck
            line waist_tie trim width 0.4:
                body_mid_x - hip_half - body_unit * 1, hip_y - body_unit * 1
                body_mid_x + hip_half + body_unit * 1, hip_y - body_unit * 1
        surface garment:
            bib
    variant detailed:
        layer body:
            polygon bib fabric outline trim width 0.3:
                body_mid_x - body_unit * 2, top_y
                body_mid_x + body_unit * 2, top_y
                body_mid_x + hip_half, bottom_y
                body_mid_x - hip_half, bottom_y
        layer straps:
            line left_neck trim width 0.35:
                body_mid_x - body_unit * 2, top_y
                body_mid_x - body_unit * 1.5, shoulder_y - body_unit * 1
            mirror left_neck as right_neck
            line waist_tie trim width 0.3:
                body_mid_x - hip_half - body_unit * 1, hip_y - body_unit * 1
                body_mid_x + hip_half + body_unit * 1, hip_y - body_unit * 1
        layer detail:
            rect pocket trim:
                x body_mid_x - body_unit * 2
                y hip_y + body_unit * 1
                w body_unit * 4
                h body_unit * 2
        surface garment:
            bib
