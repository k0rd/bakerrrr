drawable work_apron context garment:
    paint fabric = fill
    paint trim = edge
    let top_y = shoulder_y + 1
    let bottom_y = foot_y - 2
    variant compact:
        layer body:
            polygon bib fabric:
                mid - 2, top_y
                mid + 2, top_y
                mid + hip, bottom_y
                mid - hip, bottom_y
        layer straps:
            line left_neck trim width 0.5:
                mid - 2, top_y
                mid - 1.5, shoulder_y - 1
            mirror left_neck as right_neck
            line waist_tie trim width 0.4:
                mid - hip - 1, hip_y - 1
                mid + hip + 1, hip_y - 1
        surface garment:
            bib
    variant detailed:
        layer body:
            polygon bib fabric outline trim width 0.3:
                mid - 2, top_y
                mid + 2, top_y
                mid + hip, bottom_y
                mid - hip, bottom_y
        layer straps:
            line left_neck trim width 0.35:
                mid - 2, top_y
                mid - 1.5, shoulder_y - 1
            mirror left_neck as right_neck
            line waist_tie trim width 0.3:
                mid - hip - 1, hip_y - 1
                mid + hip + 1, hip_y - 1
        layer detail:
            rect pocket trim:
                x mid - 2
                y hip_y + 1
                w 4
                h 2
        surface garment:
            bib
