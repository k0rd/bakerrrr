drawable vest context garment:
    paint fabric = fill
    paint trim = edge
    paint shadow = shade
    let top_y = shoulder_y
    let bottom_y = hip_y
    variant compact:
        layer body:
            polygon body fabric:
                mid - shoulder, top_y + 1
                mid - 1.5, top_y
                mid, top_y + 2
                mid + 1.5, top_y
                mid + shoulder, top_y + 1
                mid + hip, bottom_y
                mid - hip, bottom_y
        surface garment:
            body
    variant detailed:
        layer body:
            polygon body fabric outline trim width 0.3:
                mid - shoulder, top_y + 1
                mid - 1.5, top_y
                mid, top_y + 2
                mid + 1.5, top_y
                mid + shoulder, top_y + 1
                mid + hip, bottom_y
                mid - hip, bottom_y
        layer detail:
            line opening shadow width 0.25:
                mid, top_y + 2
                mid, bottom_y
        surface garment:
            body

    presentation ground:
        variant compact:
            layer body:
                polygon torso fill outline outline width 0.6:
                    mid - 3, 4
                    mid + 3, 4
                    mid + 3, 13
                    mid - 3, 13
            layer trim:
                line left_armhole shade width 0.6:
                    mid - 3, 4
                    mid - 2, 7
                mirror left_armhole as right_armhole
                line opening edge width 0.5:
                    mid, 5
                    mid, 13
            surface item:
                torso

drawable maintenance_vest context garment:
    paint fabric = fill
    paint trim = edge
    paint shadow = shade
    let top_y = shoulder_y
    let bottom_y = hip_y
    variant compact:
        layer body:
            polygon body fabric:
                mid - shoulder, top_y + 1
                mid - 1.5, top_y
                mid, top_y + 2
                mid + 1.5, top_y
                mid + shoulder, top_y + 1
                mid + hip, bottom_y
                mid - hip, bottom_y
        layer detail:
            line safety_band trim width 0.75:
                mid - hip, hip_y - 2
                mid + hip, hip_y - 2
        surface garment:
            body
