                    center mid + 0.5, 8
                    radius 0.35
                circle lower_button edge:
                    center mid + 0.5, 11
                    radius 0.35
            surface item:
                torso
                left_sleeve
                right_sleeve

drawable cardigan context garment:
    paint fabric = fill
    paint trim = edge
    let top_y = shoulder_y
    let bottom_y = hip_y + 1
    variant compact:
        layer body:
            polygon left_front fabric:
                mid - shoulder, top_y
                mid, top_y + 1
                mid - 0.5, bottom_y
                mid - hip, bottom_y
            mirror left_front as right_front
            polygon left_sleeve fabric:
                mid - shoulder, top_y
                mid - shoulder - 0.75, top_y + 1
                left_hand_x - 0.25, hand_y - 0.25
                left_hand_x + 0.5, hand_y - 0.25
                mid - shoulder + 1, top_y + 1.5
            mirror left_sleeve as right_sleeve
        surface garment:
            left_front
            right_front
            left_sleeve
            right_sleeve
    variant detailed:
        layer body:
            polygon left_front fabric outline trim width 0.25:
                mid - shoulder, top_y
                mid, top_y + 1
                mid - 0.5, bottom_y
                mid - hip, bottom_y
            mirror left_front as right_front
            polygon left_sleeve fabric outline trim width 0.25:
                mid - shoulder, top_y
                mid - shoulder - 0.25, top_y + 1
                left_hand_x - 0.25, hand_y - 0.25
                left_hand_x + 0.5, hand_y - 0.25
                mid - shoulder + 1, top_y + 1.5
            mirror left_sleeve as right_sleeve
        layer detail:
            line left_opening trim width 0.35:
                mid, top_y + 1
                mid - 0.5, bottom_y
            mirror left_opening as right_opening
        surface garment:
            left_front
            right_front
            left_sleeve
            right_sleeve

    presentation ground:
        variant compact:
            layer body:
                polygon torso fill outline outline width 0.6:
                    mid - 3, 4
                    mid + 3, 4
                    mid + 3, 13
                    mid - 3, 13
                polygon left_sleeve fill outline outline width 0.6:
                    mid - 3, 5
                    mid - 5, 6
                    mid - 6, 12
                    mid - 4, 11
                mirror left_sleeve as right_sleeve
            layer trim:
                line left_opening shade width 0.6:
                    mid - 2, 4
                    mid, 8
                    mid, 13
                mirror left_opening as right_opening
                circle upper_button edge:
                    center mid, 9
                    radius 0.3
                circle lower_button edge:
                    center mid, 11
                    radius 0.3
            surface item:
                torso
                left_sleeve
                right_sleeve

