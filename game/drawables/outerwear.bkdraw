bakerrrr-drawable 1

drawable jacket context garment:
    paint fabric = fill
    paint trim = edge
    paint shadow = shade
    let top_y = shoulder_y
    let bottom_y = hip_y
    variant compact:
        layer body:
            rect body fabric:
                x mid - shoulder - 0.5
                y top_y
                w shoulder + shoulder + 1
                h bottom_y - top_y
            polygon left_sleeve fabric:
                mid - shoulder, top_y
                mid - shoulder - 0.75, top_y + 1
                left_hand_x - 0.25, hand_y - 0.25
                left_hand_x + 0.5, hand_y - 0.25
                mid - shoulder + 1, top_y + 1.5
            mirror left_sleeve as right_sleeve
        layer detail:
            line opening shadow width 0.45:
                mid, top_y
                mid, bottom_y
        surface garment:
            body
            left_sleeve
            right_sleeve
    variant detailed:
        layer body:
            rect body fabric:
                x mid - shoulder - 0.5
                y top_y
                w shoulder + shoulder + 1
                h bottom_y - top_y
                outline trim
                width 0.35
            polygon left_sleeve fabric outline trim width 0.3:
                mid - shoulder, top_y
                mid - shoulder - 0.25, top_y + 1
                left_hand_x - 0.25, hand_y - 0.25
                left_hand_x + 0.5, hand_y - 0.25
                mid - shoulder + 1, top_y + 1.5
            mirror left_sleeve as right_sleeve
        layer detail:
            line opening shadow width 0.3:
                mid, top_y
                mid, bottom_y
            line left_lapel trim width 0.3:
                mid - 2, top_y
                mid - 0.5, top_y + 2.5
                mid - 2, top_y + 4
            mirror left_lapel as right_lapel
        surface garment:
            body
            left_sleeve
            right_sleeve

    presentation ground:
        variant compact:
            layer body:
                polygon torso fill outline outline width 0.6:
                    mid - 3, 4
                    mid + 3, 4
                    mid + 3, 13
                    mid - 3, 13
                polygon left_sleeve fill outline outline width 0.6:
                    mid - 3, 5
                    mid - 5, 6
                    mid - 6, 12
                    mid - 4, 11
                mirror left_sleeve as right_sleeve
            layer trim:
                line opening shade width 0.6:
                    mid, 4
                    mid, 13
            surface item:
                torso
                left_sleeve
                right_sleeve

drawable windbreaker context garment:
    paint fabric = fill
    paint trim = edge
    paint shadow = shade
    let top_y = shoulder_y - 0.25
    let bottom_y = hip_y
    variant compact:
        layer body:
            polygon body fabric:
                mid - shoulder - 0.75, top_y
                mid + shoulder + 0.75, top_y
                mid + hip + 0.75, bottom_y
                mid - hip - 0.75, bottom_y
            polygon left_sleeve fabric:
                mid - shoulder, top_y
                mid - shoulder - 0.75, top_y + 1
                left_hand_x - 0.25, hand_y - 0.25
                left_hand_x + 0.5, hand_y - 0.25
                mid - shoulder + 1, top_y + 1.5
            mirror left_sleeve as right_sleeve
        layer detail:
            line zipper shadow width 0.4:
                mid, top_y
                mid, bottom_y
        surface garment:
            body
            left_sleeve
            right_sleeve
    variant detailed:
        layer body:
            polygon body fabric outline trim width 0.3:
                mid - shoulder - 0.75, top_y
                mid + shoulder + 0.75, top_y
                mid + hip + 0.75, bottom_y
                mid - hip - 0.75, bottom_y
            polygon left_sleeve fabric outline trim width 0.3:
                mid - shoulder, top_y
                mid - shoulder - 0.25, top_y + 1
                left_hand_x - 0.25, hand_y - 0.25
                left_hand_x + 0.5, hand_y - 0.25
                mid - shoulder + 1, top_y + 1.5
            mirror left_sleeve as right_sleeve
        layer detail:
            line zipper shadow width 0.25:
                mid, top_y
                mid, bottom_y
            line elastic_hem trim width 0.4:
                mid - hip - 1, bottom_y
                mid + hip + 1, bottom_y
            when detail has hooded:
                ellipse hood trim:
                    x mid - 2.5
                    y top_y - 2
                    w 5
                    h 3
        surface garment:
            body
            left_sleeve
            right_sleeve

    presentation ground:
        variant compact:
            layer hood:
                ellipse hood fill:
                    x mid - 2
                    y 2
                    w 4
                    h 4
                    outline outline
                    width 0.6
            layer body:
                polygon torso fill outline outline width 0.6:
                    mid - 3, 5
                    mid + 3, 5
                    mid + 4, 12
                    mid - 4, 12
                polygon left_sleeve fill outline outline width 0.6:
                    mid - 3, 6
                    mid - 5, 7
                    mid - 6, 12
                    mid - 4, 11
                mirror left_sleeve as right_sleeve
            layer trim:
                line zipper shade width 0.6:
                    mid, 5
                    mid, 12
                line elastic_hem edge width 0.5:
                    mid - 4, 12
                    mid + 4, 12
            surface item:
                hood
                torso
                left_sleeve
                right_sleeve

drawable coat context garment:
    paint fabric = fill
    paint trim = edge
    paint shadow = shade
    let top_y = shoulder_y - 0.25
    let bottom_y = foot_y - 2
    variant compact:
        layer body:
            polygon body fabric:
                mid - shoulder - 0.5, top_y
                mid + shoulder + 0.5, top_y
                mid + hip + 0.5, bottom_y
                mid - hip - 0.5, bottom_y
            polygon left_sleeve fabric:
                mid - shoulder, top_y
                mid - shoulder - 0.75, top_y + 1
                left_hand_x - 0.25, hand_y - 0.25
                left_hand_x + 0.5, hand_y - 0.25
                mid - shoulder + 1, top_y + 1.5
            mirror left_sleeve as right_sleeve
        layer detail:
