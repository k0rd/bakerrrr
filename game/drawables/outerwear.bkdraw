                x body_mid_x + body_unit * 1
                y shoulder_y + body_unit * 1
                w body_unit * 1.5
                h body_unit * 1
            line opening shadow width 0.25:
                body_mid_x, top_y
                body_mid_x, bottom_y
            line shoulder_yoke trim width 0.3:
                body_mid_x - shoulder_half, shoulder_y + body_unit * 1
                body_mid_x + shoulder_half, shoulder_y + body_unit * 1
