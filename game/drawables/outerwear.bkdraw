            polygon body fabric outline trim width 0.3:
                mid - shoulder, top_y + 1
                mid - 1.5, top_y
                mid, top_y + 2
                mid + 1.5, top_y
                mid + shoulder, top_y + 1
                mid + hip, bottom_y
                mid - hip, bottom_y
        layer detail:
            line safety_band trim width 0.75:
                mid - hip, hip_y - 2
                mid + hip, hip_y - 2
            rect left_pocket shadow:
                x mid - 3
                y hip_y - 1.75
                w 1.5
                h 1.25
            mirror left_pocket as right_pocket
        surface garment:
            body

    presentation ground:
        variant compact:
            layer body:
                polygon torso fill outline outline width 0.6:
                    mid - 3, 4
                    mid + 3, 4
                    mid + 3, 13
                    mid - 3, 13
            layer trim:
                line opening shade width 0.5:
                    mid, 4
                    mid, 13
                line reflective_band edge width 0.8:
                    mid - 3, 8
                    mid + 3, 8
                rect left_pocket edge:
                    x mid - 2.5
                    y 9
                    w 2
                    h 2
                mirror left_pocket as right_pocket
            surface item:
                torso

