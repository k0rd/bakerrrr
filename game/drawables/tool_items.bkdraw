bakerrrr-drawable 1

# Hand tools and field implements. Each silhouette exposes the working part of
# the tool so these remain readable as physical objects, not abstract inventory
# category badges.
drawable lockpick_kit context ground:
    paint pouch = fill
    paint metal = edge
    paint recess = shade

    variant compact:
        layer roll:
            rect open_pouch pouch:
                x 2
                y 8
                w 12
                h 5.5
