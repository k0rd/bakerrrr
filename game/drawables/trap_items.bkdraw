bakerrrr-drawable 1

# Deployed trap kits. Shared floor hardware remains visible, but payload and
# trigger geometry identify what the device will actually do.
drawable tear_gas_floor_trap context ground:
    paint plate = fill
    paint hardware = edge
    paint payload = shade

    variant compact:
        layer base:
            rect floor_plate plate:
                x 2.5
                y 9
                w 11
                h 4.5
                outline hardware
                width 0.45
        layer canisters:
            rect left_canister payload:
                x 3.75
                y 4.5
                w 3.25
                h 6
                outline hardware
                width 0.4
            rect right_canister payload:
                x 9
                y 4.5
                w 3.25
                h 6
                outline hardware
                width 0.4
            rect left_cap hardware:
                x 4.25
                y 3.5
                w 2.25
                h 1.5
            rect right_cap hardware:
                x 9.5
                y 3.5
                w 2.25
                h 1.5
        layer vents:
            line left_vent hardware width 0.4:
                4.5, 6
                6.25, 6
            line right_vent hardware width 0.4:
                9.75, 6
                11.5, 6
        surface item:
            floor_plate
            left_canister
            right_canister

    variant detailed:
        layer base:
            rect floor_plate plate:
                x 2.3
                y 8.8
                w 11.4
                h 4.8
                outline hardware
                width 0.3
        layer canisters:
            rect left_canister payload:
                x 3.55
                y 4.25
                w 3.4
                h 6.1
                outline hardware
                width 0.3
            rect right_canister payload:
                x 9.05
                y 4.25
                w 3.4
                h 6.1
                outline hardware
                width 0.3
            rect left_cap hardware:
                x 4
                y 3.15
                w 2.5
                h 1.6
            rect right_cap hardware:
                x 9.5
                y 3.15
                w 2.5
                h 1.6
        layer details:
            line left_vent_one hardware width 0.25:
                4.15, 5.65
                6.35, 5.65
            line left_vent_two hardware width 0.25:
                4.15, 6.75
                6.35, 6.75
            line right_vent_one hardware width 0.25:
                9.65, 5.65
                11.85, 5.65
            line right_vent_two hardware width 0.25:
                9.65, 6.75
                11.85, 6.75
            line trigger_wire hardware width 0.25:
                6.95, 8.3
                8, 7.4
                9.05, 8.3
            circle pressure_switch payload:
                center 8, 11.25
                radius 0.65
        surface item:
            floor_plate
            left_canister
            right_canister

drawable toxic_aerosol_floor_trap context ground:
    paint plate = fill
    paint hazard = edge
    paint toxin = shade

    variant compact:
        layer base:
            polygon floor_plate plate outline hazard width 0.45:
                2.5, 10
                13.5, 10
                12.5, 13.5
                3.5, 13.5
        layer payload:
            rect toxin_canister toxin:
                x 5
                y 4
                w 6
                h 7
                outline hazard
                width 0.4
            rect toxin_cap hazard:
                x 6.5
                y 2.75
                w 3
                h 1.75
            polygon hazard_mark plate outline hazard width 0.35:
                8, 5
                10, 9
                6, 9
            circle hazard_core hazard:
                center 8, 7.6
                radius 0.55
        surface item:
            floor_plate
            toxin_canister
            toxin_cap

    variant detailed:
        layer base:
            polygon floor_plate plate outline hazard width 0.3:
                2.25, 9.85
                13.75, 9.85
                12.65, 13.7
                3.35, 13.7
        layer payload:
            rect toxin_canister toxin:
                x 4.8
                y 3.8
                w 6.4
                h 7.1
                outline hazard
                width 0.3
            rect toxin_cap hazard:
                x 6.35
                y 2.5
                w 3.3
                h 1.8
            polygon hazard_mark plate outline hazard width 0.25:
                8, 4.75
                10.25, 9.1
                5.75, 9.1
            circle hazard_core hazard:
                center 8, 7.55
                radius 0.55
        layer details:
            line canister_seam hazard width 0.25:
                5.4, 5.1
                10.6, 5.1
            line trigger_lead hazard width 0.25:
                5, 10.5
                3.5, 11.5
            circle pressure_switch toxin:
                center 11.5, 11.65
                radius 0.7
        surface item:
            floor_plate
            toxin_canister
            toxin_cap

drawable dissociative_aerosol_floor_trap context ground:
