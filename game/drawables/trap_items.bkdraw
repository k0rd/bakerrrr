drawable tripline_alarm context ground:
    paint stakes = fill
    paint wire = edge
    paint alarm = shade

    variant compact:
        layer anchors:
            rect left_stake stakes:
                x 2
                y 4.5
                w 2
                h 9
                outline wire
                width 0.4
            rect right_stake stakes:
                x 12
                y 4.5
                w 2
                h 9
                outline wire
                width 0.4
            line trip_wire wire width 0.45:
                3.5, 7
                12.5, 7
        layer alarm:
            rect alarm_box alarm:
                x 6
                y 5.25
                w 4
                h 4
                outline wire
                width 0.4
            circle alarm_light wire:
                center 8, 7.25
                radius 0.65
        surface item:
            left_stake
            right_stake
            alarm_box

    variant detailed:
        layer anchors:
            polygon left_stake stakes outline wire width 0.3:
                1.8, 4.2
                4.1, 4.2
                3.65, 13.7
                2.25, 13.7
            polygon right_stake stakes outline wire width 0.3:
                11.9, 4.2
                14.2, 4.2
                13.75, 13.7
                12.35, 13.7
            line trip_wire wire width 0.3:
                3.6, 6.8
                12.4, 6.8
            line lower_wire wire width 0.25:
                3.45, 10.8
                12.55, 10.8
        layer alarm:
            rect alarm_box alarm:
                x 5.8
                y 5
                w 4.4
                h 4.3
                outline wire
                width 0.3
            circle alarm_light wire:
                center 8, 7.1
                radius 0.6
            line sensor_lead wire width 0.25:
                8, 9.3
                8, 10.8
        surface item:
            left_stake
            right_stake
            alarm_box

