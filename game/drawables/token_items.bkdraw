bakerrrr-drawable 1

# Passes, notes, vouchers, and keepsakes. These are small information-bearing
# objects, so their paper edge, binding, seal, punch, or hardware does most of
# the recognition work without requiring readable miniature text.
drawable credstick_chip context ground:
    paint substrate = fill
    paint contacts = edge
    paint circuit = shade

    variant compact:
        layer chip:
            polygon cred_chip substrate outline contacts width 0.45:
                2, 4
                12, 4
                14, 6
                14, 12
                4, 12
                2, 10
            rect contact_bank contacts:
                x 8
                y 5.5
                w 4.5
                h 5
            line contact_split_one circuit width 0.4:
                9.5, 5.5
                9.5, 10.5
            line contact_split_two circuit width 0.4:
                11, 5.5
                11, 10.5
            circle credit_node circuit:
                center 5, 8
                radius 1.25
        surface item:
            cred_chip

    variant detailed:
        layer chip:
            polygon cred_chip substrate outline contacts width 0.3:
                1.75, 3.75
                12.15, 3.75
                14.25, 5.85
                14.25, 12.25
                3.85, 12.25
                1.75, 10.15
            rect contact_bank contacts:
                x 7.8
                y 5.25
                w 4.75
                h 5.5
                outline circuit
                width 0.2
            line contact_split_one circuit width 0.25:
                9.35, 5.45
                9.35, 10.55
            line contact_split_two circuit width 0.25:
                10.95, 5.45
                10.95, 10.55
            circle credit_node circuit:
                center 4.8, 8
                radius 1.25
                outline contacts
                width 0.2
            line circuit_trace contacts width 0.25:
                5.9, 8
                7.8, 8
        surface item:
            cred_chip

