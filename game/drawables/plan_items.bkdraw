bakerrrr-drawable 1

# Mechanical plans share paper construction but preserve the mechanism drawn on
# them, so a dropped plan remains identifiable without opening inventory text.
drawable tripline_alarm_plan context ground:
    paint paper = fill
    paint ink = edge
    paint fold = shade

    variant compact:
        layer sheet:
            rect plan_sheet paper:
                x 2.5
                y 2.5
                w 11
                h 11
                outline ink
                width 0.45
            polygon folded_corner fold:
                10.5, 2.5
                13.5, 5.5
                10.5, 5.5
        layer diagram:
            line left_post ink width 0.45:
                4.5, 6
                4.5, 11.5
            line right_post ink width 0.45:
                11.5, 6
                11.5, 11.5
            line trip_wire ink width 0.45:
                4.5, 7.5
                11.5, 7.5
            rect alarm_symbol fold:
                x 6.5
                y 6.25
                w 3
                h 3
        surface item:
            plan_sheet
            folded_corner

    variant detailed:
        layer sheet:
            rect plan_sheet paper:
                x 2.3
                y 2.3
                w 11.4
                h 11.4
                outline ink
                width 0.3
            polygon folded_corner fold outline ink width 0.2:
                10.4, 2.3
                13.7, 5.6
                10.4, 5.6
        layer diagram:
            line left_post ink width 0.3:
                4.25, 5.8
                4.25, 11.75
            line right_post ink width 0.3:
                11.75, 5.8
                11.75, 11.75
            line trip_wire ink width 0.3:
                4.25, 7.25
                11.75, 7.25
            rect alarm_symbol fold:
                x 6.35
                y 5.95
                w 3.3
                h 3.3
                outline ink
                width 0.2
            circle sensor_dot ink:
                center 8, 7.6
                radius 0.45
            line dimension_line fold width 0.2:
                4.25, 12.4
                11.75, 12.4
        surface item:
            plan_sheet
            folded_corner

