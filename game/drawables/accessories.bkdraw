bakerrrr-drawable 2

# Worn geometry is derived from frozen body Points. Local coordinate Scalars
# are explicit; body_unit is a body-height measure, never a naked offset.
drawable earrings context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (head_center_x, head_y) = between(crown, chin, 0.5)
    let head_half = head_width / 2
    let left_ear_x = body_mid_x - head_half
    let ear_y = head_y
    paint metal = fill
    paint glint = edge
    variant compact:
        layer body:
            circle left_stud metal:
                center left_ear_x, ear_y
                radius body_unit * 0.55
            mirror left_stud as right_stud
        surface garment:
            left_stud
            right_stud
    variant detailed:
        layer body:
            circle left_stud metal:
                center left_ear_x, ear_y
                radius body_unit * 0.65
                outline glint
                width 0.2
            mirror left_stud as right_stud
            line left_drop metal width 0.3:
                left_ear_x, ear_y + body_unit * 0.5
                left_ear_x, ear_y + body_unit * 1.5
            mirror left_drop as right_drop
        surface garment:
            left_stud
            right_stud

drawable earpiece context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (head_center_x, head_y) = between(crown, chin, 0.5)
    let head_half = head_width / 2
    let right_ear_x = body_mid_x + head_half
    let ear_y = head_y
    paint shell = fill
    paint trim = edge
    variant compact:
        layer body:
            circle bud shell:
                center right_ear_x, ear_y
                radius body_unit * 0.65
            line wire trim width 0.4:
                right_ear_x, ear_y + body_unit * 0.5
                right_ear_x + body_unit * 0.25, ear_y + body_unit * 2
        surface garment:
            bud
    variant detailed:
        layer body:
            circle bud shell:
                center right_ear_x, ear_y
                radius body_unit * 0.7
                outline trim
                width 0.2
            line wire trim width 0.3:
                right_ear_x, ear_y + body_unit * 0.5
                right_ear_x + body_unit * 0.5, ear_y + body_unit * 1.5
                right_ear_x, ear_y + body_unit * 2.5
            circle mic shell:
                center right_ear_x, ear_y + body_unit * 2.5
                radius body_unit * 0.3
        surface garment:
            bud
            mic

drawable ring context garment:
    let body_unit = body_height / 14
    let (left_hand_x, hand_y) = between(wrist_inner_left, wrist_outer_left, 0.5)
    let (right_hand_x, right_hand_y) = between(wrist_inner_right, wrist_outer_right, 0.5)
    paint metal = fill
    paint glint = edge
    variant compact:
        layer body:
            circle band metal:
                center right_hand_x, right_hand_y
                radius body_unit * 0.22
        surface garment:
            band
    variant detailed:
        layer body:
            circle band metal:
                center right_hand_x, right_hand_y
                radius body_unit * 0.28
                outline glint
                width 0.12
            line stone_glint glint width 0.12:
                right_hand_x, right_hand_y - body_unit * 0.2
                right_hand_x + body_unit * 0.12, right_hand_y - body_unit * 0.2
        surface garment:
            band

drawable necklace context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (shoulder_anchor_x, shoulder_y) = shoulder_left
    paint metal = fill
    paint glint = edge
    variant compact:
        layer body:
            line chain metal width 0.45:
                body_mid_x - body_unit * 2, shoulder_y + body_unit * 0.5
                body_mid_x, shoulder_y + body_unit * 3
                body_mid_x + body_unit * 2, shoulder_y + body_unit * 0.5
            circle pendant metal:
                center body_mid_x, shoulder_y + body_unit * 3
                radius body_unit * 0.45
        surface garment:
            pendant
    variant detailed:
        layer body:
            line chain metal width 0.3:
                body_mid_x - body_unit * 2.25, shoulder_y + body_unit * 0.5
                body_mid_x, shoulder_y + body_unit * 3.25
                body_mid_x + body_unit * 2.25, shoulder_y + body_unit * 0.5
            circle pendant metal:
                center body_mid_x, shoulder_y + body_unit * 3.25
                radius body_unit * 0.6
                outline glint
                width 0.2
        surface garment:
            pendant

drawable scarf context garment:
    paint fabric = fill
    paint trim = edge
    point neck_center = between(neck_left, neck_right, 0.5)
    point waist_center = between(waist_left, waist_right, 0.5)
    point wrap_top = between(chin, neck_center, 0.7)
    let (neck_x, wrap_y) = wrap_top
    let wrap_width = neck_width * 2.5
    let wrap_height = y_distance(chin, waist_center) / 3
    point tail_end = between(waist_right, hip_right, 0.4)
    let (tail_x, tail_y) = tail_end
    point tail_left = neck_x, wrap_y + wrap_height / 2
    point tail_right = neck_x + neck_width * 0.8, wrap_y + wrap_height / 2
    point tail_tip = tail_x + neck_width / 4, tail_y
    point tail_inner = tail_x - neck_width / 2, tail_y - neck_width / 2
    point fold_top = between(tail_left, tail_right, 0.5)
    point fold_bottom = between(tail_inner, tail_tip, 0.5)
    variant compact:
        layer body:
            polygon tail fabric:
                tail_left
                tail_right
                tail_tip
                tail_inner
            ellipse wrap fabric:
                x neck_x - wrap_width / 2
                y wrap_y
                w wrap_width
                h wrap_height
        surface garment:
            wrap
            tail

    variant detailed:
        layer body:
            polygon tail fabric outline trim width 0.25:
                tail_left
                tail_right
                tail_tip
                tail_inner
            ellipse wrap fabric:
                x neck_x - wrap_width / 2
                y wrap_y
                w wrap_width
                h wrap_height
                outline trim
                width 0.25
        layer detail:
            line tail_fold trim width 0.2:
                between(fold_top, fold_bottom, 0.2)
                between(fold_top, fold_bottom, 0.85)
        surface garment:
            wrap
            tail

drawable bracelet context garment:
    let body_unit = body_height / 14
    let (left_hand_x, hand_y) = between(wrist_inner_left, wrist_outer_left, 0.5)
    let (right_hand_x, right_hand_y) = between(wrist_inner_right, wrist_outer_right, 0.5)
    paint metal = fill
    paint glint = edge
    variant compact:
        layer body:
            circle band metal:
                center right_hand_x, hand_y - body_unit * 0.5
                radius body_unit * 0.75
        surface garment:
            band
    variant detailed:
        layer body:
            circle band metal:
                center right_hand_x, hand_y - body_unit * 0.5
                radius body_unit * 0.9
                outline glint
                width 0.3
            circle clasp glint:
                center right_hand_x + body_unit * 0.5, hand_y - body_unit * 1
                radius body_unit * 0.2
        surface garment:
            band
            clasp

drawable gloves context garment:
    let body_unit = body_height / 14
    let (left_hand_x, hand_y) = between(wrist_inner_left, wrist_outer_left, 0.5)
    paint fabric = fill
    paint trim = edge
    variant compact:
        layer body:
            ellipse left_glove fabric:
                x left_hand_x - body_unit * 1
                y hand_y - body_unit * 1
                w body_unit * 2
                h body_unit * 2.5
            mirror left_glove as right_glove
        surface garment:
            left_glove
            right_glove
    variant detailed:
        layer body:
            polygon left_glove fabric outline trim width 0.25:
                left_hand_x - body_unit * 0.75, hand_y - body_unit * 1
                left_hand_x + body_unit * 1, hand_y - body_unit * 1
                left_hand_x + body_unit * 1, hand_y + body_unit * 1.5
                left_hand_x - body_unit * 0.5, hand_y + body_unit * 1.5
                left_hand_x - body_unit * 1, hand_y + body_unit * 0.5
            mirror left_glove as right_glove
        layer detail:
            line left_cuff trim width 0.3:
                left_hand_x - body_unit * 0.75, hand_y - body_unit * 1
                left_hand_x + body_unit * 1, hand_y - body_unit * 1
            mirror left_cuff as right_cuff
        surface garment:
            left_glove
            right_glove

drawable watch context garment:
    let body_unit = body_height / 14
    let (left_hand_x, hand_y) = between(wrist_inner_left, wrist_outer_left, 0.5)
    let (right_hand_x, right_hand_y) = between(wrist_inner_right, wrist_outer_right, 0.5)
    paint metal = fill
    paint glint = edge
    paint shadow = shade
    variant compact:
        layer body:
            rect face metal:
                x right_hand_x - body_unit * 0.75
                y hand_y - body_unit * 1.5
                w body_unit * 1.5
                h body_unit * 1.5
        surface garment:
            face
    variant detailed:
        layer body:
            rect face metal:
                x right_hand_x - body_unit * 0.875
                y hand_y - body_unit * 1.5
                w body_unit * 1.75
                h body_unit * 1.75
                outline glint
                width 0.25
            line strap shadow width 0.45:
                right_hand_x, hand_y - body_unit * 2.5
                right_hand_x, hand_y - body_unit * 1.5
                right_hand_x, hand_y + body_unit * 0.25
        surface garment:
            face
