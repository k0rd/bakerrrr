            clasp

drawable gloves context garment:
    paint fabric = fill
    paint trim = edge
    variant compact:
        layer body:
            ellipse left_glove fabric:
                x body_left - 3
                y hip_y - 1
                w 2
                h 2.5
            mirror left_glove as right_glove
        surface garment:
            left_glove
            right_glove
    variant detailed:
        layer body:
            polygon left_glove fabric outline trim width 0.25:
                body_left - 2.75, hip_y - 1
                body_left - 1, hip_y - 1
                body_left - 1, hip_y + 1.5
                body_left - 2.5, hip_y + 1.5
                body_left - 3, hip_y + 0.5
            mirror left_glove as right_glove
        layer detail:
            line left_cuff trim width 0.3:
                body_left - 2.75, hip_y - 1
                body_left - 1, hip_y - 1
            mirror left_cuff as right_cuff
        surface garment:
            left_glove
            right_glove

drawable watch context garment:
    paint metal = fill
    paint glint = edge
    paint shadow = shade
    variant compact:
        layer body:
            rect face metal:
                x body_right + 1
                y hip_y - 3
                w 1.5
                h 1.5
        surface garment:
            face
    variant detailed:
        layer body:
            rect face metal:
                x body_right + 1
                y hip_y - 3
                w 1.75
                h 1.75
                outline glint
                width 0.25
            line strap shadow width 0.45:
                body_right + 1.85, hip_y - 4
                body_right + 1.85, hip_y - 3
                body_right + 1.85, hip_y - 1.25
        surface garment:
            face
