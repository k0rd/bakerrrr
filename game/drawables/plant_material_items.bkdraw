                10.55, 5
                11.7, 8.25
                13.75, 9.35
                12.7, 13.2
                3.8, 13.2
            circle moss_tip_left tips:
                center 5.1, 9.15
                radius 0.75
            circle moss_tip_center tips:
                center 7.8, 8.6
                radius 0.65
            circle moss_tip_right tips:
                center 10.2, 10.15
                radius 0.85
        layer texture:
            line earth_line earth width 0.25:
                3.5, 11.7
                6.5, 12.4
                9.5, 11.8
                12.4, 12.3
        surface item:
            moss_clump

