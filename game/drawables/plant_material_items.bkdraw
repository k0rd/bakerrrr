drawable leaf_clippings context ground:
    paint leaves = fill
    paint veins = edge
    paint cuts = shade

    variant compact:
        layer leaves:
            ellipse leaf_left leaves:
                x 2.5
                y 5
                w 6
                h 3.5
                outline veins
                width 0.4
            ellipse leaf_right leaves:
                x 7.5
                y 4
                w 6
                h 3.5
                outline veins
                width 0.4
            ellipse leaf_lower leaves:
                x 5
                y 8.5
                w 6
                h 3.75
                outline veins
                width 0.4
        layer veins:
            line left_vein veins width 0.35:
                3.25, 7.5
                7.75, 5.75
            line right_vein veins width 0.35:
                8.25, 6.5
                12.75, 4.75
            line lower_vein veins width 0.35:
                5.8, 11.25
                10.2, 9.25
        surface item:
            leaf_left
            leaf_right
            leaf_lower

    variant detailed:
        layer leaves:
            ellipse leaf_left leaves:
                x 2.25
                y 4.8
                w 6.2
                h 3.6
                outline veins
                width 0.3
            ellipse leaf_right leaves:
                x 7.55
                y 3.8
                w 6.2
                h 3.6
                outline veins
                width 0.3
            ellipse leaf_lower leaves:
                x 4.85
                y 8.3
                w 6.3
                h 3.9
                outline veins
                width 0.3
            ellipse leaf_chip cuts:
                x 8.8
                y 7.1
                w 3.2
                h 2
        layer veins:
