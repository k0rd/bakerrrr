drawable seed_packet context ground:
    paint packet = fill
    paint seam = edge
    paint seeds = shade

    variant compact:
        layer envelope:
            polygon seed_envelope packet outline seam width 0.45:
                3, 4
                13, 4
                12.25, 13
                3.75, 13
            line packet_fold seam width 0.4:
                3.25, 5
                8, 8.25
                12.75, 5
        layer mark:
            circle seed_one seeds:
                center 6.5, 10.25
                radius 0.65
            circle seed_two seeds:
                center 8.25, 9.75
                radius 0.65
            circle seed_three seeds:
                center 9.75, 10.75
                radius 0.65
        surface item:
            seed_envelope

    variant detailed:
        layer envelope:
            polygon seed_envelope packet outline seam width 0.3:
                2.8, 3.75
                13.2, 3.75
                12.4, 13.25
                3.6, 13.25
            line packet_fold seam width 0.3:
                3.05, 4.8
                8, 8.2
                12.95, 4.8
        layer mark:
            circle seed_one seeds:
                center 5.75, 10.3
                radius 0.55
            circle seed_two seeds:
                center 7.25, 9.55
                radius 0.55
            circle seed_three seeds:
                center 8.75, 10.35
                radius 0.55
            circle seed_four seeds:
                center 10.25, 9.6
                radius 0.55
            line sprout_stem seam width 0.25:
                8, 8.1
                8, 6.4
            ellipse sprout_leaf seam:
                x 8
                y 5.5
                w 2
                h 1.2
        surface item:
            seed_envelope
