bakerrrr-drawable 1

# Harvested botanical materials retain their physical identity on the ground;
# ingredients should be distinguishable before the player opens a text panel.
drawable fresh_blossoms context ground:
    paint petals = fill
    paint stems = edge
    paint centers = shade

    variant compact:
        layer stems:
            line left_stem stems width 0.45:
                7, 13.5
                4.75, 6.5
            line center_stem stems width 0.45:
                8, 13.5
                8, 5
            line right_stem stems width 0.45:
                9, 13.5
                11.25, 6.5
        layer flowers:
            circle left_bloom petals:
                center 4.75, 5.25
                radius 1.7
            circle center_bloom petals:
                center 8, 3.5
                radius 1.7
            circle right_bloom petals:
                center 11.25, 5.25
                radius 1.7
            circle left_center centers:
                center 4.75, 5.25
                radius 0.55
            circle center_center centers:
                center 8, 3.5
                radius 0.55
            circle right_center centers:
                center 11.25, 5.25
                radius 0.55
        surface item:
            left_bloom
            center_bloom
            right_bloom

    variant detailed:
        layer stems:
            line left_stem stems width 0.3:
                7, 13.65
                4.6, 6.35
            line center_stem stems width 0.3:
                8, 13.65
                8, 4.8
            line right_stem stems width 0.3:
                9, 13.65
                11.4, 6.35
            line bouquet_tie centers width 0.45:
                6.4, 10.5
                9.6, 10.5
        layer flowers:
            circle left_bloom petals:
                center 4.6, 5.1
                radius 1.75
            circle center_bloom petals:
                center 8, 3.35
                radius 1.75
            circle right_bloom petals:
                center 11.4, 5.1
                radius 1.75
            circle left_center centers:
                center 4.6, 5.1
                radius 0.5
            circle center_center centers:
                center 8, 3.35
                radius 0.5
            circle right_center centers:
                center 11.4, 5.1
                radius 0.5
            ellipse left_leaf centers:
                x 5.4
                y 7.8
                w 2.4
                h 1.4
            ellipse right_leaf centers:
                x 8.2
                y 8.2
                w 2.4
                h 1.4
        surface item:
            left_bloom
            center_bloom
            right_bloom

drawable mushroom_caps context ground:
    paint caps = fill
    paint gills = edge
    paint stems = shade

    variant compact:
        layer stalks:
            rect left_stalk stems:
                x 4.25
                y 8
                w 2
                h 5
            rect center_stalk stems:
                x 7
                y 6
                w 2.25
                h 7
            rect right_stalk stems:
                x 10
                y 8.5
                w 1.75
                h 4.5
        layer caps:
            ellipse left_cap caps:
                x 2.5
                y 5.75
                w 5.5
                h 3.5
                outline gills
                width 0.4
            ellipse center_cap caps:
                x 5
                y 3.25
                w 6.25
                h 4
                outline gills
                width 0.4
            ellipse right_cap caps:
                x 8.5
                y 6.25
                w 5
                h 3.25
                outline gills
                width 0.4
        surface item:
            left_stalk
            center_stalk
            right_stalk
            left_cap
            center_cap
            right_cap

    variant detailed:
        layer stalks:
            polygon left_stalk stems:
                4.2, 7.8
                6.3, 7.8
                6.7, 13.2
                3.9, 13.2
            polygon center_stalk stems:
                6.85, 5.8
                9.25, 5.8
                9.65, 13.2
                6.55, 13.2
            polygon right_stalk stems:
                9.9, 8.25
                11.85, 8.25
                12.15, 13.2
                9.55, 13.2
        layer caps:
            ellipse left_cap caps:
                x 2.25
                y 5.5
                w 5.8
                h 3.6
                outline gills
                width 0.3
            ellipse center_cap caps:
                x 4.75
                y 3
                w 6.6
                h 4.1
                outline gills
                width 0.3
            ellipse right_cap caps:
                x 8.25
                y 6
                w 5.25
                h 3.35
                outline gills
                width 0.3
        layer gills:
            line center_gill gills width 0.25:
                5.75, 5.55
                10.4, 5.55
            circle cap_spot caps:
                center 8.2, 4.15
                radius 0.45
        surface item:
            left_stalk
            center_stalk
            right_stalk
            left_cap
            center_cap
            right_cap

