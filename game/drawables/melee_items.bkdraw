            strip tip_section steel:
                start 8.6, 7
                finish 13.6, 1.7
                width 0.85
                finish_width 0.65
                outline shadow
                outline_width 0.35
            circle tip_cap steel:
                center 13.6, 1.7
                radius 0.6
                outline shadow
                width 0.35
            strip middle_section body:
                start 6.1, 9.7
                finish 10.4, 5.1
                width 1.35
                finish_width 1.05
                outline shadow
                outline_width 0.35
            strip grip shadow:
                start 2.8, 13.5
                finish 6.7, 9.3
                width 2.4
                finish_width 2.1
                outline shadow
                outline_width 0.35
            line grip_rib steel width 0.5:
