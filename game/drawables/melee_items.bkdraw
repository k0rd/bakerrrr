# Rescue bar with a broad split fork and separate adze and pointed pick.
drawable halligan_bar context ground:
    paint body = fill
    paint steel = edge
    paint shadow = shade

    variant compact:
        layer silhouette:
            strip shaft body:
                start 3.5, 12.4
                finish 10.3, 4.6
                width 1.6
                finish_width 1.6
                outline shadow
                outline_width 0.35
            polygon fork steel outline shadow width 0.4:
                2.7, 11.3
                4.6, 12.6
                3.4, 14.2
                2.6, 14.1
                3.1, 13.1
                2.5, 12.7
                1.9, 13.7
                1.1, 13.1
            polygon adze body outline shadow width 0.4:
                9.7, 3.6
                10.7, 4.8
                8.5, 6.2
                6.9, 4.8
                6.6, 3.4
            polygon pick steel outline shadow width 0.4:
                9.5, 3.9
                10.7, 2.7
                14.2, 2
                12.2, 3.5
                10.6, 4.9
            line shaft_glint steel width 0.45:
                4.2, 11.1
                9.8, 4.7
            line adze_edge steel width 0.4:
                6.9, 3.6
                7.2, 4.6
                8.5, 5.8
        surface item:
            shaft
            fork
            adze
            pick

    variant detailed:
        layer silhouette:
            strip shaft body:
                start 3.5, 12.4
                finish 10.3, 4.6
                width 1.6
                finish_width 1.6
                outline shadow
                outline_width 0.35
            polygon fork steel outline shadow width 0.4:
                2.7, 11.3
                4.6, 12.6
                3.4, 14.2
                2.6, 14.1
                3.1, 13.1
                2.5, 12.7
                1.9, 13.7
                1.1, 13.1
            polygon adze body outline shadow width 0.4:
                9.7, 3.6
                10.7, 4.8
                8.5, 6.2
                6.9, 4.8
                6.6, 3.4
            polygon pick steel outline shadow width 0.4:
                9.5, 3.9
                10.7, 2.7
                14.2, 2
                12.2, 3.5
                10.6, 4.9
            line shaft_glint steel width 0.45:
