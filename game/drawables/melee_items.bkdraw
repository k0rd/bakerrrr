bakerrrr-drawable 2

# Melee item art extracted from the procedural knife, blade and club families.
# Ground art uses the shared 16-unit canvas. Both variants retain the same silhouette.

# Improvised narrow blade with an uneven cloth-wrapped grip.
drawable shiv_knife context ground:
    paint body = fill
    paint steel = edge
    paint shadow = shade

    variant compact:
        layer silhouette:
            polygon blade steel outline shadow width 0.4:
                5.1, 9.4
                6.4, 6.1
                12.7, 1.5
                10.3, 6.1
                6.9, 10.3
            polygon tape_grip body outline shadow width 0.4:
                2.4, 12.6
                5.7, 8.2
                7.4, 9.3
                4.1, 14.1
                2.5, 14
            line tape_wrap steel width 0.65:
                3.4, 11.7
                5.3, 12.6
            line grip_binding steel width 0.6:
                4.6, 10.1
                6.4, 10.9
        surface item:
            blade
            tape_grip

    variant detailed:
        layer silhouette:
            polygon blade steel outline shadow width 0.4:
                5.1, 9.4
                6.4, 6.1
                12.7, 1.5
                10.3, 6.1
                6.9, 10.3
            polygon tape_grip body outline shadow width 0.4:
                2.4, 12.6
                5.7, 8.2
                7.4, 9.3
                4.1, 14.1
                2.5, 14
            line tape_wrap steel width 0.65:
                3.4, 11.7
                5.3, 12.6
            line grip_binding steel width 0.6:
                4.6, 10.1
                6.4, 10.9
        layer detail:
            line ground_edge body width 0.25:
                6.7, 8.2
                10.2, 4.9
                12.7, 1.5
            line blade_score shadow width 0.25:
                7.1, 6.8
                8.9, 5.7
            line loose_tape steel width 0.3:
                2.8, 13.4
                4.1, 13.8
                5.3, 13.2
        surface item:
            blade
            tape_grip


# Heavy hooked bar; the bent claw and long shaft replace the generic club.
