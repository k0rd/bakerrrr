            ellipse rice_mound rice:
                x 3.1
                y 4.25
                w 9.8
                h 5.2
                outline rim
                width 0.3
            polygon bowl_body bowl outline rim width 0.3:
                3.35, 7.2
                12.65, 7.2
                10.35, 13.45
                5.65, 13.45
        layer details:
