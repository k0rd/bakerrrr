                y 3.8
                w 9.3
                h 2.5
                outline rim
                width 0.3
            ellipse noodle_surface cup:
                x 4.25
                y 4.35
                w 7.5
                h 1.25
        layer details:
            line cup_band noodles width 0.45:
                4.7, 8.2
                11.3, 8.2
            line noodle_line rim width 0.25:
                5.5, 4.95
                7, 4.55
