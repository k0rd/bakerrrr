bakerrrr-drawable 1

# Ground-primary food art. These definitions are intentionally item-specific;
# the broad procedural food families remain only as migration fallbacks.
drawable street_ration context ground:
    paint foil = fill
    paint seal = edge
    paint label = shade

    variant compact:
        layer packet:
            polygon ration_packet foil outline seal width 0.45:
                2, 5.5
                3, 4.5
                13, 4.5
                14, 5.5
                14, 10.5
                13, 11.5
                3, 11.5
                2, 10.5
            rect ration_label label:
                x 5
                y 6.25
                w 6
                h 3.5
        layer seals:
            line left_crimp seal width 0.5:
                3.25, 5
                3.25, 11
            line right_crimp seal width 0.5:
                12.75, 5
                12.75, 11
        surface item:
            ration_packet
            ration_label

    variant detailed:
        layer packet:
            polygon ration_packet foil outline seal width 0.3:
                1.75, 5.5
                2.75, 4.25
                13.25, 4.25
                14.25, 5.5
                14.25, 10.5
                13.25, 11.75
                2.75, 11.75
                1.75, 10.5
            rect ration_label label:
                x 4.75
                y 6
                w 6.5
                h 4
                outline seal
                width 0.25
        layer seals:
            line left_crimp seal width 0.35:
                2.7, 4.9
                2.7, 11.1
            line right_crimp seal width 0.35:
                13.3, 4.9
                13.3, 11.1
            line label_mark seal width 0.3:
                6, 8
                10, 8
            line foil_fold seal width 0.2:
                3.4, 5.15
                5.1, 5.15
        surface item:
            ration_packet
            ration_label

drawable protein_wrap context ground:
    paint tortilla = fill
    paint fold = edge
    paint filling = shade

    variant compact:
        layer food:
            polygon wrap tortilla outline fold width 0.45:
                2.5, 10.75
                4.75, 5.25
                8.25, 2.75
                11.5, 4.25
                13.5, 9.5
                10.25, 13
                5.5, 13.25
            polygon open_end filling outline fold width 0.35:
                8.25, 2.75
                11.5, 4.25
                10.75, 6.25
                7.25, 4.75
        layer fold:
            line wrapper_fold fold width 0.45:
                3.5, 9.5
                9.75, 12.5
        surface item:
            wrap
            open_end

    variant detailed:
        layer food:
            polygon wrap tortilla outline fold width 0.3:
                2.25, 10.8
                4.6, 5.1
                8.15, 2.5
                11.65, 4.1
                13.75, 9.55
                10.35, 13.25
                5.35, 13.5
            polygon open_end filling outline fold width 0.25:
                8.15, 2.5
                11.65, 4.1
                10.8, 6.4
                7.15, 4.8
            circle filling_piece fill:
                center 9.35, 4.15
                radius 0.65
        layer folds:
            line lower_fold fold width 0.3:
                3.25, 9.5
                9.8, 12.7
            line upper_fold fold width 0.25:
                4.55, 5.4
                8.2, 7.1
            line wrapper_seam fold width 0.2:
                6, 12.9
                11.9, 7
        surface item:
            wrap
            open_end
            filling_piece

drawable noodle_cup context ground:
    paint cup = fill
    paint rim = edge
    paint noodles = shade

    variant compact:
