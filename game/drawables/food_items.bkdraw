            ellipse rice_mound rice:
                x 3.25
                y 4.5
                w 9.5
                h 5
                outline rim
                width 0.4
            polygon bowl_body bowl outline rim width 0.45:
                3.5, 7.25
                12.5, 7.25
                10.25, 13.25
                5.75, 13.25
        layer utensil:
            line left_chopstick rim width 0.4:
                8.5, 7
                12.5, 2
            line right_chopstick rim width 0.4:
                9.5, 7.5
                13.5, 2.5
