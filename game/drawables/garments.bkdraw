bakerrrr-drawable 2

# Worn geometry is derived from frozen body Points. Local coordinate Scalars
# are explicit; body_unit is a body-height measure, never a naked offset.
drawable trousers context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (crotch_x, hip_y) = crotch
    let (left_toe_x, foot_y) = toe_tip_left
    let hip_half = hip_width / 2
    let waist_half = waist_width / 2
    let left_foot_x = left_toe_x + ankle_width_left
    paint fabric = fill
    paint trim = edge
    let waist_y = hip_y - body_unit * 1
    let ankle_y = foot_y - body_unit * 1
    variant compact:
        layer body:
            polygon left_leg fabric:
                body_mid_x - hip_half, waist_y
                body_mid_x, waist_y
                body_mid_x - body_unit * 1, ankle_y
                left_foot_x, ankle_y
            mirror left_leg as right_leg
        surface garment:
            left_leg
            right_leg
    variant detailed:
        layer body:
            polygon left_leg fabric outline trim width 0.3:
                body_mid_x - hip_half, waist_y
                body_mid_x, waist_y
                body_mid_x - body_unit * 0.75, ankle_y
                left_foot_x, ankle_y
            mirror left_leg as right_leg
        layer seam:
            line waist trim width 0.3:
                body_mid_x - hip_half, waist_y
                body_mid_x + hip_half, waist_y
            line left_crease trim width 0.2:
                body_mid_x - body_unit * 1.75, waist_y + body_unit * 1
                body_mid_x - body_unit * 1.75, ankle_y
            mirror left_crease as right_crease
        surface garment:
            left_leg
            right_leg

drawable shorts context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (crotch_x, hip_y) = crotch
    let hip_half = hip_width / 2
    paint fabric = fill
    paint trim = edge
    let waist_y = hip_y - body_unit * 1
    let hem_y = hip_y + body_unit * 2
    variant compact:
        layer body:
            polygon left_leg fabric:
                body_mid_x - hip_half, waist_y
                body_mid_x, waist_y
                body_mid_x - body_unit * 0.5, hem_y
                body_mid_x - hip_half, hem_y
            mirror left_leg as right_leg
        surface garment:
            left_leg
            right_leg
    variant detailed:
        layer body:
            polygon left_leg fabric outline trim width 0.3:
                body_mid_x - hip_half, waist_y
                body_mid_x, waist_y
                body_mid_x - body_unit * 0.6, hem_y
                body_mid_x - hip_half, hem_y
            mirror left_leg as right_leg
        layer seam:
            line waistband trim width 0.3:
                body_mid_x - hip_half, waist_y
                body_mid_x + hip_half, waist_y
            line center trim width 0.2:
                body_mid_x, waist_y
                body_mid_x, hem_y - body_unit * 0.5
        surface garment:
            left_leg
            right_leg

drawable skirt context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (crotch_x, hip_y) = crotch
    let (left_toe_x, foot_y) = toe_tip_left
    let hip_half = hip_width / 2
    paint fabric = fill
    paint trim = edge
    let waist_y = hip_y - body_unit * 1
    let hem_y = foot_y - body_unit * 2
    variant compact:
        layer body:
            polygon skirt_panel fabric:
                body_mid_x - hip_half, waist_y
                body_mid_x + hip_half, waist_y
                body_mid_x + hip_half + body_unit * 1, hem_y
                body_mid_x - hip_half - body_unit * 1, hem_y
        surface garment:
            skirt_panel
    variant detailed:
        layer body:
            polygon skirt_panel fabric outline trim width 0.3:
                body_mid_x - hip_half, waist_y
                body_mid_x + hip_half, waist_y
                body_mid_x + hip_half + body_unit * 1, hem_y
                body_mid_x - hip_half - body_unit * 1, hem_y
        layer detail:
            when detail has pleated:
                line left_pleat trim width 0.2:
                    body_mid_x - body_unit * 1.5, waist_y + body_unit * 0.5
                    body_mid_x - body_unit * 2, hem_y
                mirror left_pleat as right_pleat
            when detail has wrap:
                line wrap_seam trim width 0.25:
                    body_mid_x + body_unit * 1, waist_y
                    body_mid_x - body_unit * 1, hem_y
        surface garment:
            skirt_panel

drawable dress context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (shoulder_anchor_x, shoulder_y) = shoulder_left
    let (crotch_x, hip_y) = crotch
    let (left_toe_x, foot_y) = toe_tip_left
    let shoulder_half = upper_torso_width / 2
    let hip_half = hip_width / 2
    let waist_half = waist_width / 2
    paint fabric = fill
    paint trim = edge
    let top_y = shoulder_y
    let waist_y = hip_y - body_unit * 2
    let hem_y = foot_y - body_unit * 2
    variant compact:
        layer body:
            polygon dress_body fabric:
                body_mid_x - shoulder_half, top_y
                body_mid_x + shoulder_half, top_y
                body_mid_x + waist_half, waist_y
                body_mid_x + hip_half + body_unit * 1, hem_y
                body_mid_x - hip_half - body_unit * 1, hem_y
                body_mid_x - waist_half, waist_y
        surface garment:
            dress_body
    variant detailed:
        layer body:
            polygon dress_body fabric outline trim width 0.3:
                body_mid_x - shoulder_half, top_y
                body_mid_x - body_unit * 1, top_y
                body_mid_x, top_y + body_unit * 1
                body_mid_x + body_unit * 1, top_y
                body_mid_x + shoulder_half, top_y
                body_mid_x + waist_half, waist_y
                body_mid_x + hip_half + body_unit * 1.25, hem_y
                body_mid_x - hip_half - body_unit * 1.25, hem_y
                body_mid_x - waist_half, waist_y
        layer seam:
            line waist_seam trim width 0.25:
                body_mid_x - waist_half, waist_y
                body_mid_x + waist_half, waist_y
        surface garment:
            dress_body

drawable coverall context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (shoulder_anchor_x, shoulder_y) = shoulder_left
    let (crotch_x, hip_y) = crotch
    let (left_toe_x, foot_y) = toe_tip_left
    let shoulder_half = upper_torso_width / 2
    let hip_half = hip_width / 2
    paint fabric = fill
    paint trim = edge
    paint shadow = shade
    let top_y = shoulder_y
    let waist_y = hip_y - body_unit * 1
    let ankle_y = foot_y - body_unit * 1
    let sleeve_y = top_y + body_unit * 3
    variant compact:
        layer body:
            polygon torso fabric:
                body_mid_x - shoulder_half, top_y
                body_mid_x + shoulder_half, top_y
                body_mid_x + hip_half, waist_y
                body_mid_x - hip_half, waist_y
            polygon left_leg fabric:
                body_mid_x - hip_half, waist_y
                body_mid_x, waist_y
                body_mid_x - body_unit * 1, ankle_y
                body_mid_x - body_unit * 3, ankle_y
            mirror left_leg as right_leg
            polygon left_sleeve fabric:
                body_mid_x - shoulder_half, top_y
                body_mid_x - shoulder_half - body_unit * 1.5, top_y + body_unit * 1
                body_mid_x - shoulder_half - body_unit * 1, sleeve_y
                body_mid_x - shoulder_half + body_unit * 0.75, sleeve_y - body_unit * 0.5
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1
            mirror left_sleeve as right_sleeve
        layer detail:
            line zip shadow width 0.4:
                body_mid_x, top_y
                body_mid_x, waist_y
        surface garment:
            torso
            left_leg
            right_leg
            left_sleeve
            right_sleeve
    variant detailed:
        layer body:
            polygon torso fabric outline trim width 0.3:
                body_mid_x - shoulder_half, top_y
                body_mid_x + shoulder_half, top_y
                body_mid_x + hip_half, waist_y
                body_mid_x - hip_half, waist_y
            polygon left_leg fabric outline trim width 0.3:
                body_mid_x - hip_half, waist_y
                body_mid_x, waist_y
                body_mid_x - body_unit * 0.8, ankle_y
                body_mid_x - body_unit * 3, ankle_y
            mirror left_leg as right_leg
            polygon left_sleeve fabric outline trim width 0.3:
                body_mid_x - shoulder_half, top_y
                body_mid_x - shoulder_half - body_unit * 1.5, top_y + body_unit * 1
                body_mid_x - shoulder_half - body_unit * 1, sleeve_y
                body_mid_x - shoulder_half + body_unit * 0.75, sleeve_y - body_unit * 0.5
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1
            mirror left_sleeve as right_sleeve
        layer detail:
            line zip shadow width 0.25:
                body_mid_x, top_y + body_unit * 0.5
                body_mid_x, waist_y
            rect left_pocket trim:
                x body_mid_x - body_unit * 3
                y hip_y - body_unit * 3
                w body_unit * 1.5
                h body_unit * 1.25
            mirror left_pocket as right_pocket
        surface garment:
            torso
            left_leg
            right_leg
            left_sleeve
            right_sleeve

drawable jumpsuit context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (shoulder_anchor_x, shoulder_y) = shoulder_left
    let (crotch_x, hip_y) = crotch
    let (left_toe_x, foot_y) = toe_tip_left
    let shoulder_half = upper_torso_width / 2
    let hip_half = hip_width / 2
    paint fabric = fill
    paint trim = edge
    let top_y = shoulder_y
    let waist_y = hip_y - body_unit * 1
    let ankle_y = foot_y - body_unit * 1
    let sleeve_y = top_y + body_unit * 3
    variant compact:
        layer body:
            polygon torso fabric:
                body_mid_x - shoulder_half, top_y
                body_mid_x + shoulder_half, top_y
                body_mid_x + hip_half, waist_y
                body_mid_x - hip_half, waist_y
            polygon left_leg fabric:
                body_mid_x - hip_half, waist_y
                body_mid_x, waist_y
                body_mid_x - body_unit * 0.5, ankle_y
                body_mid_x - body_unit * 2.5, ankle_y
            mirror left_leg as right_leg
            polygon left_sleeve fabric:
                body_mid_x - shoulder_half, top_y
                body_mid_x - shoulder_half - body_unit * 1.5, top_y + body_unit * 1
                body_mid_x - shoulder_half - body_unit * 1, sleeve_y
                body_mid_x - shoulder_half + body_unit * 0.75, sleeve_y - body_unit * 0.5
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1
            mirror left_sleeve as right_sleeve
        surface garment:
            torso
            left_leg
            right_leg
            left_sleeve
            right_sleeve
    variant detailed:
        layer body:
            polygon torso fabric outline trim width 0.3:
                body_mid_x - shoulder_half, top_y
                body_mid_x - body_unit * 1, top_y
                body_mid_x, top_y + body_unit * 1
                body_mid_x + body_unit * 1, top_y
                body_mid_x + shoulder_half, top_y
                body_mid_x + hip_half, waist_y
                body_mid_x - hip_half, waist_y
            polygon left_leg fabric outline trim width 0.3:
                body_mid_x - hip_half, waist_y
                body_mid_x, waist_y
                body_mid_x - body_unit * 0.5, ankle_y
                body_mid_x - body_unit * 2.5, ankle_y
            mirror left_leg as right_leg
            polygon left_sleeve fabric outline trim width 0.3:
                body_mid_x - shoulder_half, top_y
                body_mid_x - shoulder_half - body_unit * 1.5, top_y + body_unit * 1
                body_mid_x - shoulder_half - body_unit * 1, sleeve_y
                body_mid_x - shoulder_half + body_unit * 0.75, sleeve_y - body_unit * 0.5
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1
            mirror left_sleeve as right_sleeve
        layer detail:
            line front_seam trim width 0.25:
                body_mid_x, top_y + body_unit * 1
                body_mid_x, waist_y
            line waistband trim width 0.25:
                body_mid_x - hip_half, waist_y
                body_mid_x + hip_half, waist_y
        surface garment:
            torso
            left_leg
            right_leg
            left_sleeve
            right_sleeve
