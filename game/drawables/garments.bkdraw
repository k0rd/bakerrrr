bakerrrr-drawable 1

drawable trousers context garment:
    paint fabric = fill
    paint trim = edge
    let waist_y = hip_y - 1
    let ankle_y = foot_y - 1
    variant compact:
        layer body:
            polygon left_leg fabric:
                mid - hip, waist_y
                mid, waist_y
                mid - 1, ankle_y
                mid - 3, ankle_y
            mirror left_leg as right_leg
        surface garment:
            left_leg
            right_leg
    variant detailed:
        layer body:
            polygon left_leg fabric outline trim width 0.3:
                mid - hip, waist_y
                mid, waist_y
                mid - 0.75, ankle_y
                mid - 3, ankle_y
            mirror left_leg as right_leg
        layer seam:
            line waist trim width 0.3:
                mid - hip, waist_y
                mid + hip, waist_y
            line left_crease trim width 0.2:
                mid - 1.75, waist_y + 1
                mid - 1.75, ankle_y
            mirror left_crease as right_crease
        surface garment:
            left_leg
            right_leg

drawable shorts context garment:
    paint fabric = fill
    paint trim = edge
    let waist_y = hip_y - 1
    let hem_y = hip_y + 2
    variant compact:
        layer body:
            polygon left_leg fabric:
                mid - hip, waist_y
                mid, waist_y
                mid - 0.5, hem_y
                mid - hip, hem_y
            mirror left_leg as right_leg
        surface garment:
            left_leg
            right_leg
    variant detailed:
        layer body:
            polygon left_leg fabric outline trim width 0.3:
                mid - hip, waist_y
                mid, waist_y
                mid - 0.6, hem_y
                mid - hip, hem_y
            mirror left_leg as right_leg
        layer seam:
            line waistband trim width 0.3:
                mid - hip, waist_y
                mid + hip, waist_y
            line center trim width 0.2:
                mid, waist_y
                mid, hem_y - 0.5
        surface garment:
            left_leg
            right_leg

drawable skirt context garment:
    paint fabric = fill
    paint trim = edge
    let waist_y = hip_y - 1
    let hem_y = foot_y - 2
    variant compact:
        layer body:
            polygon skirt_panel fabric:
                mid - hip, waist_y
                mid + hip, waist_y
                mid + hip + 1, hem_y
                mid - hip - 1, hem_y
        surface garment:
            skirt_panel
    variant detailed:
        layer body:
            polygon skirt_panel fabric outline trim width 0.3:
                mid - hip, waist_y
                mid + hip, waist_y
                mid + hip + 1, hem_y
                mid - hip - 1, hem_y
        layer detail:
            when detail has pleated:
                line left_pleat trim width 0.2:
                    mid - 1.5, waist_y + 0.5
                    mid - 2, hem_y
                mirror left_pleat as right_pleat
            when detail has wrap:
                line wrap_seam trim width 0.25:
                    mid + 1, waist_y
                    mid - 1, hem_y
        surface garment:
            skirt_panel

drawable dress context garment:
    paint fabric = fill
    paint trim = edge
    let top_y = shoulder_y
    let waist_y = hip_y - 2
    let hem_y = foot_y - 2
    variant compact:
        layer body:
            polygon dress_body fabric:
                mid - shoulder, top_y
                mid + shoulder, top_y
                mid + waist, waist_y
                mid + hip + 1, hem_y
                mid - hip - 1, hem_y
                mid - waist, waist_y
        surface garment:
            dress_body
    variant detailed:
        layer body:
            polygon dress_body fabric outline trim width 0.3:
                mid - shoulder, top_y
                mid - 1, top_y
                mid, top_y + 1
                mid + 1, top_y
                mid + shoulder, top_y
                mid + waist, waist_y
                mid + hip + 1.25, hem_y
                mid - hip - 1.25, hem_y
                mid - waist, waist_y
        layer seam:
            line waist_seam trim width 0.25:
                mid - waist, waist_y
                mid + waist, waist_y
        surface garment:
            dress_body

drawable coverall context garment:
    paint fabric = fill
    paint trim = edge
    paint shadow = shade
    let top_y = shoulder_y
    let waist_y = hip_y - 1
    let ankle_y = foot_y - 1
    variant compact:
        layer body:
            polygon torso fabric:
                mid - shoulder, top_y
                mid + shoulder, top_y
                mid + hip, waist_y
                mid - hip, waist_y
            polygon left_leg fabric:
                mid - hip, waist_y
                mid, waist_y
                mid - 1, ankle_y
                mid - 3, ankle_y
            mirror left_leg as right_leg
        layer detail:
            line zip shadow width 0.4:
                mid, top_y
                mid, waist_y
        surface garment:
            torso
            left_leg
            right_leg
    variant detailed:
        layer body:
            polygon torso fabric outline trim width 0.3:
                mid - shoulder, top_y
                mid + shoulder, top_y
                mid + hip, waist_y
                mid - hip, waist_y
            polygon left_leg fabric outline trim width 0.3:
                mid - hip, waist_y
                mid, waist_y
                mid - 0.8, ankle_y
                mid - 3, ankle_y
            mirror left_leg as right_leg
        layer detail:
            line zip shadow width 0.25:
                mid, top_y + 0.5
                mid, waist_y
            rect left_pocket trim:
                x mid - 3
                y hip_y - 3
                w 1.5
                h 1.25
            mirror left_pocket as right_pocket
        surface garment:
            torso
            left_leg
            right_leg

drawable jumpsuit context garment:
    paint fabric = fill
    paint trim = edge
    let top_y = shoulder_y
    let waist_y = hip_y - 1
    let ankle_y = foot_y - 1
    variant compact:
        layer body:
            polygon body fabric:
                mid - shoulder, top_y
                mid + shoulder, top_y
                mid + hip, waist_y
                mid + 2.5, ankle_y
                mid + 0.5, ankle_y
                mid, waist_y + 1
                mid - 0.5, ankle_y
                mid - 2.5, ankle_y
                mid - hip, waist_y
        surface garment:
            body
    variant detailed:
        layer body:
            polygon body fabric outline trim width 0.3:
                mid - shoulder, top_y
                mid - 1, top_y
                mid, top_y + 1
                mid + 1, top_y
                mid + shoulder, top_y
                mid + hip, waist_y
                mid + 2.5, ankle_y
                mid + 0.5, ankle_y
                mid, waist_y + 1
                mid - 0.5, ankle_y
                mid - 2.5, ankle_y
                mid - hip, waist_y
        layer detail:
            line front_seam trim width 0.25:
                mid, top_y + 1
                mid, waist_y
            line waistband trim width 0.25:
                mid - hip, waist_y
                mid + hip, waist_y
        surface garment:
            body
