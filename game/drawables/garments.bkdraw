bakerrrr-drawable 2

# Worn geometry is derived from frozen body Points. Local coordinate Scalars
# are explicit; body_unit is a body-height measure, never a naked offset.
drawable trousers context garment:
    paint fabric = fill
    paint trim = edge
    point waist_center = between(waist_left, waist_right, 0.5)
    # Follow the bent legs; ease comes from each limb's own width.
    point knee_in = between(knee_outer_left, knee_inner_left, 1.2)
    point knee_out = between(knee_inner_left, knee_outer_left, 1.2)
    point ankle_inner_eased = between(ankle_outer_left, ankle_inner_left, 1.3)
    point ankle_outer_eased = between(ankle_inner_left, ankle_outer_left, 1.3)
    let (ankle_in_x, ankle_in_y) = ankle_inner_eased
    let (ankle_out_x, ankle_out_y) = ankle_outer_eased
    let (toe_x, toe_y) = toe_tip_left
    let cuff_y = toe_y - ankle_width_left / 8
    point ankle_in = ankle_in_x, cuff_y
    point ankle_out = ankle_out_x, cuff_y
    point crease_top = between(thigh_inner_left, thigh_outer_left, 0.5)
    point crease_knee = between(knee_inner_left, knee_outer_left, 0.5)
    point crease_bottom = between(ankle_inner_left, ankle_outer_left, 0.5)
    variant compact:
        layer body:
            polygon left_leg fabric:
                waist_left
                waist_center
                crotch
                thigh_inner_left
                knee_in
                ankle_in
                ankle_out
                knee_out
                thigh_outer_left
                hip_left
            mirror left_leg as right_leg
        surface garment:
            left_leg
            right_leg

    variant detailed:
        layer body:
            polygon left_leg fabric outline trim width 0.25:
                waist_left
                waist_center
                crotch
                thigh_inner_left
                knee_in
                ankle_in
                ankle_out
                knee_out
                thigh_outer_left
                hip_left
            mirror left_leg as right_leg
        layer seam:
            line waist trim width 0.2:
                waist_left
                waist_right
            line left_crease trim width 0.2:
                crease_top
                crease_knee
                crease_bottom
            mirror left_crease as right_crease
        surface garment:
            left_leg
            right_leg

drawable shorts context garment:
    paint fabric = fill
    paint trim = edge
    point waist_center = between(waist_left, waist_right, 0.5)
    point hem_inner = between(thigh_inner_left, knee_inner_left, 0.45)
    point hem_outer = between(thigh_outer_left, knee_outer_left, 0.45)
    point cuff_inner = between(hem_outer, hem_inner, 1.2)
    point cuff_outer = between(hem_inner, hem_outer, 1.2)
    variant compact:
        layer body:
            polygon left_leg fabric:
                waist_left
                waist_center
                crotch
                cuff_inner
                cuff_outer
                hip_left
            mirror left_leg as right_leg
        surface garment:
            left_leg
            right_leg

    variant detailed:
        layer body:
            polygon left_leg fabric outline trim width 0.25:
                waist_left
                waist_center
                crotch
                cuff_inner
                cuff_outer
                hip_left
            mirror left_leg as right_leg
        layer seam:
            line waistband trim width 0.2:
                waist_left
                waist_right
            line center trim width 0.2:
                waist_center
                crotch
        surface garment:
            left_leg
            right_leg

drawable skirt context garment:
    paint fabric = fill
    paint trim = edge
    point waist_center = between(waist_left, waist_right, 0.5)
    let (body_mid_x, waist_y) = waist_center
    let (hip_left_x, hip_left_y) = hip_left
    let (hip_right_x, hip_right_y) = hip_right
    point hem_center = between(crotch, ground, 0.4)
    let (hem_mid_x, hem_y) = hem_center
    point hem_left = hip_left_x - hip_width / 8, hem_y
    point hem_right = hip_right_x + hip_width / 8, hem_y
    variant compact:
        layer body:
            polygon skirt_panel fabric:
                waist_left
                waist_right
                hip_right
                hem_right
                hem_left
                hip_left
        layer detail:
            when detail has pleated:
                line left_pleat trim width 0.2:
                    between(waist_left, waist_center, 0.4)
                    between(hem_left, hem_center, 0.4)
                mirror left_pleat as right_pleat
            when detail has wrap:
                line wrap_seam trim width 0.25:
                    between(waist_center, waist_right, 0.5)
                    between(hem_left, hem_center, 0.6)
        surface garment:
            skirt_panel

    variant detailed:
        layer body:
            polygon skirt_panel fabric outline trim width 0.25:
                waist_left
                waist_right
                hip_right
                hem_right
                hem_left
                hip_left
        layer seam:
            line waistband trim width 0.2:
                waist_left
                waist_right
        layer detail:
            when detail has pleated:
                line left_pleat trim width 0.2:
                    between(waist_left, waist_center, 0.4)
                    between(hem_left, hem_center, 0.4)
                mirror left_pleat as right_pleat
            when detail has wrap:
                line wrap_seam trim width 0.25:
                    between(waist_center, waist_right, 0.5)
                    between(hem_left, hem_center, 0.6)
        surface garment:
            skirt_panel

drawable dress context garment:
    paint fabric = fill
    paint trim = edge
    point waist_center = between(waist_left, waist_right, 0.5)
    let (body_mid_x, waist_y) = waist_center
    let (hip_left_x, hip_left_y) = hip_left
    let (hip_right_x, hip_right_y) = hip_right
    point hem_center = between(crotch, ground, 0.4)
    let (hem_mid_x, hem_y) = hem_center
    point hem_left = hip_left_x - hip_width / 8, hem_y
    point hem_right = hip_right_x + hip_width / 8, hem_y
    point neck_center = between(neck_left, neck_right, 0.5)
    point neckline = between(neck_center, waist_center, 0.2)
    variant compact:
        layer body:
            polygon dress_body fabric:
                shoulder_left
                neckline
                shoulder_right
                armpit_right
                waist_right
                hip_right
                hem_right
                hem_left
                hip_left
                waist_left
                armpit_left
        surface garment:
            dress_body

    variant detailed:
        layer body:
            polygon dress_body fabric outline trim width 0.25:
                shoulder_left
                neckline
                shoulder_right
                armpit_right
                waist_right
                hip_right
                hem_right
                hem_left
                hip_left
                waist_left
                armpit_left
        layer seam:
            line waist_seam trim width 0.2:
                waist_left
                waist_right
        surface garment:
            dress_body

drawable coverall context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (shoulder_anchor_x, shoulder_y) = shoulder_left
    let (crotch_x, hip_y) = crotch
    let (left_toe_x, foot_y) = toe_tip_left
    let shoulder_half = upper_torso_width / 2
    let hip_half = hip_width / 2
    paint fabric = fill
    paint trim = edge
    paint shadow = shade
    let top_y = shoulder_y
    let waist_y = hip_y - body_unit * 1
    let ankle_y = foot_y - body_unit * 1
    let sleeve_y = top_y + body_unit * 3
    variant compact:
        layer body:
            polygon torso fabric:
                body_mid_x - shoulder_half, top_y
                body_mid_x + shoulder_half, top_y
                body_mid_x + hip_half, waist_y
                body_mid_x - hip_half, waist_y
            polygon left_leg fabric:
                body_mid_x - hip_half, waist_y
                body_mid_x, waist_y
                body_mid_x - body_unit * 1, ankle_y
                body_mid_x - body_unit * 3, ankle_y
            mirror left_leg as right_leg
            polygon left_sleeve fabric:
                body_mid_x - shoulder_half, top_y
                body_mid_x - shoulder_half - body_unit * 1.5, top_y + body_unit * 1
                body_mid_x - shoulder_half - body_unit * 1, sleeve_y
                body_mid_x - shoulder_half + body_unit * 0.75, sleeve_y - body_unit * 0.5
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1
            mirror left_sleeve as right_sleeve
        layer detail:
            line zip shadow width 0.4:
                body_mid_x, top_y
                body_mid_x, waist_y
        surface garment:
            torso
            left_leg
            right_leg
            left_sleeve
            right_sleeve
    variant detailed:
        layer body:
            polygon torso fabric outline trim width 0.3:
                body_mid_x - shoulder_half, top_y
                body_mid_x + shoulder_half, top_y
                body_mid_x + hip_half, waist_y
                body_mid_x - hip_half, waist_y
            polygon left_leg fabric outline trim width 0.3:
                body_mid_x - hip_half, waist_y
                body_mid_x, waist_y
                body_mid_x - body_unit * 0.8, ankle_y
                body_mid_x - body_unit * 3, ankle_y
            mirror left_leg as right_leg
            polygon left_sleeve fabric outline trim width 0.3:
                body_mid_x - shoulder_half, top_y
                body_mid_x - shoulder_half - body_unit * 1.5, top_y + body_unit * 1
                body_mid_x - shoulder_half - body_unit * 1, sleeve_y
                body_mid_x - shoulder_half + body_unit * 0.75, sleeve_y - body_unit * 0.5
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1
            mirror left_sleeve as right_sleeve
        layer detail:
            line zip shadow width 0.25:
                body_mid_x, top_y + body_unit * 0.5
                body_mid_x, waist_y
            rect left_pocket trim:
                x body_mid_x - body_unit * 3
                y hip_y - body_unit * 3
                w body_unit * 1.5
                h body_unit * 1.25
            mirror left_pocket as right_pocket
        surface garment:
            torso
            left_leg
            right_leg
            left_sleeve
            right_sleeve

drawable jumpsuit context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (shoulder_anchor_x, shoulder_y) = shoulder_left
    let (crotch_x, hip_y) = crotch
    let (left_toe_x, foot_y) = toe_tip_left
    let shoulder_half = upper_torso_width / 2
    let hip_half = hip_width / 2
    paint fabric = fill
    paint trim = edge
    let top_y = shoulder_y
    let waist_y = hip_y - body_unit * 1
    let ankle_y = foot_y - body_unit * 1
    let sleeve_y = top_y + body_unit * 3
    variant compact:
        layer body:
            polygon torso fabric:
                body_mid_x - shoulder_half, top_y
                body_mid_x + shoulder_half, top_y
                body_mid_x + hip_half, waist_y
                body_mid_x - hip_half, waist_y
            polygon left_leg fabric:
                body_mid_x - hip_half, waist_y
                body_mid_x, waist_y
                body_mid_x - body_unit * 0.5, ankle_y
                body_mid_x - body_unit * 2.5, ankle_y
            mirror left_leg as right_leg
            polygon left_sleeve fabric:
                body_mid_x - shoulder_half, top_y
                body_mid_x - shoulder_half - body_unit * 1.5, top_y + body_unit * 1
                body_mid_x - shoulder_half - body_unit * 1, sleeve_y
                body_mid_x - shoulder_half + body_unit * 0.75, sleeve_y - body_unit * 0.5
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1
            mirror left_sleeve as right_sleeve
        surface garment:
            torso
            left_leg
            right_leg
            left_sleeve
            right_sleeve
    variant detailed:
        layer body:
            polygon torso fabric outline trim width 0.3:
                body_mid_x - shoulder_half, top_y
                body_mid_x - body_unit * 1, top_y
                body_mid_x, top_y + body_unit * 1
                body_mid_x + body_unit * 1, top_y
                body_mid_x + shoulder_half, top_y
                body_mid_x + hip_half, waist_y
                body_mid_x - hip_half, waist_y
            polygon left_leg fabric outline trim width 0.3:
                body_mid_x - hip_half, waist_y
                body_mid_x, waist_y
                body_mid_x - body_unit * 0.5, ankle_y
                body_mid_x - body_unit * 2.5, ankle_y
            mirror left_leg as right_leg
            polygon left_sleeve fabric outline trim width 0.3:
                body_mid_x - shoulder_half, top_y
                body_mid_x - shoulder_half - body_unit * 1.5, top_y + body_unit * 1
                body_mid_x - shoulder_half - body_unit * 1, sleeve_y
                body_mid_x - shoulder_half + body_unit * 0.75, sleeve_y - body_unit * 0.5
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1
            mirror left_sleeve as right_sleeve
        layer detail:
            line front_seam trim width 0.25:
                body_mid_x, top_y + body_unit * 1
                body_mid_x, waist_y
            line waistband trim width 0.25:
                body_mid_x - hip_half, waist_y
                body_mid_x + hip_half, waist_y
        surface garment:
            torso
            left_leg
            right_leg
            left_sleeve
            right_sleeve
