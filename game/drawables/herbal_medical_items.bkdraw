bakerrrr-drawable 1

# Herbal medicines keep their physical preparation visible: wrapped poultices,
# droppers, tonics, field flasks, and draught bottles. Diluted batches retain the
# family silhouette but expose loose wrapping or visibly low liquid levels.
drawable herbal_poultice context ground:
    paint cloth = fill
    paint binding = edge
    paint herbs = shade

    variant compact:
        layer bundle:
            polygon wrapped_bundle cloth outline binding width 0.45:
                3, 6
                6, 3.5
                12.5, 5
                13, 11.5
                9.5, 13.5
                3, 11.5
            polygon leaf herbs outline binding width 0.3:
                5, 6
                7.5, 2
                9, 6
                7, 8.5
            line leaf_vein binding width 0.4:
                7.5, 3
                7, 7.5
            line bundle_tie binding width 0.75:
                8, 5
                8, 13
        surface item:
            wrapped_bundle
            leaf

    variant detailed:
        layer bundle:
            polygon wrapped_bundle cloth outline binding width 0.3:
                2.75, 5.8
                5.8, 3.25
                12.75, 4.8
                13.25, 11.7
                9.55, 13.75
                2.75, 11.7
            polygon leaf herbs outline binding width 0.2:
                4.8, 5.8
                7.45, 1.75
                9.15, 5.9
                6.9, 8.65
            line leaf_vein binding width 0.25:
                7.45, 2.75
                6.95, 7.85
            line side_vein_one binding width 0.2:
                7.25, 4.4
                5.9, 4.9
            line side_vein_two binding width 0.2:
                7.1, 5.9
                8.2, 5.4
            line bundle_tie binding width 0.5:
                8, 4.8
                8, 13.2
            circle tie_knot binding:
                center 8, 9
                radius 0.55
        surface item:
            wrapped_bundle
            leaf

