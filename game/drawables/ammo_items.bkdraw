bakerrrr-drawable 1

# Ammunition packages. Caliber and capacity are communicated through carrier,
# cartridge, magazine, and ordnance geometry rather than color coding.
drawable light_ammo_box context ground:
    paint carton = fill
    paint brass = edge
    paint recess = shade

    variant compact:
        layer box:
            rect ammo_carton carton:
                x 2
                y 6
                w 12
                h 7.5
                outline brass
                width 0.45
            polygon open_lid recess outline brass width 0.4:
                2, 6
                4, 3
                14, 3
                14, 6
        layer rounds:
            line round_one brass width 1.1:
                4.5, 6
                4.5, 10.5
            line round_two brass width 1.1:
                7, 6
                7, 10.5
            line round_three brass width 1.1:
                9.5, 6
                9.5, 10.5
            line round_four brass width 1.1:
                12, 6
                12, 10.5
        surface item:
            ammo_carton
            open_lid

    variant detailed:
        layer box:
            rect ammo_carton carton:
                x 1.8
                y 5.85
                w 12.4
                h 7.8
                outline brass
                width 0.3
            polygon open_lid recess outline brass width 0.3:
                1.8, 5.85
                3.9, 2.75
                14.2, 2.75
                14.2, 5.85
        layer rounds:
            line round_one brass width 0.8:
                3.8, 5.9
                3.8, 10.7
            line round_two brass width 0.8:
                5.9, 5.9
                5.9, 10.7
