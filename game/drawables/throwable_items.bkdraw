bakerrrr-drawable 1

# Hand-thrown objects and chemical delivery vessels. Aerosol markings echo the
# matching deployed traps, while their containers remain readable in-hand.
drawable glass_bottle context ground:
    paint glass = fill
    paint rim = edge
    paint hollow = shade

    variant compact:
        layer bottle:
            polygon bottle_body glass outline rim width 0.45:
                6, 5
                6, 2
                10, 2
                10, 5
                12.5, 8
                11.5, 14
                4.5, 14
                3.5, 8
            rect open_neck hollow:
                x 6.5
                y 1.25
                w 3
                h 1.25
                outline rim
                width 0.4
            line glass_glint rim width 0.35:
                5.25, 7.5
                5.75, 11.5
        surface item:
            bottle_body
            open_neck

    variant detailed:
        layer bottle:
            polygon bottle_body glass outline rim width 0.3:
                5.8, 5.05
                5.8, 1.9
                10.2, 1.9
                10.2, 5.05
                12.7, 7.85
                11.65, 14.15
                4.35, 14.15
                3.3, 7.85
            rect open_neck hollow:
                x 6.35
                y 1.1
                w 3.3
                h 1.2
                outline rim
                width 0.25
        layer reflections:
            line glass_glint rim width 0.25:
                4.9, 7.5
                5.35, 11.6
            line shoulder_glint rim width 0.2:
                6.35, 5.15
                8.6, 5.15
            line bottle_base hollow width 0.25:
                5.1, 12.95
                10.9, 12.95
        surface item:
            bottle_body
            open_neck

