bakerrrr-drawable 2

# Worn geometry is derived from frozen body Points. Local coordinate Scalars
# are explicit; body_unit is a body-height measure, never a naked offset.
drawable boots context garment:
    let body_unit = body_height / 14
    let (left_toe_x, foot_y) = toe_tip_left
    let left_foot_x = left_toe_x + ankle_width_left
    paint fabric = fill
    paint trim = edge
    let sole_y = foot_y
    variant compact:
        layer body:
            rect left_boot fabric:
                x left_foot_x - body_unit * 1.25
                y foot_y - body_unit * 2
                w body_unit * 2.5
                h body_unit * 2.5
            mirror left_boot as right_boot
        surface garment:
            left_boot
            right_boot
    variant detailed:
        layer body:
            polygon left_boot fabric outline trim width 0.3:
                left_foot_x - body_unit * 1, foot_y - body_unit * 3
                left_foot_x + body_unit * 0.75, foot_y - body_unit * 3
                left_foot_x + body_unit * 1, sole_y
                left_foot_x - body_unit * 2, sole_y
            mirror left_boot as right_boot
        layer detail:
            line left_sole trim width 0.4:
                left_foot_x - body_unit * 2, sole_y
                left_foot_x + body_unit * 1, sole_y
            mirror left_sole as right_sole
        surface garment:
            left_boot
            right_boot

drawable sneakers context garment:
    let body_unit = body_height / 14
    let (left_toe_x, foot_y) = toe_tip_left
    let left_foot_x = left_toe_x + ankle_width_left
    paint fabric = fill
    paint trim = edge
    paint sole = shade
    variant compact:
        layer body:
            polygon left_shoe fabric:
                left_foot_x - body_unit * 1, foot_y - body_unit * 1.25
                left_foot_x + body_unit * 0.5, foot_y - body_unit * 1.25
                left_foot_x + body_unit * 0.85, foot_y
                left_foot_x - body_unit * 1, foot_y
            mirror left_shoe as right_shoe
        layer detail:
            line left_sole sole width 0.22:
                left_foot_x - body_unit * 1, foot_y
                left_foot_x + body_unit * 0.85, foot_y
            mirror left_sole as right_sole
        surface garment:
            left_shoe
            right_shoe
    variant detailed:
        layer body:
            polygon left_shoe fabric outline trim width 0.25:
                left_foot_x - body_unit * 1, foot_y - body_unit * 1.75
                left_foot_x + body_unit * 1, foot_y - body_unit * 1.75
                left_foot_x + body_unit * 1.5, foot_y
                left_foot_x - body_unit * 1.5, foot_y
            mirror left_shoe as right_shoe
        layer detail:
            line left_lace trim width 0.25:
                left_foot_x - body_unit * 0.5, foot_y - body_unit * 1.25
                left_foot_x + body_unit * 0.75, foot_y - body_unit * 1.25
            mirror left_lace as right_lace
        surface garment:
            left_shoe
            right_shoe

drawable sandals context garment:
    let body_unit = body_height / 14
    let (left_toe_x, foot_y) = toe_tip_left
    let left_foot_x = left_toe_x + ankle_width_left
    paint fabric = fill
    paint trim = edge
    variant compact:
        layer body:
            ellipse left_sole fabric:
                x left_foot_x - body_unit * 1.5
                y foot_y - body_unit * 0.75
                w body_unit * 3
                h body_unit * 1.25
            mirror left_sole as right_sole
        layer straps:
            line left_strap trim width 0.55:
                left_foot_x - body_unit * 1, foot_y - body_unit * 1.5
                left_foot_x + body_unit * 1, foot_y - body_unit * 0.5
            mirror left_strap as right_strap
        surface garment:
            left_sole
            right_sole
    variant detailed:
        layer body:
            ellipse left_sole fabric:
                x left_foot_x - body_unit * 1.5
                y foot_y - body_unit * 0.75
                w body_unit * 3
                h body_unit * 0.75
                outline trim
                width 0.2
            mirror left_sole as right_sole
        layer straps:
            line left_strap_a trim width 0.35:
                left_foot_x - body_unit * 1, foot_y - body_unit * 1.5
                left_foot_x + body_unit * 1, foot_y - body_unit * 0.5
            line left_strap_b trim width 0.35:
                left_foot_x + body_unit * 1, foot_y - body_unit * 1.5
                left_foot_x - body_unit * 1, foot_y - body_unit * 0.5
            mirror left_strap_a as right_strap_a
            mirror left_strap_b as right_strap_b
        surface garment:
            left_sole
            right_sole

drawable cap context garment:
    let (body_mid_x, head_top_y) = crown
    let head_half = head_width / 2
    paint fabric = fill
    paint trim = edge
    point forehead = between(crown, chin, 0.35)
    let (forehead_x, brim_y) = forehead
    let hat_half = head_half * 1.05
    let top_y = head_top_y - head_height / 10
    point crown_left = body_mid_x - hat_half, brim_y
    point crown_right = body_mid_x + hat_half, brim_y
    point brim_tip = body_mid_x + head_half * 1.65, brim_y
    point brim_lower = body_mid_x + head_half * 1.4, brim_y + head_height / 12
    point brim_inner = body_mid_x, brim_y + head_height / 12
    variant compact:
        layer body:
            polygon crown fabric:
                crown_left
                body_mid_x - hat_half * 0.85, head_top_y + head_height / 12
                body_mid_x - hat_half * 0.4, top_y
                body_mid_x + hat_half * 0.4, top_y
                body_mid_x + hat_half * 0.85, head_top_y + head_height / 12
                crown_right
            polygon brim fabric:
                forehead
                brim_tip
                brim_lower
                brim_inner
        surface garment:
            crown
            brim

    variant detailed:
        layer body:
            polygon crown fabric outline trim width 0.2:
                crown_left
                body_mid_x - hat_half * 0.85, head_top_y + head_height / 12
                body_mid_x - hat_half * 0.4, top_y
                body_mid_x + hat_half * 0.4, top_y
                body_mid_x + hat_half * 0.85, head_top_y + head_height / 12
                crown_right
            polygon brim fabric outline trim width 0.2:
                forehead
                brim_tip
                brim_lower
                brim_inner
        layer seam:
            line crown_seam trim width 0.2:
                body_mid_x, top_y
                forehead
        surface garment:
            crown
            brim

drawable bandana context garment:
    let (body_mid_x, crown_y) = crown
    let head_half = head_width / 2
    paint fabric = fill
    paint trim = edge
    point band_top = between(crown, chin, 0.15)
    point band_bottom = between(crown, chin, 0.38)
    let (band_x, top_y) = band_top
    let (band_bottom_x, bottom_y) = band_bottom
    point knot = body_mid_x + head_half, top_y + head_height / 8
    let (knot_x, knot_y) = knot
    point tail_tip = knot_x + head_width / 4, knot_y + head_height / 3
    point tail_inner = knot_x + head_width / 14, knot_y + head_height / 3
    point short_tip = knot_x + head_width / 3, knot_y + head_height / 12
    point short_inner = knot_x + head_width / 6, knot_y + head_height / 5
    variant compact:
        layer ties:
            polygon tail fabric:
                knot
                tail_tip
                tail_inner
            polygon short_tail fabric:
                knot
                short_tip
                short_inner
        layer body:
            polygon wrap fabric:
                body_mid_x - head_half * 0.85, top_y
                body_mid_x + head_half * 0.85, top_y
                body_mid_x + head_half * 1.05, bottom_y
                body_mid_x - head_half * 1.05, bottom_y
            circle knot trim:
                center knot
                radius head_width / 14
        surface garment:
            wrap
            tail
            short_tail
            knot

    variant detailed:
        layer ties:
            polygon tail fabric outline trim width 0.2:
                knot
                tail_tip
                tail_inner
            polygon short_tail fabric outline trim width 0.2:
                knot
                short_tip
                short_inner
        layer body:
            polygon wrap fabric outline trim width 0.2:
                body_mid_x - head_half * 0.85, top_y
                body_mid_x + head_half * 0.85, top_y
                body_mid_x + head_half * 1.05, bottom_y
                body_mid_x - head_half * 1.05, bottom_y
            circle knot trim:
                center knot
                radius head_width / 14
        layer seam:
            line tie_fold trim width 0.15:
                knot
                between(tail_tip, tail_inner, 0.5)
        surface garment:
            wrap
            tail
            short_tail
            knot
