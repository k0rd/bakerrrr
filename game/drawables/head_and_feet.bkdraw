bakerrrr-drawable 1

drawable boots context garment:
    paint fabric = fill
    paint trim = edge
    let sole_y = foot_y
    variant compact:
        layer body:
            rect left_boot fabric:
                x mid - 3.5
                y foot_y - 2
                w 2.5
                h 2
            mirror left_boot as right_boot
        surface garment:
            left_boot
            right_boot
    variant detailed:
        layer body:
            polygon left_boot fabric outline trim width 0.3:
                mid - 3.5, foot_y - 3
                mid - 1.25, foot_y - 3
                mid - 1, sole_y
                mid - 4, sole_y
            mirror left_boot as right_boot
        layer detail:
            line left_sole trim width 0.4:
                mid - 4, sole_y
                mid - 1, sole_y
            mirror left_sole as right_sole
        surface garment:
            left_boot
            right_boot

drawable sneakers context garment:
    paint fabric = fill
    paint trim = edge
    variant compact:
        layer body:
            ellipse left_shoe fabric:
                x mid - 4
                y foot_y - 1.5
                w 3
                h 1.5
            mirror left_shoe as right_shoe
        surface garment:
            left_shoe
            right_shoe
    variant detailed:
        layer body:
            polygon left_shoe fabric outline trim width 0.25:
                mid - 3.5, foot_y - 1.75
                mid - 1.5, foot_y - 1.75
                mid - 1, foot_y
                mid - 4, foot_y
            mirror left_shoe as right_shoe
        layer detail:
            line left_lace trim width 0.25:
                mid - 3, foot_y - 1.25
                mid - 1.75, foot_y - 1.25
            mirror left_lace as right_lace
        surface garment:
            left_shoe
            right_shoe

drawable sandals context garment:
    paint fabric = fill
    paint trim = edge
    variant compact:
        layer body:
            ellipse left_sole fabric:
                x mid - 4
                y foot_y - 0.75
                w 3
                h 0.75
            mirror left_sole as right_sole
        layer straps:
            line left_strap trim width 0.55:
                mid - 3.5, foot_y - 1.5
                mid - 1.5, foot_y - 0.5
            mirror left_strap as right_strap
        surface garment:
            left_sole
            right_sole
    variant detailed:
        layer body:
            ellipse left_sole fabric:
                x mid - 4
                y foot_y - 0.75
                w 3
                h 0.75
                outline trim
                width 0.2
            mirror left_sole as right_sole
        layer straps:
            line left_strap_a trim width 0.35:
                mid - 3.5, foot_y - 1.5
                mid - 1.5, foot_y - 0.5
            line left_strap_b trim width 0.35:
                mid - 1.5, foot_y - 1.5
                mid - 3.5, foot_y - 0.5
            mirror left_strap_a as right_strap_a
            mirror left_strap_b as right_strap_b
        surface garment:
            left_sole
            right_sole

drawable cap context garment:
    paint fabric = fill
    paint trim = edge
    variant compact:
        layer body:
            ellipse crown fabric:
                x mid - 3
                y shoulder_y - 5
                w 6
                h 3
            rect brim fabric:
                x mid
                y shoulder_y - 3
                w 4
                h 0.75
        surface garment:
            crown
            brim
    variant detailed:
        layer body:
            ellipse crown fabric:
                x mid - 3.25
                y shoulder_y - 5.25
                w 6.5
                h 3.25
                outline trim
                width 0.25
            polygon brim fabric outline trim width 0.25:
                mid - 0.25, shoulder_y - 3
                mid + 4, shoulder_y - 3
                mid + 3.25, shoulder_y - 2.25
                mid, shoulder_y - 2.25
        layer seam:
            line crown_seam trim width 0.2:
                mid, shoulder_y - 5
                mid, shoulder_y - 2.5
        surface garment:
            crown
            brim

drawable bandana context garment:
    paint fabric = fill
    paint trim = edge
    variant compact:
        layer body:
            polygon wrap fabric:
                mid - 3.5, shoulder_y - 4
                mid + 3.5, shoulder_y - 4
                mid + 3, shoulder_y - 2
                mid - 3, shoulder_y - 2
            polygon tail fabric:
                mid + 2.5, shoulder_y - 2.5
                mid + 5, shoulder_y
                mid + 3, shoulder_y + 0.5
        surface garment:
            wrap
            tail
    variant detailed:
        layer body:
            polygon wrap fabric outline trim width 0.25:
                mid - 3.5, shoulder_y - 4.25
                mid + 3.5, shoulder_y - 4.25
                mid + 3, shoulder_y - 2
                mid - 3, shoulder_y - 2
            polygon tail fabric outline trim width 0.25:
                mid + 2.5, shoulder_y - 2.5
                mid + 5, shoulder_y
                mid + 3, shoulder_y + 0.5
        layer seam:
            line fold trim width 0.25:
                mid - 3, shoulder_y - 2.5
                mid + 3, shoulder_y - 2.5
        surface garment:
            wrap
            tail
