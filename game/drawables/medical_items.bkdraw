bakerrrr-drawable 1

# Clinical and field medical supplies. Packaging, delivery mechanism, and the
# visible state of the object carry identity instead of one generic medicine vial.
drawable calm_patch context ground:
    paint adhesive = fill
    paint print = edge
    paint reservoir = shade

    variant compact:
        layer patch:
            rect patch_body adhesive:
                x 2.5
                y 4
                w 11
                h 8
                outline print
                width 0.45
            circle calm_reservoir reservoir:
                center 8, 8
                radius 2.25
                outline print
                width 0.35
            line calm_ring print width 0.45:
                5, 8
                11, 8
        surface item:
            patch_body

    variant detailed:
        layer patch:
            rect patch_body adhesive:
                x 2.25
                y 3.75
                w 11.5
                h 8.5
                outline print
                width 0.3
            circle calm_reservoir reservoir:
                center 8, 8
                radius 2.4
                outline print
                width 0.25
            circle calm_center print:
                center 8, 8
                radius 0.65
            line calm_wave_left print width 0.25:
                3.5, 8
                5, 7.25
            line calm_wave_right print width 0.25:
                11, 8.75
                12.5, 8
            polygon peel_corner reservoir:
                11.75, 10.25
                13.75, 10.25
                13.75, 12.25
        surface item:
            patch_body

