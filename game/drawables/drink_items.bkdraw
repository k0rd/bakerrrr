bakerrrr-drawable 1

# Ground-primary art for the historical drink render category. That category
# also contains small oral and inhaled consumables, so each definition follows
# the actual item rather than inheriting the old bottle-shaped fallback.
drawable caff_shot context ground:
    paint vial = fill
    paint cap = edge
    paint liquid = shade

    variant compact:
        layer dose:
            rect vial_body vial:
                x 5.5
                y 5
                w 5
                h 8
                outline cap
                width 0.45
            rect dose_fill liquid:
                x 6.25
                y 8
                w 3.5
                h 4.25
            rect vial_cap cap:
                x 5
                y 3.5
                w 6
                h 2
        surface item:
            vial_body
            dose_fill
            vial_cap

    variant detailed:
        layer dose:
            rect vial_body vial:
                x 5.35
                y 5
                w 5.3
                h 8.25
                outline cap
                width 0.3
            rect dose_fill liquid:
                x 6
                y 8.1
                w 4
                h 4.45
            rect vial_cap cap:
                x 4.85
                y 3.25
                w 6.3
                h 2
                outline liquid
                width 0.2
        layer details:
            line cap_ridge liquid width 0.25:
                5.35, 4.15
                10.65, 4.15
            line charge_mark cap width 0.3:
                8.6, 6.2
                7.45, 8.15
                8.55, 8.15
                7.4, 10.25
        surface item:
            vial_body
            dose_fill
            vial_cap

