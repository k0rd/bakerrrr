            line left_strap trim width 0.85:
                5.15, 4.65
                2.75, 7.7
                3.75, 13.8
            line right_strap trim width 0.85:
                10.85, 4.65
                13.25, 7.7
                12.25, 13.8
        layer pack:
            polygon pack_body fabric outline trim width 0.3:
                5.3, 2.25
                10.7, 2.25
                12.7, 4.85
                12.7, 14.2
                3.3, 14.2
                3.3, 4.85
            line top_handle trim width 0.45:
                6.25, 2.3
                6.75, 1.25
                9.25, 1.25
                9.75, 2.3
            line flap trim width 0.4:
                3.8, 6.3
                8, 7.95
                12.2, 6.3
            rect front_pocket pocket:
                x 4.8
                y 8.9
                w 6.4
                h 4.15
                outline trim
                width 0.25
            line pocket_seam trim width 0.25:
                5.2, 10.25
                10.8, 10.25
            circle buckle trim:
                center 8, 11.65
                radius 0.55
        surface item:
            pack_body
            front_pocket

drawable plant_pot context ground:
    paint ceramic = fill
    paint glaze = edge
    paint motif = shade

    variant compact:
        layer pot:
            rect pot_rim ceramic:
                x 3
                y 3.5
                w 10
                h 3
                outline glaze
                width 0.45
            polygon pot_body ceramic outline glaze width 0.45:
                4, 6.5
                12, 6.5
                10.75, 14
                5.25, 14
        layer decoration:
            polygon star_motif motif:
                8, 7.5
                8.7, 9.25
                10.5, 9.25
                9, 10.25
                9.6, 12
                8, 10.9
                6.4, 12
                7, 10.25
                5.5, 9.25
                7.3, 9.25
