bakerrrr-drawable 1

# Carried storage and common salvage. The soft canvas sack deliberately replaces
# its old box fallback; each salvage type exposes the material worth recovering.
drawable canvas_sack context ground:
    paint canvas = fill
    paint cord = edge
    paint fold = shade

    variant compact:
        layer sack:
            polygon sack_body canvas outline cord width 0.45:
                5.5, 3.5
                10.5, 3.5
                11.25, 5.5
                13.5, 9
                12.5, 14
                3.5, 14
                2.5, 9
                4.75, 5.5
            line tied_neck cord width 0.8:
                4.75, 5.5
                11.25, 5.5
            line drawcord cord width 0.5:
                8, 5.5
                11.5, 3.5
            line center_fold fold width 0.55:
                8, 6.5
                8.75, 13
        surface item:
            sack_body

    variant detailed:
        layer sack:
            polygon sack_body canvas outline cord width 0.3:
                5.35, 3.25
                10.65, 3.25
                11.35, 5.35
                13.65, 8.8
                12.65, 14.15
                3.35, 14.15
                2.35, 8.8
                4.65, 5.35
            line tied_neck cord width 0.55:
                4.65, 5.35
                11.35, 5.35
            circle cord_knot cord:
                center 8, 5.35
                radius 0.55
            line drawcord_left cord width 0.3:
                8, 5.35
                5.25, 2.5
            line drawcord_right cord width 0.3:
                8, 5.35
                11.6, 3.15
            line center_fold fold width 0.35:
                8, 6.3
                8.75, 13.3
            line side_fold_left fold width 0.25:
                4.4, 8
                5.25, 12.8
            line side_fold_right fold width 0.25:
                11.6, 8
                10.75, 12.8
        surface item:
            sack_body

drawable backpack context ground:
    paint fabric = fill
    paint trim = edge
    paint pocket = shade

    variant compact:
        layer straps:
            line left_strap trim width 1.2:
                5.25, 5
                3, 8
                4, 13.5
            line right_strap trim width 1.2:
                10.75, 5
                13, 8
                12, 13.5
        layer pack:
            polygon pack_body fabric outline trim width 0.45:
                5.5, 2.5
                10.5, 2.5
                12.5, 5
                12.5, 14
                3.5, 14
                3.5, 5
            rect front_pocket pocket:
                x 5
                y 9
                w 6
                h 4
                outline trim
                width 0.4
            line flap trim width 0.55:
                4, 6.5
                8, 8
                12, 6.5
