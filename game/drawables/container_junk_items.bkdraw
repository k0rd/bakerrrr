                9.6, 12
                8, 10.9
                6.4, 12
                6.95, 10.25
                5.45, 9.15
                7.3, 9.15
            line base_glaze glaze width 0.25:
                5.4, 13.25
                10.6, 13.25
        surface item:
            pot_rim
            pot_body

