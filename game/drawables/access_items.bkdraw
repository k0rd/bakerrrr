            rect contact inset:
                x 11.5
                y 6
                w 3.25
                h 4
                outline circuit
                width 0.35
            circle key_port inset:
                center 5, 8
                radius 1.4
                outline circuit
                width 0.35
            line circuit_trace circuit width 0.55:
                6.5, 8
                8.5, 8
                9.5, 6.5
