                11.7, 2.8
                14.2, 5.35
                14.2, 10.65
                11.7, 13.2
                3.9, 13.2
                1.8, 11
            rect contact inset:
                x 11.55
                y 5.75
                w 3.15
                h 4.5
                outline circuit
                width 0.25
            line contact_split circuit width 0.2:
                13.1, 6.1
