bakerrrr-drawable 1

# Keys and credentials. Their silhouettes distinguish physical access, carried
# authority, Wire permissions, and a credential worn openly on a lanyard.
drawable property_key context ground:
    paint metal = fill
    paint edgework = edge
    paint recess = shade

    variant compact:
        layer key:
            circle key_bow metal:
                center 3.75, 8
                radius 2.5
                outline edgework
                width 0.45
            circle bow_hole recess:
                center 3.75, 8
                radius 1
            line key_shaft metal width 2:
                5.75, 8
                13.75, 8
            line tooth_one metal width 1.5:
                10.5, 8
                10.5, 10.5
            line tooth_two metal width 1.5:
                13, 8
                13, 9.75
            line spine edgework width 0.35:
                5.75, 7.25
                14, 7.25
        surface item:
            key_bow
            key_shaft

    variant detailed:
        layer key:
            circle key_bow metal:
                center 3.6, 8
                radius 2.65
                outline edgework
                width 0.3
            circle bow_hole recess:
                center 3.6, 8
                radius 1.15
                outline edgework
                width 0.2
            polygon key_shaft metal outline edgework width 0.25:
                5.85, 7.1
                14.35, 7.1
                14.35, 8.5
                13.15, 8.5
                13.15, 10.35
                11.65, 10.35
                11.65, 8.5
                9.8, 8.5
                9.8, 9.65
                8.35, 9.65
                8.35, 8.5
                5.85, 8.5
            line shaft_glint edgework width 0.2:
                6.25, 7.55
                13.85, 7.55
        surface item:
            key_bow
            key_shaft

drawable access_badge context ground:
    paint plastic = fill
    paint print = edge
    paint portrait = shade

    variant compact:
        layer badge:
            rect badge_card plastic:
                x 2
                y 4
                w 12
                h 8.5
                outline print
                width 0.45
            rect photo portrait:
                x 3.25
                y 5.5
                w 3.25
                h 3.75
            line name_line print width 0.55:
                8, 6.25
                12.5, 6.25
            line access_stripe portrait width 1.25:
                3.25, 10.5
                12.75, 10.5
            rect clip_slot portrait:
                x 6.5
                y 3
                w 3
                h 1.25
                outline print
                width 0.3
        surface item:
            badge_card
            clip_slot

    variant detailed:
        layer badge:
            rect badge_card plastic:
                x 1.8
                y 3.85
                w 12.4
                h 8.7
                outline print
                width 0.3
            rect photo portrait:
                x 3
                y 5.25
                w 3.4
                h 3.8
                outline print
                width 0.2
            circle portrait_head print:
                center 4.7, 6.45
                radius 0.75
            line portrait_shoulders print width 0.55:
                3.7, 8.2
                4.7, 7.45
                5.7, 8.2
            line name_line print width 0.35:
                7.75, 5.8
                12.65, 5.8
            line detail_line print width 0.25:
                7.75, 7.15
                11.75, 7.15
            line access_stripe portrait width 1.1:
                3, 10.65
                13, 10.65
            rect clip_slot portrait:
                x 6.35
                y 2.8
                w 3.3
                h 1.3
                outline print
                width 0.2
        surface item:
            badge_card
            clip_slot

