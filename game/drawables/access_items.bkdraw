            line lanyard_loop strap width 1.15:
                2.8, 1.6
                4.8, 7.8
                8, 9.8
                11.2, 7.8
                13.2, 1.6
            line strap_edge print width 0.2:
                2.8, 1.6
                4.8, 7.8
                8, 9.8
                11.2, 7.8
                13.2, 1.6
            circle clasp print:
                center 8, 9.35
                radius 0.6
        layer credential:
            rect contractor_card card:
                x 4.55
                y 9.65
                w 6.9
                h 5.15
                outline print
                width 0.3
            rect contractor_photo strap:
                x 5.25
