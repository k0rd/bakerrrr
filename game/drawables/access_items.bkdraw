drawable contractor_badge_lanyard context ground:
    paint strap = fill
    paint print = edge
    paint card = shade

    variant compact:
        layer lanyard:
            line lanyard_loop strap width 1.5:
                3, 2
                5, 8
                8, 10
                11, 8
                13, 2
            line strap_edge print width 0.35:
                3, 2
                5, 8
                8, 10
                11, 8
                13, 2
            circle clasp print:
                center 8, 9.5
                radius 0.7
        layer credential:
            rect contractor_card card:
                x 4.75
                y 9.75
                w 6.5
                h 5
                outline print
                width 0.45
            line card_stripe print width 0.7:
                5.75, 13.2
                10.25, 13.2
        surface item:
            lanyard_loop
            contractor_card

    variant detailed:
