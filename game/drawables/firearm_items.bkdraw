bakerrrr-drawable 2

# First firearm category: item-specific side profiles on the 16-unit canvas.
# Compact variants emphasize silhouettes; detailed variants add restrained
# surface marks. This file supplies ground/inventory art, not weapon mechanics.

drawable holdout_pistol context ground:
    paint body = fill
    paint light = edge
    paint dark = shade

    variant compact:
        layer weapon:
            polygon frame body outline dark width 0.35:
                3, 6.7
                11.4, 6.7
                11.1, 8.5
                7.2, 8.5
                5.8, 12.9
                2.5, 12.9
                3.7, 8.3
            polygon guard light outline dark width 0.35:
                6.4, 8.2
                9.2, 8.2
                9, 10
                7.9, 10.6
                6.2, 10.1
            polygon guard_opening dark:
                7, 8.5
                8.7, 8.5
                8.5, 9.6
                7.6, 10
                6.8, 9.6
            polygon slide body outline dark width 0.35:
                2.6, 4.5
                12.8, 4.5
                13.3, 5.2
                13.1, 7.3
                3, 7.3
                2.5, 6.7
            line slide_top light width 0.55:
                3.1, 4.8
                12.7, 4.8
            polygon grip_panel dark:
                4, 8.2
                6.6, 8.2
                5.4, 12.3
                3.2, 12.3
            line grip_edge body width 0.4:
                3.4, 11.9
                5.2, 11.9
                6, 9.1
            line muzzle dark width 0.55:
                12.5, 5.5
                12.5, 6.8
            line rear_sight light width 0.55:
                3.5, 4.4
                4.6, 4.4
            line front_sight light width 0.5:
                11.7, 4.3
                12.6, 4.3
        surface item:
            frame
            slide

    variant detailed:
        layer weapon:
            polygon frame body outline dark width 0.35:
                3, 6.7
                11.4, 6.7
                11.1, 8.5
                7.2, 8.5
                5.8, 12.9
                2.5, 12.9
                3.7, 8.3
            polygon guard light outline dark width 0.35:
                6.4, 8.2
