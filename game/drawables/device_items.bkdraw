bakerrrr-drawable 1

# Handheld and placeable electronics. Their shapes communicate operation before
# legality tint or inventory copy: smart phone, burner, radio, media, control,
# and beacon all need different reads.
drawable phone context ground:
    paint casing = fill
    paint trim = edge
    paint screen = shade

    variant compact:
        layer handset:
            rect phone_body casing:
                x 4.5
                y 1.75
                w 7
                h 12.5
                outline trim
                width 0.45
            rect phone_screen screen:
                x 5.25
                y 3.25
                w 5.5
                h 8
            circle home_key trim:
                center 8, 12.75
                radius 0.6
        surface item:
            phone_body
            phone_screen

    variant detailed:
        layer handset:
            rect phone_body casing:
                x 4.35
                y 1.55
                w 7.3
                h 12.8
                outline trim
                width 0.3
            rect phone_screen screen:
                x 5.05
                y 3
                w 5.9
                h 8.2
                outline trim
                width 0.2
            circle home_key trim:
                center 8, 12.7
                radius 0.55
        layer details:
            line speaker trim width 0.25:
                6.75, 2.3
                9.25, 2.3
            line screen_glint trim width 0.2:
                5.6, 3.6
                9.6, 3.6
        surface item:
            phone_body
            phone_screen

drawable burner_phone context ground:
