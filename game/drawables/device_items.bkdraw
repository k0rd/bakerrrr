                3.55, 9.5
        surface item:
            radio_body
            speaker_panel

drawable blank_procedure_flash context ground:
    paint shell = fill
    paint contacts = edge
    paint blank = shade

    variant compact:
        layer media:
            rect flash_body shell:
                x 2.5
                y 5
                w 10
                h 7
                outline contacts
                width 0.45
            rect contact_tab contacts:
                x 12.5
                y 6.25
                w 2
                h 4.5
            circle blank_mark blank:
                center 7, 8.5
                radius 1.75
        surface item:
            flash_body
            contact_tab

    variant detailed:
        layer media:
            rect flash_body shell:
                x 2.3
                y 4.8
                w 10.3
                h 7.4
                outline contacts
                width 0.3
            rect contact_tab contacts:
                x 12.6
                y 6
                w 2.1
                h 4.9
                outline blank
                width 0.2
            circle blank_mark blank:
                center 6.7, 8.5
                radius 1.7
        layer circuitry:
            line circuit_top contacts width 0.25:
                8.7, 6.2
                10.7, 6.2
                10.7, 8
                12.5, 8
            line circuit_bottom contacts width 0.25:
                8.7, 10.7
                10.7, 10.7
                10.7, 9
                12.5, 9
            line blank_slash shell width 0.25:
                5.6, 9.6
                7.8, 7.4
        surface item:
            flash_body
            contact_tab

