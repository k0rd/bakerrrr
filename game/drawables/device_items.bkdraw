drawable two_way_radio context ground:
    paint casing = fill
    paint hardware = edge
    paint speaker = shade

    variant compact:
        layer radio:
            rect radio_body casing:
                x 3.75
                y 4
                w 8.5
                h 9.75
                outline hardware
                width 0.45
            rect speaker_panel speaker:
                x 5
                y 6
                w 6
                h 4.5
            line antenna hardware width 0.65:
                5, 4
                4, 1
            circle tuning_knob hardware:
                center 10.5, 3.5
                radius 0.8
        layer speaker:
