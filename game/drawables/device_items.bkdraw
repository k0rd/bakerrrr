drawable decoy_beacon context ground:
    paint housing = fill
    paint signal = edge
    paint core = shade

    variant compact:
        layer beacon:
            polygon beacon_base housing outline signal width 0.45:
                4, 11
                12, 11
                13.5, 13.5
                2.5, 13.5
            rect beacon_core housing:
                x 5
                y 6
                w 6
                h 5.5
                outline signal
                width 0.4
            line beacon_mast signal width 0.55:
                8, 6
                8, 2.25
            circle beacon_light core:
                center 8, 2
                radius 1
        layer signal:
            line signal_left signal width 0.4:
                6.5, 3
                4.75, 4.5
            line signal_right signal width 0.4:
                9.5, 3
                11.25, 4.5
        surface item:
            beacon_base
            beacon_core
            beacon_light

    variant detailed:
        layer beacon:
            polygon beacon_base housing outline signal width 0.3:
                3.8, 10.9
                12.2, 10.9
                13.7, 13.7
                2.3, 13.7
            rect beacon_core housing:
                x 4.8
                y 5.8
                w 6.4
                h 5.6
                outline signal
                width 0.3
            line beacon_mast signal width 0.4:
                8, 5.8
                8, 2.1
            circle beacon_light core:
                center 8, 1.85
                radius 0.95
        layer details:
            line signal_inner_left signal width 0.3:
                6.45, 2.8
                5.1, 4.1
            line signal_inner_right signal width 0.3:
                9.55, 2.8
                10.9, 4.1
            line signal_outer_left signal width 0.25:
                5.25, 1.9
                3.4, 3.8
            line signal_outer_right signal width 0.25:
                10.75, 1.9
                12.6, 3.8
            circle status_light signal:
                center 8, 8.6
                radius 0.65
            line base_seam core width 0.25:
                4, 12.3
                12, 12.3
        surface item:
            beacon_base
            beacon_core
            beacon_light
