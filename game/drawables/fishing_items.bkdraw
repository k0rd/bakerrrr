                2.4, 12.7
                3.4, 13.5
            line grip_wrap_upper shadow width 0.3:
                3.5, 11.4
                4.5, 12.2
            circle lower_guide steel:
                center 8.1, 6.9
                radius 0.45
                outline shadow
                width 0.2
            circle upper_guide steel:
                center 10.8, 3.6
                radius 0.35
        surface item:
