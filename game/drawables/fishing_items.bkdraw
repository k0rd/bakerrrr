bakerrrr-drawable 2

# Fishing gear and whole-catch states extracted from generic tool, junk, ground and food art.
# Ground art uses the shared 16-unit canvas. Both variants retain the same silhouette.

# Long tapered rod, hanging line and a visible reel; replaces the tool fallback.
drawable fishing_pole context ground:
    paint body = fill
    paint steel = edge
    paint shadow = shade

    variant compact:
        layer silhouette:
            line fishing_line body width 0.35:
                12.7, 1.5
                13.4, 5
                13.6, 9.4
            line hook steel width 0.45:
                13.6, 9.4
                13.6, 10.5
                12.7, 11
                12.2, 10.4
            strip rod body:
                start 3, 12.7
                finish 12.7, 1.5
                width 1
                finish_width 0.4
                outline shadow
                outline_width 0.35
            strip cork_grip body:
                start 2.1, 13.5
                finish 5.1, 10.3
                width 1.9
                finish_width 1.5
                outline shadow
                outline_width 0.35
            line reel_mount steel width 0.75:
                4.5, 10.9
                6.8, 11.5
            circle reel body:
                center 6.6, 11.4
                radius 1.7
                outline shadow
                width 0.35
            circle reel_spool steel:
                center 6.6, 11.4
                radius 0.8
            line rod_glint steel width 0.3:
                5.5, 9.4
                9.6, 4.8
        surface item:
            rod
            cork_grip
            reel

    variant detailed:
        layer silhouette:
            line fishing_line body width 0.35:
                12.7, 1.5
                13.4, 5
                13.6, 9.4
            line hook steel width 0.45:
                13.6, 9.4
                13.6, 10.5
                12.7, 11
                12.2, 10.4
            strip rod body:
                start 3, 12.7
                finish 12.7, 1.5
                width 1
                finish_width 0.4
                outline shadow
                outline_width 0.35
            strip cork_grip body:
                start 2.1, 13.5
                finish 5.1, 10.3
                width 1.9
                finish_width 1.5
                outline shadow
                outline_width 0.35
            line reel_mount steel width 0.75:
                4.5, 10.9
                6.8, 11.5
            circle reel body:
                center 6.6, 11.4
                radius 1.7
                outline shadow
                width 0.35
            circle reel_spool steel:
                center 6.6, 11.4
                radius 0.8
            line rod_glint steel width 0.3:
                5.5, 9.4
