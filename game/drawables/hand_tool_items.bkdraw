                5.4, 10.9
                8.6, 6.4
            polygon thumb_slider steel outline shadow width 0.25:
                6.4, 8
                7.3, 6.8
                8.4, 7.6
                7.5, 8.8
            circle lanyard_hole shadow:
                center 4.6, 12.5
                radius 0.55
