drawable box_cutter context ground:
    paint body = fill
    paint steel = edge
    paint shadow = shade

    variant compact:
        layer tool:
            polygon blade steel outline shadow width 0.35:
                7.7, 5.6
                8.5, 2.7
                11.1, 1.5
                10.2, 5
                9.7, 6.8
