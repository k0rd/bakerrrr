bakerrrr-drawable 2

# Worn geometry is derived from frozen body Points. Local coordinate Scalars
# are explicit; body_unit is a body-height measure, never a naked offset.
# Basewear families are catalogue content. Both variants are authored here so
# the renderer never needs to know an individual garment name on its live path.

drawable camisole context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (shoulder_anchor_x, shoulder_y) = shoulder_left
    let (crotch_x, hip_y) = crotch
    let shoulder_half = upper_torso_width / 2
    let hip_half = hip_width / 2
    let waist_half = waist_width / 2
    let body_left_x = body_mid_x - hip_half
    let body_right_x = body_mid_x + hip_half
    paint fabric = fill
    paint trim = edge
    paint shadow = shade
    let cami_half = shoulder_half - body_unit * 1
    let neckline_y = shoulder_y + body_unit * 2
    let bottom_y = hip_y - body_unit * 1

    variant compact:
        layer body:
            polygon bodice fabric:
                body_mid_x - cami_half, neckline_y
                body_mid_x, neckline_y + body_unit * 1
                body_mid_x + cami_half, neckline_y
                body_mid_x + waist_half, hip_y - body_unit * 2
                body_right_x - body_unit * 1, bottom_y
                body_left_x + body_unit * 1, bottom_y
                body_mid_x - waist_half, hip_y - body_unit * 2
        layer trim:
            line neckline shadow width 0.5:
                body_mid_x - cami_half, neckline_y
                body_mid_x, neckline_y + body_unit * 1
                body_mid_x + cami_half, neckline_y
            line left_strap trim width 0.5:
                body_mid_x - cami_half, neckline_y
                body_mid_x - cami_half, shoulder_y
            mirror left_strap as right_strap
            when detail has strappy:
                line cross_left trim width 0.5:
                    body_mid_x - cami_half, shoulder_y
                    body_mid_x - body_unit * 1, neckline_y + body_unit * 1
                mirror cross_left as cross_right
        group straps:
            left_strap
            right_strap
        surface garment:
            bodice

    variant detailed:
        let neck_depth = body_unit * 1
        let waist_y = neckline_y + body_unit * 2
        layer body:
            polygon bodice fabric outline trim width 0.35:
                body_mid_x - cami_half, neckline_y
                body_mid_x, neckline_y + neck_depth
                body_mid_x + cami_half, neckline_y
                body_mid_x + waist_half, waist_y
                body_right_x - body_unit * 1, bottom_y
                body_left_x + body_unit * 1, bottom_y
                body_mid_x - waist_half, waist_y
        layer trim:
            line neckline shadow width 0.35:
                body_mid_x - cami_half, neckline_y
                body_mid_x, neckline_y + neck_depth
                body_mid_x + cami_half, neckline_y
            line left_strap trim width 0.35:
                body_mid_x - cami_half, neckline_y
                body_mid_x - cami_half, shoulder_y
            mirror left_strap as right_strap
            when detail has strappy:
                line cross_left trim width 0.35:
                    body_mid_x - cami_half, shoulder_y
                    body_mid_x - body_unit * 1, neckline_y + neck_depth
                mirror cross_left as cross_right
        group straps:
            left_strap
            right_strap
        surface garment:
            bodice

    presentation ground:
        variant compact:
            layer body:
                polygon folded fill outline outline width 0.6:
                    mid - 3, 6
                    mid + 3, 6
                    mid + 4, 13
                    mid - 4, 13
            layer trim:
                line neckline edge width 0.5:
                    mid - 3, 7
                    mid, 8
                    mid + 3, 7
                line left_strap edge width 0.5:
                    mid - 3, 7
                    mid - 2, 4
                mirror left_strap as right_strap
            surface item:
                folded

drawable boyshorts context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (crotch_x, hip_y) = crotch
    let hip_half = hip_width / 2
    let basewear_half = hip_half - body_unit
    paint fabric = fill
    paint trim = edge
    let gap = body_unit * 1
    let waist_y = hip_y - body_unit * 2

    variant compact:
        let leg_bottom = hip_y + body_unit * 1
        layer body:
            polygon left_leg fabric:
                body_mid_x - basewear_half, waist_y
                body_mid_x - gap, waist_y
                body_mid_x - gap, leg_bottom
                body_mid_x - basewear_half + body_unit * 1, leg_bottom
            mirror left_leg as right_leg
        layer trim:
            line left_waist trim width 0.5:
                body_mid_x - basewear_half, waist_y
                body_mid_x - gap, waist_y
            mirror left_waist as right_waist
        group legs:
            left_leg
            right_leg
        surface garment:
            left_leg
            right_leg

    variant detailed:
        let leg_bottom = hip_y + body_unit * 1.5
        layer body:
            polygon left_leg fabric outline trim width 0.35:
                body_mid_x - basewear_half, waist_y
                body_mid_x - gap, waist_y
                body_mid_x - gap, leg_bottom
                body_mid_x - basewear_half + body_unit * 1, leg_bottom
            mirror left_leg as right_leg
        layer trim:
            line left_waist trim width 0.35:
                body_mid_x - basewear_half, waist_y
                body_mid_x - gap, waist_y
            mirror left_waist as right_waist
            line center_seam trim width 0.25:
                body_mid_x, waist_y
                body_mid_x, leg_bottom - body_unit * 0.5
        group legs:
            left_leg
            right_leg
        surface garment:
            left_leg
            right_leg

    presentation ground:
        variant compact:
            layer body:
                polygon left_leg fill outline outline width 0.6:
                    mid - 5, 5
                    mid - 1, 5
                    mid - 1, 10
                    mid - 4, 10
                mirror left_leg as right_leg
            layer trim:
                line waistband edge width 0.6:
                    mid - 5, 5
                    mid + 5, 5
            surface item:
                left_leg
                right_leg

drawable undershirt context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (shoulder_anchor_x, shoulder_y) = shoulder_left
    let (crotch_x, hip_y) = crotch
    let shoulder_half = upper_torso_width / 2
    let waist_half = waist_width / 2
    paint fabric = fill
    paint trim = edge
    let top_y = shoulder_y + body_unit * 1
    let bottom_y = hip_y - body_unit * 1

    variant compact:
        layer body:
            polygon torso fabric:
                body_mid_x - shoulder_half, top_y
                body_mid_x - body_unit * 1, top_y
                body_mid_x, top_y + body_unit * 1
                body_mid_x + body_unit * 1, top_y
                body_mid_x + shoulder_half, top_y
                body_mid_x + waist_half, bottom_y
                body_mid_x - waist_half, bottom_y
            polygon left_sleeve fabric:
                body_mid_x - shoulder_half, top_y
                body_mid_x - shoulder_half - body_unit * 1, top_y + body_unit * 1
                body_mid_x - shoulder_half, top_y + body_unit * 2
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1
            mirror left_sleeve as right_sleeve
        surface garment:
            torso
            left_sleeve
            right_sleeve

    variant detailed:
        layer body:
            polygon torso fabric outline trim width 0.35:
                body_mid_x - shoulder_half, top_y
                body_mid_x - body_unit * 1, top_y
                body_mid_x, top_y + body_unit * 1
                body_mid_x + body_unit * 1, top_y
                body_mid_x + shoulder_half, top_y
                body_mid_x + waist_half, bottom_y
                body_mid_x - waist_half, bottom_y
            polygon left_sleeve fabric outline trim width 0.3:
                body_mid_x - shoulder_half, top_y
                body_mid_x - shoulder_half - body_unit * 1, top_y + body_unit * 1.5
                body_mid_x - shoulder_half, top_y + body_unit * 2.5
                body_mid_x - shoulder_half + body_unit * 1, top_y + body_unit * 1
            mirror left_sleeve as right_sleeve
        surface garment:
            torso
            left_sleeve
            right_sleeve

    presentation ground:
        variant compact:
            layer body:
                polygon torso fill outline outline width 0.6:
                    mid - 3, 4
                    mid - 1, 4
                    mid, 5
                    mid + 1, 4
                    mid + 3, 4
                    mid + 4, 7
                    mid + 3, 8
                    mid + 3, 13
                    mid - 3, 13
                    mid - 3, 8
                    mid - 4, 7
            layer trim:
                line neckline shade width 0.5:
                    mid - 1, 4
                    mid, 5
                    mid + 1, 4
            surface item:
                torso

drawable tank_undershirt context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (shoulder_anchor_x, shoulder_y) = shoulder_left
    let (crotch_x, hip_y) = crotch
    let shoulder_half = upper_torso_width / 2
    let waist_half = waist_width / 2
    paint fabric = fill
    paint trim = edge
    let neck_y = shoulder_y + body_unit * 2
    let bottom_y = hip_y - body_unit * 1
    let tank_half = shoulder_half - body_unit * 1

    variant compact:
        layer body:
            polygon torso fabric:
                body_mid_x - tank_half, neck_y
                body_mid_x - body_unit * 1, neck_y
                body_mid_x, neck_y + body_unit * 1
                body_mid_x + body_unit * 1, neck_y
                body_mid_x + tank_half, neck_y
                body_mid_x + waist_half, bottom_y
                body_mid_x - waist_half, bottom_y
        layer straps:
            line left_strap trim width 0.55:
                body_mid_x - tank_half, neck_y
                body_mid_x - tank_half, shoulder_y
            mirror left_strap as right_strap
        surface garment:
            torso

    variant detailed:
        layer body:
            polygon torso fabric outline trim width 0.35:
                body_mid_x - tank_half, neck_y
                body_mid_x - body_unit * 1, neck_y
                body_mid_x, neck_y + body_unit * 1.25
                body_mid_x + body_unit * 1, neck_y
                body_mid_x + tank_half, neck_y
                body_mid_x + waist_half, bottom_y
                body_mid_x - waist_half, bottom_y
        layer straps:
            line left_strap trim width 0.35:
                body_mid_x - tank_half, neck_y
                body_mid_x - tank_half, shoulder_y
            mirror left_strap as right_strap
        surface garment:
            torso

    presentation ground:
        variant compact:
            layer body:
                polygon torso fill outline outline width 0.6:
                    mid - 2, 5
                    mid - 1, 5
                    mid, 7
                    mid + 1, 5
                    mid + 2, 5
                    mid + 3, 13
                    mid - 3, 13
            layer trim:
                line left_strap edge width 0.6:
                    mid - 2, 5
                    mid - 3, 8
                mirror left_strap as right_strap
                line neckline shade width 0.5:
                    mid - 1, 5
                    mid, 7
                    mid + 1, 5
            surface item:
                torso

drawable bra context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (shoulder_anchor_x, shoulder_y) = shoulder_left
    paint fabric = fill
    paint trim = edge
    paint shadow = shade
    let cup_y = shoulder_y + body_unit * 2
    let band_y = shoulder_y + body_unit * 4
    let cup_offset = body_unit * 1.25

    variant compact:
        layer body:
            polygon left_cup fabric:
                body_mid_x - body_unit * 3, band_y
                body_mid_x - cup_offset, cup_y
                body_mid_x, band_y
            mirror left_cup as right_cup
            rect band fabric:
                x body_mid_x - body_unit * 3
                y band_y
                w body_unit * 6
                h body_unit * 0.75
        layer straps:
            line left_strap trim width 0.5:
                body_mid_x - body_unit * 2.5, shoulder_y + body_unit * 1
                body_mid_x - cup_offset, cup_y
            mirror left_strap as right_strap
            when detail has strappy:
                line left_cross trim width 0.4:
                    body_mid_x - body_unit * 2.5, shoulder_y + body_unit * 1
                    body_mid_x - body_unit * 0.5, band_y
                mirror left_cross as right_cross
        surface garment:
            left_cup
            right_cup
            band

    variant detailed:
        layer body:
            polygon left_cup fabric outline trim width 0.3:
                body_mid_x - body_unit * 3.25, band_y
                body_mid_x - cup_offset, cup_y - body_unit * 0.25
                body_mid_x, band_y
            mirror left_cup as right_cup
            rect band fabric:
                x body_mid_x - body_unit * 3.25
                y band_y
                w body_unit * 6.5
                h body_unit * 0.65
                outline shadow
                width 0.25
        layer straps:
            line left_strap trim width 0.3:
                body_mid_x - body_unit * 2.6, shoulder_y
                body_mid_x - cup_offset, cup_y
            mirror left_strap as right_strap
            when detail has strappy:
                line left_cross trim width 0.3:
                    body_mid_x - body_unit * 2.6, shoulder_y
                    body_mid_x - body_unit * 0.5, band_y
                mirror left_cross as right_cross
        surface garment:
            left_cup
            right_cup
            band

    presentation ground:
        variant compact:
            layer body:
                ellipse left_cup fill:
                    x mid - 5
                    y 6
                    w 5
                    h 4
                    outline outline
                    width 0.6
                mirror left_cup as right_cup
            layer trim:
                line band edge width 0.7:
                    mid - 6, 10
                    mid + 6, 10
                line left_strap edge width 0.5:
                    mid - 3, 7
                    mid - 3, 4
                mirror left_strap as right_strap
            surface item:
                left_cup
                right_cup

drawable bralette context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (shoulder_anchor_x, shoulder_y) = shoulder_left
    paint fabric = fill
    paint trim = edge
    let top_y = shoulder_y - body_unit * 1
    let band_y = shoulder_y + body_unit * 1

    variant compact:
        layer body:
            polygon left_panel fabric:
                body_mid_x - body_unit * 2, band_y
                body_mid_x - body_unit * 2, top_y
                body_mid_x- body_unit * 3, band_y
            mirror left_panel as right_panel
            rect band fabric:
                x body_mid_x - body_unit * 3
                y band_y
                w body_unit * 6
                h body_unit * 1
        layer straps:
            line left_strap trim width 0.55:
                body_mid_x - body_unit * 2, top_y
                body_mid_x - body_unit * 2.5, shoulder_y
            mirror left_strap as right_strap
            when detail has cross:
                line left_cross trim width 0.45:
                    body_mid_x - body_unit * 2.5, shoulder_y
                    body_mid_x - body_unit * 0.5, band_y
                mirror left_cross as right_cross
            when detail has strappy:
                line left_extra trim width 0.4:
                    body_mid_x - body_unit * 3, top_y + body_unit * 1
                    body_mid_x - body_unit * 1, band_y
                mirror left_extra as right_extra
        surface garment:
            left_panel
            right_panel
            band

    variant detailed:
        layer body:
            polygon left_panel fabric outline trim width 0.3:
                body_mid_x - body_unit * 3.25, band_y
                body_mid_x - body_unit * 2, top_y
                body_mid_x, band_y
            mirror left_panel as right_panel
            rect band fabric:
                x body_mid_x - body_unit * 3.25
                y band_y
                w body_unit * 6.5
                h body_unit * 0.8
                outline trim
                width 0.25
        layer straps:
            line left_strap trim width 0.3:
                body_mid_x - body_unit * 2, top_y
                body_mid_x - body_unit * 2.6, shoulder_y
            mirror left_strap as right_strap
            when detail has cross:
                line left_cross trim width 0.3:
                    body_mid_x - body_unit * 2.6, shoulder_y
                    body_mid_x - body_unit * 0.5, band_y
                mirror left_cross as right_cross
            when detail has strappy:
                line left_extra trim width 0.3:
                    body_mid_x - body_unit * 3, top_y + body_unit * 1
                    body_mid_x - body_unit * 1, band_y
                mirror left_extra as right_extra
        surface garment:
            left_panel
            right_panel
            band

    presentation ground:
        variant compact:
            layer body:
                polygon left_cup fill outline outline width 0.6:
                    mid - 1, 6
                    mid - 5, 10
                    mid - 1, 10
                mirror left_cup as right_cup
            layer trim:
                line band edge width 0.7:
                    mid - 6, 10
                    mid + 6, 10
                line left_strap edge width 0.5:
                    mid - 3, 7
                    mid - 3, 4
                mirror left_strap as right_strap
            surface item:
                left_cup
                right_cup

drawable bandeau context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (shoulder_anchor_x, shoulder_y) = shoulder_left
    let shoulder_half = upper_torso_width / 2
