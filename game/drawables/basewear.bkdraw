            left_leg
            right_leg

    variant detailed:
        layer body:
            polygon left_leg fabric outline trim width 0.3:
                mid - hip, waist_y
                mid, waist_y
                mid - 0.6, leg_y + 0.25
                mid - hip, leg_y
            mirror left_leg as right_leg
        layer seam:
            line waistband trim width 0.35:
                mid - hip, waist_y
                mid + hip, waist_y
            line center trim width 0.3:
                mid, waist_y
                mid, leg_y
        surface garment:
            left_leg
            right_leg

    presentation ground:
        variant compact:
            layer body:
                polygon left_leg fill outline outline width 0.6:
                    mid - 6, 5
                    mid - 1, 5
                    mid - 1, 11
                    mid - 5, 11
                mirror left_leg as right_leg
            layer trim:
                line waistband edge width 0.6:
                    mid - 6, 5
                    mid + 6, 5
                line fly shade width 0.5:
                    mid, 6
                    mid, 10
            surface item:
                left_leg
                right_leg

