            band

    variant detailed:
        layer body:
            rect band fabric:
                x mid - shoulder + 0.75
                y band_y - 0.25
                w shoulder + shoulder - 1.5
                h 1.75
                outline trim
                width 0.3
        surface garment:
            band

    presentation ground:
        variant compact:
            layer body:
                rect band fill:
                    x mid - 6
                    y 7
                    w 12
                    h 3
                    outline outline
                    width 0.6
            layer trim:
                line center edge width 0.5:
                    mid - 5, 8.5
                    mid + 5, 8.5
            surface item:
                band

drawable boxers context garment:
    paint fabric = fill
    paint trim = edge
    let waist_y = hip_y - 1
    let leg_y = hip_y + 2

