bakerrrr-drawable 1

# Basewear families are catalogue content. Both variants are authored here so
# the renderer never needs to know an individual garment name on its live path.

drawable camisole context garment:
    paint fabric = fill
    paint trim = edge
    paint shadow = shade
    let cami_half = shoulder - 1
    let neckline_y = shoulder_y + 2
    let bottom_y = hip_y - 1

    variant compact:
        layer body:
            polygon bodice fabric:
                mid - cami_half, neckline_y
                mid, neckline_y + 1
                mid + cami_half, neckline_y
                mid + waist, hip_y - 2
                body_right - 1, bottom_y
                body_left + 1, bottom_y
                mid - waist, hip_y - 2
        layer trim:
            line neckline shadow width 0.5:
                mid - cami_half, neckline_y
                mid, neckline_y + 1
                mid + cami_half, neckline_y
            line left_strap trim width 0.5:
                mid - cami_half, neckline_y
                mid - cami_half, shoulder_y
            mirror left_strap as right_strap
            when detail has strappy:
                line cross_left trim width 0.5:
                    mid - cami_half, shoulder_y
                    mid - 1, neckline_y + 1
                mirror cross_left as cross_right
        group straps:
            left_strap
            right_strap
        surface garment:
            bodice

    variant detailed:
        let neck_depth = 1
        let waist_y = neckline_y + 2
        layer body:
            polygon bodice fabric outline trim width 0.35:
                mid - cami_half, neckline_y
                mid, neckline_y + neck_depth
                mid + cami_half, neckline_y
                mid + waist, waist_y
                body_right - 1, bottom_y
                body_left + 1, bottom_y
                mid - waist, waist_y
        layer trim:
            line neckline shadow width 0.35:
                mid - cami_half, neckline_y
                mid, neckline_y + neck_depth
                mid + cami_half, neckline_y
            line left_strap trim width 0.35:
                mid - cami_half, neckline_y
                mid - cami_half, shoulder_y
            mirror left_strap as right_strap
            when detail has strappy:
                line cross_left trim width 0.35:
                    mid - cami_half, shoulder_y
                    mid - 1, neckline_y + neck_depth
                mirror cross_left as cross_right
        group straps:
            left_strap
            right_strap
        surface garment:
            bodice

    presentation ground:
        variant compact:
            layer body:
                polygon folded fill outline outline width 0.6:
                    mid - 3, 6
                    mid + 3, 6
                    mid + 4, 13
                    mid - 4, 13
            layer trim:
                line neckline edge width 0.5:
                    mid - 3, 7
                    mid, 8
                    mid + 3, 7
                line left_strap edge width 0.5:
                    mid - 3, 7
                    mid - 2, 4
                mirror left_strap as right_strap
            surface item:
                folded

drawable boyshorts context garment:
    paint fabric = fill
    paint trim = edge
    let gap = 1
    let waist_y = hip_y - 2

    variant compact:
        let leg_bottom = hip_y + 1
        layer body:
            polygon left_leg fabric:
                mid - basewear_hip, waist_y
                mid - gap, waist_y
                mid - gap, leg_bottom
                mid - basewear_hip + 1, leg_bottom
            mirror left_leg as right_leg
        layer trim:
            line left_waist trim width 0.5:
                mid - basewear_hip, waist_y
                mid - gap, waist_y
            mirror left_waist as right_waist
        group legs:
            left_leg
            right_leg
        surface garment:
            left_leg
            right_leg

    variant detailed:
        let leg_bottom = hip_y + 1.5
        layer body:
            polygon left_leg fabric outline trim width 0.35:
                mid - basewear_hip, waist_y
                mid - gap, waist_y
                mid - gap, leg_bottom
                mid - basewear_hip + 1, leg_bottom
            mirror left_leg as right_leg
        layer trim:
            line left_waist trim width 0.35:
                mid - basewear_hip, waist_y
                mid - gap, waist_y
            mirror left_waist as right_waist
            line center_seam trim width 0.25:
                mid, waist_y
                mid, leg_bottom - 0.5
        group legs:
            left_leg
            right_leg
        surface garment:
            left_leg
            right_leg

    presentation ground:
        variant compact:
            layer body:
                polygon left_leg fill outline outline width 0.6:
                    mid - 5, 5
                    mid - 1, 5
                    mid - 1, 10
                    mid - 4, 10
                mirror left_leg as right_leg
            layer trim:
                line waistband edge width 0.6:
                    mid - 5, 5
                    mid + 5, 5
            surface item:
                left_leg
                right_leg

drawable undershirt context garment:
    paint fabric = fill
    paint trim = edge
    let top_y = shoulder_y + 1
    let bottom_y = hip_y - 1

    variant compact:
        layer body:
            polygon torso fabric:
                mid - shoulder, top_y
                mid - 1, top_y
                mid, top_y + 1
                mid + 1, top_y
                mid + shoulder, top_y
                mid + waist, bottom_y
                mid - waist, bottom_y
            polygon left_sleeve fabric:
                mid - shoulder, top_y
                mid - shoulder - 1, top_y + 1
                mid - shoulder, top_y + 2
                mid - shoulder + 1, top_y + 1
            mirror left_sleeve as right_sleeve
        surface garment:
            torso
            left_sleeve
            right_sleeve

    variant detailed:
        layer body:
            polygon torso fabric outline trim width 0.35:
                mid - shoulder, top_y
                mid - 1, top_y
                mid, top_y + 1
                mid + 1, top_y
                mid + shoulder, top_y
                mid + waist, bottom_y
                mid - waist, bottom_y
            polygon left_sleeve fabric outline trim width 0.3:
                mid - shoulder, top_y
                mid - shoulder - 1, top_y + 1.5
                mid - shoulder, top_y + 2.5
                mid - shoulder + 1, top_y + 1
            mirror left_sleeve as right_sleeve
        surface garment:
            torso
            left_sleeve
            right_sleeve

    presentation ground:
        variant compact:
            layer body:
                polygon torso fill outline outline width 0.6:
                    mid - 3, 4
                    mid - 1, 4
                    mid, 5
                    mid + 1, 4
                    mid + 3, 4
                    mid + 4, 7
                    mid + 3, 8
                    mid + 3, 13
                    mid - 3, 13
                    mid - 3, 8
                    mid - 4, 7
            layer trim:
                line neckline shade width 0.5:
                    mid - 1, 4
                    mid, 5
                    mid + 1, 4
            surface item:
                torso

drawable tank_undershirt context garment:
    paint fabric = fill
    paint trim = edge
    let neck_y = shoulder_y + 2
    let bottom_y = hip_y - 1
    let tank_half = shoulder - 1

    variant compact:
        layer body:
            polygon torso fabric:
                mid - tank_half, neck_y
                mid - 1, neck_y
                mid, neck_y + 1
                mid + 1, neck_y
                mid + tank_half, neck_y
                mid + waist, bottom_y
                mid - waist, bottom_y
        layer straps:
            line left_strap trim width 0.55:
                mid - tank_half, neck_y
                mid - tank_half, shoulder_y
            mirror left_strap as right_strap
        surface garment:
            torso

    variant detailed:
        layer body:
            polygon torso fabric outline trim width 0.35:
                mid - tank_half, neck_y
                mid - 1, neck_y
                mid, neck_y + 1.25
                mid + 1, neck_y
                mid + tank_half, neck_y
                mid + waist, bottom_y
                mid - waist, bottom_y
        layer straps:
            line left_strap trim width 0.35:
                mid - tank_half, neck_y
                mid - tank_half, shoulder_y
            mirror left_strap as right_strap
        surface garment:
            torso

    presentation ground:
        variant compact:
            layer body:
                polygon torso fill outline outline width 0.6:
                    mid - 2, 5
                    mid - 1, 5
                    mid, 7
                    mid + 1, 5
                    mid + 2, 5
                    mid + 3, 13
                    mid - 3, 13
            layer trim:
                line left_strap edge width 0.6:
                    mid - 2, 5
                    mid - 3, 8
                mirror left_strap as right_strap
                line neckline shade width 0.5:
                    mid - 1, 5
                    mid, 7
                    mid + 1, 5
            surface item:
                torso

drawable bra context garment:
    paint fabric = fill
    paint trim = edge
    paint shadow = shade
    let cup_y = shoulder_y + 2
    let band_y = shoulder_y + 4
    let cup_offset = 1.25

    variant compact:
        layer body:
            polygon left_cup fabric:
                mid - 3, band_y
                mid - cup_offset, cup_y
                mid, band_y
            mirror left_cup as right_cup
            rect band fabric:
                x mid - 3
                y band_y
                w 6
                h 0.75
        layer straps:
            line left_strap trim width 0.5:
                mid - 2.5, shoulder_y + 1
                mid - cup_offset, cup_y
            mirror left_strap as right_strap
            when detail has strappy:
                line left_cross trim width 0.4:
                    mid - 2.5, shoulder_y + 1
                    mid - 0.5, band_y
                mirror left_cross as right_cross
        surface garment:
            left_cup
            right_cup
            band

    variant detailed:
        layer body:
            polygon left_cup fabric outline trim width 0.3:
                mid - 3.25, band_y
                mid - cup_offset, cup_y - 0.25
                mid, band_y
            mirror left_cup as right_cup
            rect band fabric:
                x mid - 3.25
                y band_y
                w 6.5
                h 0.65
                outline shadow
                width 0.25
        layer straps:
            line left_strap trim width 0.3:
                mid - 2.6, shoulder_y
                mid - cup_offset, cup_y
            mirror left_strap as right_strap
            when detail has strappy:
                line left_cross trim width 0.3:
                    mid - 2.6, shoulder_y
                    mid - 0.5, band_y
                mirror left_cross as right_cross
        surface garment:
            left_cup
            right_cup
            band

    presentation ground:
        variant compact:
            layer body:
                ellipse left_cup fill:
                    x mid - 5
                    y 6
                    w 5
                    h 4
                    outline outline
                    width 0.6
                mirror left_cup as right_cup
            layer trim:
                line band edge width 0.7:
                    mid - 6, 10
                    mid + 6, 10
                line left_strap edge width 0.5:
                    mid - 3, 7
                    mid - 3, 4
                mirror left_strap as right_strap
            surface item:
                left_cup
                right_cup

drawable bralette context garment:
    paint fabric = fill
    paint trim = edge
    let top_y = shoulder_y -1
    let band_y = shoulder_y +1

    variant compact:
        layer body:
            polygon left_panel fabric:
                mid - 2, band_y
                mid - 2, top_y
                mid-3, band_y
            mirror left_panel as right_panel
            rect band fabric:
                x mid - 3
                y band_y
                w 6
                h 1
        layer straps:
            line left_strap trim width 0.55:
                mid - 2, top_y
                mid - 2.5, shoulder_y
            mirror left_strap as right_strap
            when detail has cross:
                line left_cross trim width 0.45:
                    mid - 2.5, shoulder_y
                    mid - 0.5, band_y
                mirror left_cross as right_cross
            when detail has strappy:
                line left_extra trim width 0.4:
                    mid - 3, top_y + 1
                    mid - 1, band_y
                mirror left_extra as right_extra
        surface garment:
            left_panel
            right_panel
            band

    variant detailed:
        layer body:
            polygon left_panel fabric outline trim width 0.3:
                mid - 3.25, band_y
                mid - 2, top_y
                mid, band_y
            mirror left_panel as right_panel
            rect band fabric:
                x mid - 3.25
                y band_y
                w 6.5
                h 0.8
                outline trim
                width 0.25
        layer straps:
            line left_strap trim width 0.3:
                mid - 2, top_y
                mid - 2.6, shoulder_y
            mirror left_strap as right_strap
            when detail has cross:
                line left_cross trim width 0.3:
                    mid - 2.6, shoulder_y
                    mid - 0.5, band_y
                mirror left_cross as right_cross
            when detail has strappy:
                line left_extra trim width 0.3:
                    mid - 3, top_y + 1
                    mid - 1, band_y
                mirror left_extra as right_extra
        surface garment:
            left_panel
            right_panel
            band

    presentation ground:
        variant compact:
            layer body:
                polygon left_cup fill outline outline width 0.6:
                    mid - 1, 6
                    mid - 5, 10
                    mid - 1, 10
                mirror left_cup as right_cup
            layer trim:
                line band edge width 0.7:
                    mid - 6, 10
                    mid + 6, 10
                line left_strap edge width 0.5:
                    mid - 3, 7
                    mid - 3, 4
                mirror left_strap as right_strap
            surface item:
                left_cup
                right_cup

drawable bandeau context garment:
    paint fabric = fill
    paint trim = edge
    let band_y = shoulder_y + 3

    variant compact:
        layer body:
            rect band fabric:
                x mid - shoulder + 1
                y band_y
                w shoulder + shoulder - 2
                h 1.5
