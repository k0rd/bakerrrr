drawable bikini_panties context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (crotch_x, hip_y) = crotch
    let hip_half = hip_width / 2
    let basewear_half = hip_half - body_unit
    paint fabric = fill
    paint trim = edge
    let waist_y = hip_y - body_unit * 1
    let panel_y = hip_y
    let bottom_y = hip_y + body_unit * 2

    variant compact:
        layer body:
            polygon panel fabric:
                body_mid_x - body_unit * 1.5, panel_y
                body_mid_x + body_unit * 1.5, panel_y
                body_mid_x + body_unit * 0.75, bottom_y
                body_mid_x - body_unit * 0.75, bottom_y
        layer sides:
            line left_side fabric width 0.7:
                body_mid_x - basewear_half, waist_y
                body_mid_x - body_unit * 1.5, panel_y
            mirror left_side as right_side
            when detail has strappy:
                line left_extra trim width 0.35:
                    body_mid_x - basewear_half, waist_y - body_unit * 0.5
                    body_mid_x - body_unit * 1.5, panel_y - body_unit * 0.4
                mirror left_extra as right_extra
        surface garment:
            panel

    variant detailed:
        layer body:
            polygon panel fabric outline trim width 0.25:
                body_mid_x - body_unit * 1.65, panel_y
                body_mid_x + body_unit * 1.65, panel_y
                body_mid_x + body_unit * 0.75, bottom_y + body_unit * 0.25
                body_mid_x - body_unit * 0.75, bottom_y + body_unit * 0.25
        layer sides:
            line left_side fabric width 0.55:
                body_mid_x - basewear_half, waist_y
                body_mid_x - body_unit * 1.65, panel_y
            mirror left_side as right_side
            when detail has strappy:
                line left_extra trim width 0.3:
                    body_mid_x - basewear_half, waist_y - body_unit * 0.5
                    body_mid_x - body_unit * 1.65, panel_y - body_unit * 0.35
                mirror left_extra as right_extra
        surface garment:
            panel

    presentation ground:
        variant compact:
            layer body:
                polygon folded fill outline outline width 0.6:
                    mid - 6, 8
                    mid + 6, 8
                    mid + 2, 13
                    mid - 2, 13
            layer trim:
                line waist edge width 0.5:
                    mid - 6, 8
                    mid + 6, 8
            surface item:
                folded

