drawable boxers context garment:
    let body_unit = body_height / 14
    let (body_mid_x, crown_y) = crown
    let (crotch_x, hip_y) = crotch
    let hip_half = hip_width / 2
    paint fabric = fill
    paint trim = edge
    let waist_y = hip_y - body_unit * 1
    let leg_y = hip_y + body_unit * 2

    variant compact:
        layer body:
            polygon left_leg fabric:
                body_mid_x - hip_half, waist_y
                body_mid_x, waist_y
                body_mid_x - body_unit * 0.5, leg_y
                body_mid_x - hip_half, leg_y
            mirror left_leg as right_leg
        layer seam:
            line center trim width 0.4:
                body_mid_x, waist_y
                body_mid_x, leg_y - body_unit * 0.5
        surface garment:
            left_leg
            right_leg

    variant detailed:
        layer body:
            polygon left_leg fabric outline trim width 0.3:
                body_mid_x - hip_half, waist_y
                body_mid_x, waist_y
                body_mid_x - body_unit * 0.6, leg_y + body_unit * 0.25
                body_mid_x - hip_half, leg_y
            mirror left_leg as right_leg
        layer seam:
            line waistband trim width 0.35:
                body_mid_x - hip_half, waist_y
                body_mid_x + hip_half, waist_y
            line center trim width 0.3:
                body_mid_x, waist_y
                body_mid_x, leg_y
        surface garment:
            left_leg
            right_leg

    presentation ground:
        variant compact:
            layer body:
                polygon left_leg fill outline outline width 0.6:
                    mid - 6, 5
                    mid - 1, 5
                    mid - 1, 11
                    mid - 5, 11
                mirror left_leg as right_leg
            layer trim:
                line waistband edge width 0.6:
                    mid - 6, 5
                    mid + 6, 5
                line fly shade width 0.5:
                    mid, 6
                    mid, 10
            surface item:
                left_leg
                right_leg

