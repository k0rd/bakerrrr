drawable bikini_panties context garment:
    paint fabric = fill
    paint trim = edge
    let waist_y = hip_y - 1
    let panel_y = hip_y
    let bottom_y = hip_y + 2

    variant compact:
        layer body:
            polygon panel fabric:
                mid - 1.5, panel_y
                mid + 1.5, panel_y
                mid + 0.75, bottom_y
                mid - 0.75, bottom_y
        layer sides:
            line left_side fabric width 0.7:
                mid - basewear_hip, waist_y
                mid - 1.5, panel_y
            mirror left_side as right_side
            when detail has strappy:
                line left_extra trim width 0.35:
                    mid - basewear_hip, waist_y - 0.5
                    mid - 1.5, panel_y - 0.4
                mirror left_extra as right_extra
        surface garment:
            panel

    variant detailed:
        layer body:
            polygon panel fabric outline trim width 0.25:
                mid - 1.65, panel_y
                mid + 1.65, panel_y
                mid + 0.75, bottom_y + 0.25
                mid - 0.75, bottom_y + 0.25
        layer sides:
            line left_side fabric width 0.55:
                mid - basewear_hip, waist_y
                mid - 1.65, panel_y
            mirror left_side as right_side
            when detail has strappy:
                line left_extra trim width 0.3:
                    mid - basewear_hip, waist_y - 0.5
                    mid - 1.65, panel_y - 0.35
                mirror left_extra as right_extra
        surface garment:
            panel

    presentation ground:
        variant compact:
            layer body:
                polygon folded fill outline outline width 0.6:
                    mid - 6, 8
                    mid + 6, 8
                    mid + 2, 13
                    mid - 2, 13
            layer trim:
                line waist edge width 0.5:
                    mid - 6, 8
                    mid + 6, 8
            surface item:
                folded

