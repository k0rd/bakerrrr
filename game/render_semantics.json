      "priority": 20
    },
    "items": {
      "layer": "item",
      "priority": 0
    },
    "projectiles": {
      "layer": "fx",
      "priority": 0
    },
    "entities": {
      "layer": "actor",
      "priority": 0
    },
    "ui_markers": {
      "layer": "ui_overlay",
      "priority": 0
    }
  },
